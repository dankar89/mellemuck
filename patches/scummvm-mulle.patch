+namespace {
+// Lets BitmapCastMember's decoder constructor take a picture we already have.
+class SurfaceDecoder : public Image::ImageDecoder {
+public:
+	SurfaceDecoder(Graphics::Surface *s, const byte *pal, int count) : _s(s), _pal(count) {
+		if (count)
+			_pal.set(pal, 0, count);
+	}
+	bool loadStream(Common::SeekableReadStream &stream) override { return false; }
+	void destroy() override {}
+	const Graphics::Surface *getSurface() const override { return _s; }
+	const Graphics::Palette &getPalette() const override { return _pal; }
+private:
+	Graphics::Surface *_s;
+	Graphics::Palette _pal;
+};
+} // End of anonymous namespace
+
+CastMember *restoreBitmapMember(Cast *cast, int id, const Common::Array<byte> &data) {
+	uint pos = 0;
+	auto need = [&](uint n) { return pos + n <= data.size(); };
+	auto u16 = [&]() { int v = (data[pos] << 8) | data[pos + 1]; pos += 2; return v; };
+	if (!need(16))
+		return nullptr;
+	int w = u16(), h = u16();
+	int bpp = data[pos++], depth = data[pos++];
+	const byte *fmt = &data[pos];
+	pos += 8;
+	if (bpp != 1 && bpp != 2 && bpp != 4)
+		return nullptr;
+	Graphics::PixelFormat format = bpp == 1 ? Graphics::PixelFormat::createFormatCLUT8() :
+		Graphics::PixelFormat(bpp, 8 - fmt[0], 8 - fmt[1], 8 - fmt[2], 8 - fmt[3], fmt[4], fmt[5], fmt[6], fmt[7]);
+	int regX = (int16)u16(), regY = (int16)u16();
+	if (!need(2))
+		return nullptr;
+	int palCount = u16();
+	if (palCount > 256 || !need(palCount * 3 + (uint)(w * h * bpp)))
+		return nullptr;
+	const byte *pal = &data[pos];
+	pos += palCount * 3;
+	Graphics::Surface s;
+	s.create(w, h, format);
+	for (int y = 0; y < h; y++) {
+		memcpy(s.getBasePtr(0, y), &data[pos], w * bpp);
+		pos += w * bpp;
+	}
+	SurfaceDecoder decoder(&s, pal, palCount);
+	BitmapCastMember *m = new BitmapCastMember(cast, id, &decoder, 0);
+	s.free();
+	m->_bitsPerPixel = depth;
+	m->_regX = regX;
+	m->_regY = regY;
+	m->_scriptImage = true;
+	m->setModified(false);
+	return m;
+}
