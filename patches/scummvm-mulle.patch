+static void paletteRGB(int index, byte &r, byte &g, byte &b) {
+	const byte *pal = g_director->getPalette();
+	index = CLIP(index, 0, 255);
+	r = pal[index * 3];
+	g = pal[index * 3 + 1];
+	b = pal[index * 3 + 2];
+}
+
+void ColorObject::toRGB(byte &r, byte &g, byte &b) const {
+	if (_indexed) {
+		paletteRGB(_index, r, g, b);
+	} else {
+		r = _r;
+		g = _g;
+		b = _b;
+	}
+}
