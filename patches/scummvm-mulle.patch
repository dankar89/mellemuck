+struct Pixel {
+	bool indexed = false;	// from an 8-bit (or less) image
+	int index = 0;
+	byte r = 255, g = 255, b = 255;
+};
+
+// A colour given to setPixel or fill: a colour object or an integer (a
+// palette index, or the raw value of a 16/32-bit pixel).
+static Pixel colorFrom(const Datum &d, int depth) {
+	Pixel p;
+	if (d.type == OBJECT && ColorObject::is(d.u.obj)) {
+		ColorObject *c = static_cast<ColorObject *>(d.u.obj);
+		p.indexed = c->_indexed;
+		p.index = c->_index;
+		c->toRGB(p.r, p.g, p.b);
+	} else {
+		int v = d.asInt();
+		if (depth <= 8) {
+			p.indexed = true;
+			p.index = CLIP(v, 0, 255);
+			paletteRGB(p.index, p.r, p.g, p.b);
+		} else if (depth == 16) {
+			p.r = ((v >> 10) & 31) << 3;
+			p.g = ((v >> 5) & 31) << 3;
+			p.b = (v & 31) << 3;
+		} else {
+			p.r = (v >> 16) & 255;
+			p.g = (v >> 8) & 255;
+			p.b = v & 255;
+		}
+	}
+	return p;
+}
+
+static Pixel readPixel(const Graphics::Surface *s, const byte *pal, int palCount, int x, int y) {
+	Pixel p;
+	if (s->format.bytesPerPixel == 1) {
+		p.indexed = true;
+		p.index = *(const byte *)s->getBasePtr(x, y);
+		if (pal && p.index < palCount) {
+			p.r = pal[p.index * 3];
+			p.g = pal[p.index * 3 + 1];
+			p.b = pal[p.index * 3 + 2];
+		} else {
+			paletteRGB(p.index, p.r, p.g, p.b);
+		}
+		return p;
+	}
+	uint32 c = s->format.bytesPerPixel == 2 ? *(const uint16 *)s->getBasePtr(x, y) : *(const uint32 *)s->getBasePtr(x, y);
+	byte a;
+	s->format.colorToARGB(c, a, p.r, p.g, p.b);
+	return p;
+}
+
+static int nearestIndex(const byte *pal, int palCount, byte r, byte g, byte b) {
+	int best = 0, bestDist = INT_MAX;
+	for (int i = 0; i < palCount; i++) {
+		int dr = pal[i * 3] - r, dg = pal[i * 3 + 1] - g, db = pal[i * 3 + 2] - b;
+		int dist = dr * dr + dg * dg + db * db;
+		if (dist < bestDist) {
+			best = i;
+			bestDist = dist;
+			if (!dist)
+				break;
+		}
+	}
+	return best;
+}
+
+static void writePixel(Graphics::Surface *s, const byte *pal, int palCount, int x, int y, const Pixel &p) {
+	if (s->format.bytesPerPixel == 1) {
+		int index = p.indexed ? p.index : (pal && palCount ? nearestIndex(pal, palCount, p.r, p.g, p.b) :
+			nearestIndex(g_director->getPalette(), g_director->getPaletteColorCount(), p.r, p.g, p.b));
+		*(byte *)s->getBasePtr(x, y) = index;
+		return;
+	}
+	uint32 c = s->format.ARGBToColor(255, p.r, p.g, p.b);
+	if (s->format.bytesPerPixel == 2)
+		*(uint16 *)s->getBasePtr(x, y) = c;
+	else
+		*(uint32 *)s->getBasePtr(x, y) = c;
+}
+
+static bool isWhite(const Pixel &p) {
+	return p.r == 255 && p.g == 255 && p.b == 255;
+}
