+// Something the engine did for the player, such as an autosave, in the play log.
+void DirectorEngine::logPlayNote(const char *what, const Common::String &detail) {
+	if (!_playLog)
+		return;
+	uint32 now = g_system->getMillis();
+	// Notes are about the game (autosaves): the stage's movie.
+	Movie *movie = _stage ? _stage->getCurrentMovie() : nullptr;
+	Score *score = movie ? movie->getScore() : nullptr;
+	Common::String where = score ? Common::String::format("%s frame %d", movie->getMacName().c_str(), score->getCurrentFrameNum()) : Common::String("-");
+	Common::String line = Common::String::format("PLAY %u.%03u %s %s %s\n", now / 1000, now % 1000, what, where.c_str(), detail.c_str());
+	g_system->logMessage(LogMessageType::kInfo, line.c_str());
+}
