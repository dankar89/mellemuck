+static bool pointArg(const Datum &d, int &x, int &y) {
+	if (d.type != POINT || d.u.farr->arr.size() < 2)
+		return false;
+	x = d.u.farr->arr[0].asInt();
+	y = d.u.farr->arr[1].asInt();
+	return true;
+}
+
+static Common::Rect ordered(const Common::Rect &r) {
+	return Common::Rect(MIN(r.left, r.right), MIN(r.top, r.bottom), MAX(r.left, r.right), MAX(r.top, r.bottom));
+}
+
+static bool rectArg(const Datum &d, Common::Rect &r) {
+	if (d.type != RECT || d.u.farr->arr.size() < 4)
+		return false;
+	r = Common::Rect(d.u.farr->arr[0].asInt(), d.u.farr->arr[1].asInt(), d.u.farr->arr[2].asInt(), d.u.farr->arr[3].asInt());
+	return true;
+}
+
+static Datum propOf(const Datum &list, const char *name) {
+	if (list.type != PARRAY)
+		return Datum();
+	for (auto &it : list.u.parr->arr) {
+		if (it.p.asString().equalsIgnoreCase(name))
+			return it.v;
+	}
+	return Datum();
+}
+
+static Common::Array<Datum> popArgs(int nargs) {
+	Common::Array<Datum> args;
+	args.resize(nargs);
+	for (int i = nargs - 1; i >= 0; i--)
+		args[i] = g_lingo->pop();
+	return args;
+}
+
+// getPixel(x, y [, #integer]) or getPixel(point [, #integer])
+void LM::m_imageGetPixel(int nargs) {
+	Common::Array<Datum> args = popArgs(nargs);
+	ImageObject *img = me();
+	int x = 0, y = 0;
+	uint next = 1;
+	if (!pointArg(args[0], x, y)) {
+		x = args[0].asInt();
+		y = nargs > 1 ? args[1].asInt() : 0;
+		next = 2;
+	}
+	bool asInteger = next < args.size() && args[next].type == SYMBOL && args[next].asString().equalsIgnoreCase("integer");
+	Graphics::Surface *s = img->surface();
+	if (!s || x < 0 || y < 0 || x >= s->w || y >= s->h) {
+		g_lingo->push(Datum(0));
+		return;
+	}
+	Pixel p = readPixel(s, img->palette(), img->paletteCount(), x, y);
+	int depth = img->depth();
+	// 1-bit pictures are kept as 0x00/0xff; Lingo sees 0 (white) and 1
+	// (black): Bygg hus's scoop bites where getPixel = paletteIndex(1).
+	if (depth == 1 && p.indexed)
+		p.index = p.index ? 1 : 0;
+	if (asInteger) {
+		if (p.indexed)
+			g_lingo->push(Datum(p.index));
+		else if (depth == 16)
+			g_lingo->push(Datum(((p.r >> 3) << 10) | ((p.g >> 3) << 5) | (p.b >> 3)));
+		else
+			g_lingo->push(Datum((p.r << 16) | (p.g << 8) | p.b));
+		return;
+	}
+	if (p.indexed)
+		g_lingo->push(Datum(new ColorObject(p.index)));
+	else
+		g_lingo->push(Datum(new ColorObject(p.r, p.g, p.b)));
+}
+
+// setPixel(x, y, color) or setPixel(point, color)
+void LM::m_imageSetPixel(int nargs) {
+	Common::Array<Datum> args = popArgs(nargs);
+	ImageObject *img = me();
+	int x = 0, y = 0;
+	Datum color;
+	if (pointArg(args[0], x, y)) {
+		color = args[1];
+	} else {
+		x = args[0].asInt();
+		y = args[1].asInt();
+		color = nargs > 2 ? args[2] : Datum(0);
+	}
+	Graphics::Surface *s = img->surface();
+	if (!s || x < 0 || y < 0 || x >= s->w || y >= s->h) {
+		g_lingo->push(Datum(0));
+		return;
+	}
+	Pixel p = colorFrom(color, img->depth());
+	if (img->depth() == 1) {
+		// Black (index 1, or a dark colour) is 0xff in a 1-bit picture
+		const bool black = p.indexed ? p.index != 0 : (p.r * 30 + p.g * 59 + p.b * 11) < 12800;
+		p.indexed = true;
+		p.index = black ? 0xff : 0x00;
+	}
+	writePixel(s, img->palette(), img->paletteCount(), x, y, p);
+	img->changed();
+	g_lingo->push(Datum(1));
+}
+
+// fill(rect, color or [#color: c, #shapeType: #rect/#oval, ...]) or
+// fill(left, top, right, bottom, ...)
+void LM::m_imageFill(int nargs) {
+	Common::Array<Datum> args = popArgs(nargs);
+	ImageObject *img = me();
+	Common::Rect r;
+	uint next = 1;
+	if (!rectArg(args[0], r)) {
+		if (nargs < 4) {
+			warning("image.fill(): expected a rect");
+			g_lingo->push(Datum(0));
+			return;
+		}
+		r = Common::Rect(args[0].asInt(), args[1].asInt(), args[2].asInt(), args[3].asInt());
+		next = 4;
+	}
+	Datum spec = next < args.size() ? args[next] : Datum(0);
+	Datum color = spec.type == PARRAY ? propOf(spec, "color") : spec;
+	if (color.type == VOID)
+		color = Datum(new ColorObject(0, 0, 0));
+	bool oval = spec.type == PARRAY && propOf(spec, "shapeType").asString().equalsIgnoreCase("oval");
+	Graphics::Surface *s = img->surface();
+	if (!s) {
+		g_lingo->push(Datum(0));
+		return;
+	}
+	Pixel p = colorFrom(color, img->depth());
+	r = ordered(r);
+	Common::Rect clip = r.findIntersectingRect(Common::Rect(s->w, s->h));
+	double cx = (r.left + r.right) / 2.0, cy = (r.top + r.bottom) / 2.0;
+	double rx = r.width() / 2.0, ry = r.height() / 2.0;
+	for (int y = clip.top; y < clip.bottom; y++) {
+		for (int x = clip.left; x < clip.right; x++) {
+			if (oval && rx > 0 && ry > 0) {
+				double dx = (x + 0.5 - cx) / rx, dy = (y + 0.5 - cy) / ry;
+				if (dx * dx + dy * dy > 1.0)
+					continue;
+			}
+			writePixel(s, img->palette(), img->paletteCount(), x, y, p);
+		}
+	}
+	img->changed();
+	g_lingo->push(Datum(1));
+}
+
+// copyPixels(sourceImage, destRect or quad, sourceRect [, props]): props
+// #ink (0 copy, 36 background transparent, 8 matte), #maskImage (dark is
+// drawn) placed at #maskOffset in the source image, #blendLevel (0-255) or
+// #blend (0-100), #bgColor. Bygg hus cuts floor tiles and wall pieces out of
+// its material pictures with masks.
+void LM::m_imageCopyPixels(int nargs) {
+	Common::Array<Datum> args = popArgs(nargs);
+	ImageObject *img = me();
+	if (args[0].type != OBJECT || !ImageObject::is(args[0].u.obj)) {
+		warning("image.copyPixels(): the source is not an image: %s", args[0].asString(true).c_str());
+		g_lingo->push(Datum(0));
+		return;
+	}
+	ImageObject *src = static_cast<ImageObject *>(args[0].u.obj);
+	Graphics::Surface *d = img->surface(), *s = src->surface();
+	Common::Rect srcRect;
+	if (!d || !s || !rectArg(args[2], srcRect)) {
+		g_lingo->push(Datum(0));
+		return;
+	}
+	Datum props = nargs > 3 ? args[3] : Datum();
+	int ink = propOf(props, "ink").asInt();
+	int blend = 255;
+	if (propOf(props, "blendLevel").type != VOID)
+		blend = CLIP(propOf(props, "blendLevel").asInt(), 0, 255);
+	else if (propOf(props, "blend").type != VOID)
+		blend = CLIP(propOf(props, "blend").asInt() * 255 / 100, 0, 255);
+	Datum maskD = propOf(props, "maskImage");
+	ImageObject *mask = (maskD.type == OBJECT && ImageObject::is(maskD.u.obj)) ? static_cast<ImageObject *>(maskD.u.obj) : nullptr;
+	Graphics::Surface *maskS = mask ? mask->surface() : nullptr;
+	int maskX = 0, maskY = 0;
+	pointArg(propOf(props, "maskOffset"), maskX, maskY);
+	Pixel bg;	// white
+	if (propOf(props, "bgColor").type != VOID)
+		bg = colorFrom(propOf(props, "bgColor"), src->depth());
+	if (ink != 0 && ink != 8 && ink != 36)
+		warning("image.copyPixels(): ink %d copied as ink 0", ink);
+
+	// The destination: a rect, or a quad (four corners) mapped with the
+	// affine transform through its first, second and fourth corners.
+	double ox, oy, ux, uy, vx, vy;	// dest = o + u * fx + v * fy, fx and fy in 0..1
+	Common::Rect bounds;
+	Common::Rect destRect;
+	if (rectArg(args[1], destRect)) {
+		destRect = ordered(destRect);
+		ox = destRect.left;
+		oy = destRect.top;
+		ux = destRect.width();
+		uy = 0;
+		vx = 0;
+		vy = destRect.height();
+		bounds = destRect;
+	} else if (args[1].type == ARRAY && args[1].u.farr->arr.size() >= 4) {
+		int px[4], py[4];
+		for (int i = 0; i < 4; i++) {
+			if (!pointArg(args[1].u.farr->arr[i], px[i], py[i])) {
+				g_lingo->push(Datum(0));
+				return;
+			}
+		}
+		ox = px[0];
+		oy = py[0];
+		ux = px[1] - px[0];
+		uy = py[1] - py[0];
+		vx = px[3] - px[0];
+		vy = py[3] - py[0];
+		int minX = MIN(MIN(px[0], px[1]), MIN(px[2], px[3])), maxX = MAX(MAX(px[0], px[1]), MAX(px[2], px[3]));
+		int minY = MIN(MIN(py[0], py[1]), MIN(py[2], py[3])), maxY = MAX(MAX(py[0], py[1]), MAX(py[2], py[3]));
+		bounds = Common::Rect(minX, minY, maxX, maxY);
+	} else {
+		warning("image.copyPixels(): expected a rect or a quad, got %s", args[1].asString(true).c_str());
+		g_lingo->push(Datum(0));
+		return;
+	}
+	double det = ux * vy - uy * vx;
+	if (det == 0) {
+		g_lingo->push(Datum(1));
+		return;
+	}
+	Common::Rect clip = bounds.findIntersectingRect(Common::Rect(d->w, d->h));
+	const byte *dPal = img->palette(), *sPal = src->palette();
+	int dPalCount = img->paletteCount(), sPalCount = src->paletteCount();
+	int sw = srcRect.width(), sh = srcRect.height();
+	for (int y = clip.top; y < clip.bottom; y++) {
+		for (int x = clip.left; x < clip.right; x++) {
+			double px = x + 0.5 - ox, py = y + 0.5 - oy;
+			double fx = (px * vy - py * vx) / det, fy = (ux * py - uy * px) / det;
+			if (fx < 0 || fx >= 1 || fy < 0 || fy >= 1)
+				continue;
+			int sx = srcRect.left + (int)(fx * sw), sy = srcRect.top + (int)(fy * sh);
+			if (sx < 0 || sy < 0 || sx >= s->w || sy >= s->h)
+				continue;
+			if (maskS) {
+				int mx = sx - maskX, my = sy - maskY;
+				if (mx < 0 || my < 0 || mx >= maskS->w || my >= maskS->h)
+					continue;
+				Pixel m = readPixel(maskS, mask->palette(), mask->paletteCount(), mx, my);
+				if (m.r + m.g + m.b >= 3 * 128)
+					continue;
+			}
+			Pixel p = readPixel(s, sPal, sPalCount, sx, sy);
+			if ((ink == 36 || ink == 8) && p.r == bg.r && p.g == bg.g && p.b == bg.b)
+				continue;
+			if (blend < 255) {
+				Pixel under = readPixel(d, dPal, dPalCount, x, y);
+				p.indexed = false;
+				p.r = (p.r * blend + under.r * (255 - blend)) / 255;
+				p.g = (p.g * blend + under.g * (255 - blend)) / 255;
+				p.b = (p.b * blend + under.b * (255 - blend)) / 255;
+			}
+			if (p.indexed && d->format.bytesPerPixel == 1 && sPal != dPal && sPalCount && dPalCount)
+				p.indexed = false;	// another palette: match the colour
+			writePixel(d, dPal, dPalCount, x, y, p);
+		}
+	}
+	img->changed();
+	g_lingo->push(Datum(1));
+}
+
+void LM::m_imageDuplicate(int nargs) {
+	g_lingo->push(Datum(new ImageObject(*me())));
+}
+
+void LM::m_imageCrop(int nargs) {
+	Datum rd = g_lingo->pop();
+	ImageObject *img = me();
+	Graphics::Surface *s = img->surface();
+	Common::Rect r;
+	if (!s || !rectArg(rd, r)) {
+		g_lingo->push(Datum());
+		return;
+	}
+	r = r.findIntersectingRect(Common::Rect(s->w, s->h));
+	Graphics::Surface sub = s->getSubArea(r);
+	g_lingo->push(Datum(new ImageObject(sub, img->depth(), img->palette(), img->paletteCount())));
+}
+
+// The image without its white border.
+void LM::m_imageTrimWhiteSpace(int nargs) {
+	ImageObject *img = me();
+	Graphics::Surface *s = img->surface();
+	if (!s) {
+		g_lingo->push(Datum());
+		return;
+	}
+	Common::Rect r(s->w, 0, 0, s->h);
+	int top = s->h, bottom = 0;
+	for (int y = 0; y < s->h; y++) {
+		for (int x = 0; x < s->w; x++) {
+			if (!isWhite(readPixel(s, img->palette(), img->paletteCount(), x, y))) {
+				r.left = MIN<int16>(r.left, x);
+				r.right = MAX<int16>(r.right, x + 1);
+				top = MIN(top, y);
+				bottom = MAX(bottom, y + 1);
+			}
+		}
+	}
+	if (r.left >= r.right) {
+		g_lingo->push(Datum(new ImageObject(1, 1, img->depth())));
+		return;
+	}
+	r.top = top;
+	r.bottom = bottom;
+	Graphics::Surface sub = s->getSubArea(r);
+	g_lingo->push(Datum(new ImageObject(sub, img->depth(), img->palette(), img->paletteCount())));
+}
+
+// createMask(): a mask for copyPixels' #maskImage; dark pixels are drawn.
+void LM::m_imageCreateMask(int nargs) {
+	g_lingo->push(Datum(new ImageObject(*me())));
+}
+
+// createMatte([alphaThreshold]): the image's shape, black where it is not white.
+void LM::m_imageCreateMatte(int nargs) {
+	if (nargs)
+		g_lingo->pop();
+	ImageObject *img = me();
+	Graphics::Surface *s = img->surface();
+	if (!s) {
+		g_lingo->push(Datum());
+		return;
+	}
+	ImageObject *matte = new ImageObject(s->w, s->h, 32);
+	Pixel black;
+	black.r = black.g = black.b = 0;
+	for (int y = 0; y < s->h; y++) {
+		for (int x = 0; x < s->w; x++) {
+			if (!isWhite(readPixel(s, img->palette(), img->paletteCount(), x, y)))
+				writePixel(&matte->_own, nullptr, 0, x, y, black);
+		}
+	}
+	g_lingo->push(Datum(matte));
+}
+
+/*
+ * Builtins
+ */
+
+// image(width, height, depth [, paletteRef])
+void LB::b_image(int nargs) {
+	Common::Array<Datum> args = popArgs(nargs);
+	int w = args[0].asInt(), h = nargs > 1 ? args[1].asInt() : 1, depth = nargs > 2 ? args[2].asInt() : 32;
+	g_lingo->push(Datum(new ImageObject(w, h, depth)));
+}
+
+// rgb(r, g, b) or rgb("#RRGGBB")
+void LB::b_rgb(int nargs) {
+	Common::Array<Datum> args = popArgs(nargs);
+	if (nargs == 1 && args[0].type == STRING) {
+		Common::String s = args[0].asString();
+		if (s.hasPrefix("#"))
+			s = s.substr(1);
+		uint32 v = (uint32)strtoul(s.c_str(), nullptr, 16);
+		g_lingo->push(Datum(new ColorObject((v >> 16) & 255, (v >> 8) & 255, v & 255)));
+		return;
+	}
+	int r = args[0].asInt(), g = nargs > 1 ? args[1].asInt() : 0, b = nargs > 2 ? args[2].asInt() : 0;
+	g_lingo->push(Datum(new ColorObject(CLIP(r, 0, 255), CLIP(g, 0, 255), CLIP(b, 0, 255))));
+}
+
+void LB::b_paletteIndex(int nargs) {
+	int index = g_lingo->pop().asInt();
+	g_lingo->push(Datum(new ColorObject(CLIP(index, 0, 255))));
+}
+
+void LB::b_bitAnd(int nargs) {
+	int b = g_lingo->pop().asInt(), a = g_lingo->pop().asInt();
+	g_lingo->push(Datum(a & b));
+}
+
+void LB::b_bitOr(int nargs) {
+	int b = g_lingo->pop().asInt(), a = g_lingo->pop().asInt();
+	g_lingo->push(Datum(a | b));
+}
+
+void LB::b_bitXor(int nargs) {
+	int b = g_lingo->pop().asInt(), a = g_lingo->pop().asInt();
+	g_lingo->push(Datum(a ^ b));
+}
+
+void LB::b_bitNot(int nargs) {
+	g_lingo->push(Datum(~g_lingo->pop().asInt()));
+}
+
+} // End of namespace Director
