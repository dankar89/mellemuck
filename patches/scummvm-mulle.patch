+void SurfaceSdlGraphicsManager::buildSystemCursor() {
+#if SDL_VERSION_ATLEAST(2, 0, 0) && !SDL_VERSION_ATLEAST(3, 0, 0)
+	const int drawWidth = _activeArea.drawRect.width();
+	if (!systemCursorWanted() || !_mouseSurface || drawWidth <= 0 || _videoMode.hardwareWidth <= 0) {
+		clearSystemCursor();
+		return;
+	}
+	// _mouseSurface is in screen pixels; the renderer stretches the screen to
+	// the window, so the pointer is stretched the same way. The conversion turns
+	// the color key into alpha.
+	const float scale = (float)drawWidth / _videoMode.hardwareWidth;
+	SDL_Surface *image = SDL_ConvertSurfaceFormat(_mouseSurface, SDL_PIXELFORMAT_ARGB8888, 0);
+	if (!image) {
+		clearSystemCursor();
+		return;
+	}
+	const int w = MAX(1, (int)(_mouseSurface->w * scale + 0.5f));
+	const int h = MAX(1, (int)(_mouseSurface->h * scale + 0.5f));
+	if (w != image->w || h != image->h) {
+		SDL_Surface *scaled = SDL_CreateRGBSurfaceWithFormat(0, w, h, 32, SDL_PIXELFORMAT_ARGB8888);
+		if (scaled) {
+			SDL_SetSurfaceBlendMode(image, SDL_BLENDMODE_NONE);
+			SDL_BlitScaled(image, nullptr, scaled, nullptr);
+		}
+		SDL_FreeSurface(image);
+		image = scaled;
+		if (!image) {
+			clearSystemCursor();
+			return;
+		}
+	}
+	setSystemCursor(image, (int)(_mouseCurState.rHotX * scale), (int)(_mouseCurState.rHotY * scale));
+	SDL_FreeSurface(image);
