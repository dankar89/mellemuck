+
+void RoadDriver::watchCar(AbstractObject *car) {
+	if (!car->hasProp("frameCount")) {
+		// A boat (Bygger båtar's BoatBase): its fine heading, internalDirection
+		// in hundredths, which steering changes a little each frame (the game
+		// does not wrap it; direction is correctDirection(it / 100)).
+		float h = fmodf(propInt(car, "internalDirection") / 100.0f, 16.0f);
+		if (h <= 0.0f)
+			h += 16.0f;
+		_carHeading = h;
+		return;
+	}
+	// Once a game frame (CarDriving counts them).
+	const int frame = propInt(car, "frameCount", -1);
+	if (frame == _carFrame || !car->hasProp("coordinate"))
+		return;
+	_carFrame = frame;
+	Datum coord = car->getProp("coordinate");
+	if (coord.type != POINT || coord.u.farr->arr.size() < 2)
+		return;
+	const RoadGraph::Pt p(coord.u.farr->arr[0].asInt() / 100.0f, coord.u.farr->arr[1].asInt() / 100.0f);
+	// A jump (another map, a ferry): the way here says nothing.
+	if (!_carTrail.empty() && fabsf(p.x - _carTrail.back().x) + fabsf(p.y - _carTrail.back().y) > 40.0f)
+		_carTrail.clear();
+	_carTrail.push_back(p);
+	if (_carTrail.size() > 5)
+		_carTrail.remove_at(0);
+
+	// Where it points: internalDirection is the heading in hundredths, the
+	// picture's heading its whole part.
+	int internal = propInt(car, "internalDirection");
+	float target = internal > 0 ? internal / 100.0f : (float)propInt(car, "direction", 16);
+	const int speed = propInt(car, "speed");
+	if (_carTrail.size() >= 4 && speed != 0) {
+		const RoadGraph::Pt &q = _carTrail[_carTrail.size() - 4];
+		const float dx = p.x - q.x, dy = p.y - q.y;
+		if (dx * dx + dy * dy > 9.0f) {
+			target = headingOf(dx, dy);
+			if (speed < 0)
+				target += 8.0f;
+		}
+	}
+	auto wrap = [](float d) {
+		while (d > 8.0f)
+			d -= 16.0f;
+		while (d <= -8.0f)
+			d += 16.0f;
+		return d;
+	};
+	if (_carHeading < 0.0f)
+		_carHeading = target;
+	else
+		_carHeading += CLIP(wrap(target - _carHeading), -1.2f, 1.2f);
+	while (_carHeading <= 0.0f)
+		_carHeading += 16.0f;
+	while (_carHeading > 16.0f)
+		_carHeading -= 16.0f;
+}
