+// Play log: every click, release and key, and the mouse position at most four
+// times a second, with the movie, frame and (for clicks) the sprite and member
+// under the mouse, as "PLAY <seconds> <what> ..." lines in the ScummVM log. A
+// player's log then shows what they did before a problem, and
+// tools/replay_playlog.py plays it back in the test harness.
+void DirectorEngine::logPlayEvent(const Common::Event &event, const char *note) {
+	if (!_playLog)
+		return;
+
+	uint32 now = g_system->getMillis();
+	const char *what = nullptr;
+	bool click = false;
+	switch (event.type) {
+	case Common::EVENT_LBUTTONDOWN:	what = "down"; click = true; break;
+	case Common::EVENT_LBUTTONUP:	what = "up"; click = true; break;
+	case Common::EVENT_RBUTTONDOWN:	what = "rdown"; click = true; break;
+	case Common::EVENT_RBUTTONUP:	what = "rup"; click = true; break;
+	case Common::EVENT_KEYDOWN:		what = "keydown"; break;
+	case Common::EVENT_KEYUP:		what = "keyup"; break;
+	case Common::EVENT_JOYBUTTON_DOWN:	what = "pad"; break;
+	case Common::EVENT_JOYBUTTON_UP:	what = "pad"; break;
+	case Common::EVENT_FOCUS_LOST:		what = "unfocused"; break;
+	case Common::EVENT_FOCUS_GAINED:	what = "focused"; break;
+	case Common::EVENT_MOUSEMOVE:
+		if (now - _playLogLastMove < 250)
+			return;
+		_playLogLastMove = now;
+		what = "move";
+		break;
+	default:
+		return;
+	}
+
+	// The window the event is for: under the pointer, a movie in a window
+	// over the stage (Bygger bilar's file dialog) or the stage; keys go to the
+	// topmost open window. Not the current window, which is just the last
+	// one stepped.
+	Window *window = _stage;
+	for (auto w : _windowList) {
+		if (!w->getMacWindow()->isVisible() || !w->getCurrentMovie())
+			continue;
+		if (!Common::isMouseEvent(event) || w->getMacWindow()->getInnerDimensions().contains(event.mouse))
+			window = w;
+	}
+	Movie *movie = window ? window->getCurrentMovie() : nullptr;
+	Score *score = movie ? movie->getScore() : nullptr;
+	Common::String where = score ? Common::String::format("%s frame %d", movie->getMacName().c_str(), score->getCurrentFrameNum()) : Common::String("-");
+	Common::String detail;
+	if (event.type == Common::EVENT_JOYBUTTON_DOWN || event.type == Common::EVENT_JOYBUTTON_UP) {
+		static const char *const buttons[] = { "?", "A", "B", "X", "Y", "Back", "Guide", "Start", "LeftStick",
+			"RightStick", "LB", "RB", "DpadUp", "DpadDown", "DpadLeft", "DpadRight", "DpadCenter" };
+		const uint8 button = event.joystick.button;
+		detail = Common::String::format("%s %s", button < ARRAYSIZE(buttons) ? buttons[button] : "?",
+			event.type == Common::EVENT_JOYBUTTON_DOWN ? "down" : "up");
+	} else if (event.type == Common::EVENT_FOCUS_LOST || event.type == Common::EVENT_FOCUS_GAINED) {
+		// The window, nothing more to say.
+	} else if (event.type == Common::EVENT_KEYDOWN || event.type == Common::EVENT_KEYUP) {
+		detail = Common::String::format("key %d", (int)event.kbd.keycode);
+		if (event.kbd.ascii >= 32 && event.kbd.ascii < 127)
+			detail += Common::String::format(" '%c'", (char)event.kbd.ascii);
+	} else {
+		Common::Point pos = event.mouse;
+		if (window) {
+			const Common::Rect inner = window->getMacWindow()->getInnerDimensions();
+			pos -= Common::Point(inner.left, inner.top);
+		}
+		detail = Common::String::format("at %d,%d", pos.x, pos.y);
+		if (click && score) {
+			uint16 spriteId = score->getMouseSpriteIDFromPos(pos);
+			Channel *channel = spriteId ? score->getChannelById(spriteId) : nullptr;
+			if (channel && channel->_sprite) {
+				CastMember *member = channel->_sprite->_cast;
+				CastMemberInfo *info = member ? member->getInfo() : nullptr;
+				detail += Common::String::format(" sprite %d member %s", spriteId, channel->_sprite->_castId.asString().c_str());
+				if (info && !info->name.empty())
+					detail += Common::String::format(" \"%s\"", info->name.c_str());
+			}
+		}
+	}
+	if (note)
+		detail += Common::String(" ") + note;
+	Common::String line = Common::String::format("PLAY %u.%03u %s %s %s\n", now / 1000, now % 1000, what, where.c_str(), detail.c_str());
+	g_system->logMessage(LogMessageType::kInfo, line.c_str());
+}
