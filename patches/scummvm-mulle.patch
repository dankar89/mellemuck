+
+#include "common/config-manager.h"
+#include "common/system.h"
+#include "graphics/managed_surface.h"
+
+#include "director/director.h"
+#include "director/roads.h"
+#include "director/util.h"
+#include "director/lingo/lingo.h"
+#include "director/lingo/lingo-object.h"
+
+namespace Director {
+
+// The graph (tools/roads.py does the same, step for step, to draw it).
+
+namespace {
+
+const int kBlocked = 240;
+const int kPad = 12;			// cells repeated past the map's edge before thinning
+const float kSpur = 14.0f;		// dead ends shorter than this are the road's ragged edge
+const float kLoop = 30.0f;		// loops shorter than this go round a speck in the road
+const float kJoin = 7.0f;		// edges shorter than this join their two nodes
+const int kExitMargin = 6;		// ends this close to the map's edge lead on
+const int kSmooth = 4;			// cells either side averaged into a path's point
+
+// Neighbours clockwise from north.
+const int kDY[8] = { -1, -1, 0, 1, 1, 1, 0, -1 };
+const int kDX[8] = { 0, 1, 1, 1, 0, -1, -1, -1 };
+
+struct Grid {
+	int w = 0, h = 0;
+	Common::Array<byte> v;
+	Grid(int w_, int h_) : w(w_), h(h_) { v.resize(w * h); for (auto &b : v) b = 0; }
+	bool in(int x, int y) const { return x >= 0 && y >= 0 && x < w && y < h; }
+	byte at(int x, int y) const { return in(x, y) ? v[y * w + x] : 0; }
+};
+
+void ring(const Grid &g, int x, int y, bool r[8]) {
+	for (int k = 0; k < 8; k++)
+		r[k] = g.at(x + kDX[k], y + kDY[k]) != 0;
+}
+
+// Runs of set neighbours round a cell.
+int arcs(const bool r[8]) {
+	bool all = true;
+	for (int k = 0; k < 8; k++)
+		all &= r[k];
+	if (all)
+		return 1;
+	int n = 0;
+	for (int k = 0; k < 8; k++)
+		if (r[k] && !r[(k + 7) % 8])
+			n++;
+	return n;
+}
+
+// Thins to one-cell lines (Zhang & Suen 1984).
+void zhangSuen(Grid &g) {
+	Common::Array<int> kill;
+	bool changed = true;
+	while (changed) {
+		changed = false;
+		for (int step = 0; step < 2; step++) {
+			kill.clear();
+			for (int y = 0; y < g.h; y++) {
+				for (int x = 0; x < g.w; x++) {
+					if (!g.v[y * g.w + x])
+						continue;
+					int n[8];
+					int b = 0, a = 0;
+					for (int k = 0; k < 8; k++) {
+						n[k] = g.at(x + kDX[k], y + kDY[k]) ? 1 : 0;
+						b += n[k];
+					}
+					for (int k = 0; k < 8; k++)
+						if (n[k] == 0 && n[(k + 1) % 8] == 1)
+							a++;
+					const int p2 = n[0], p4 = n[2], p6 = n[4], p8 = n[6];
+					const bool c = step == 0 ? (p2 * p4 * p6 == 0 && p4 * p6 * p8 == 0) : (p2 * p4 * p8 == 0 && p2 * p6 * p8 == 0);
+					if (b >= 2 && b <= 6 && a == 1 && c)
+						kill.push_back(y * g.w + x);
+				}
+			}
+			for (int i : kill)
+				g.v[i] = 0;
+			if (!kill.empty())
+				changed = true;
+		}
+	}
+}
+
+// Drops cells the lines do not need: one whose neighbours form a single run
+// of three or more (a staircase's corner, a 2 x 2 block).
+void tidy(Grid &g) {
+	bool again = true;
+	Common::Array<int> cells;
+	while (again) {
+		again = false;
+		cells.clear();
+		for (int i = 0; i < (int)g.v.size(); i++)
+			if (g.v[i])
+				cells.push_back(i);
+		for (int i : cells) {
+			const int x = i % g.w, y = i / g.w;
+			bool r[8];
+			ring(g, x, y, r);
+			int b = 0;
+			for (int k = 0; k < 8; k++)
+				b += r[k];
+			if (b >= 3 && arcs(r) == 1) {
+				g.v[i] = 0;
+				again = true;
+			}
+		}
+	}
+}
+
+struct CellEdge {
+	int a, b;
+	Common::Array<Common::Point> path;	// cells
+};
+
+struct CellGraph {
+	Common::Array<RoadGraph::Pt> nodes;	// cells
+	Common::Array<CellEdge> edges;
+
+	int degree(int n) const {
+		int d = 0;
+		for (auto &e : edges)
+			d += (e.a == n) + (e.b == n);
+		return d;
+	}
+};
+
+float pathLength(const Common::Array<Common::Point> &p) {
+	float len = 0.0f;
+	for (uint i = 1; i < p.size(); i++)
+		len += sqrtf((float)((p[i].x - p[i - 1].x) * (p[i].x - p[i - 1].x) + (p[i].y - p[i - 1].y) * (p[i].y - p[i - 1].y)));
+	return len;
+}
+
+bool atEdge(const RoadGraph::Pt &p) {
+	return p.x < kExitMargin || p.y < kExitMargin || p.x >= RoadGraph::kW - kExitMargin || p.y >= RoadGraph::kH - kExitMargin;
+}
+
+Common::Point roundCell(const RoadGraph::Pt &p) {
+	return Common::Point((int16)floorf(p.x + 0.5f), (int16)floorf(p.y + 0.5f));
+}
+
+// The skeleton as a graph: nodes at cells with one run of neighbours (ends)
+// or three or more (junctions; junction cells side by side are one node).
+// Each node owns its cells and the line cells round them; what is left falls
+// apart into pieces of line, each an edge between the nodes it touches.
+void trace(const Grid &sk, CellGraph &g) {
+	const int w = sk.w, h = sk.h;
+	Common::Array<int> kind(w * h);
+	Common::Array<int> nodeOf(w * h);
+	for (int i = 0; i < w * h; i++) {
+		kind[i] = -1;
+		nodeOf[i] = -1;
+	}
+	Common::Array<int> kindCells;
+	for (int y = 0; y < h; y++) {
+		for (int x = 0; x < w; x++) {
+			if (!sk.at(x, y))
+				continue;
+			bool r[8];
+			ring(sk, x, y, r);
+			const int a = arcs(r);
+			if (a != 2) {
+				kind[y * w + x] = a;
+				kindCells.push_back(y * w + x);
+			}
+		}
+	}
+	Common::Array<int> nodeOrder;	// cells in the order they were given a node
+	for (int cell : kindCells) {
+		if (nodeOf[cell] >= 0)
+			continue;
+		const int n = g.nodes.size();
+		Common::Array<int> group, todo;
+		group.push_back(cell);
+		todo.push_back(cell);
+		nodeOf[cell] = n;
+		nodeOrder.push_back(cell);
+		while (!todo.empty()) {
+			const int c0 = todo.back();
+			todo.pop_back();
+			for (int k = 0; k < 8; k++) {
+				const int x = c0 % w + kDX[k], y = c0 / w + kDY[k];
+				if (!sk.in(x, y))
+					continue;
+				const int c = y * w + x;
+				if (sk.v[c] && kind[c] >= 0 && nodeOf[c] < 0 && kind[c] >= 3 && kind[cell] >= 3) {
+					nodeOf[c] = n;
+					nodeOrder.push_back(c);
+					group.push_back(c);
+					todo.push_back(c);
+				}
+			}
+		}
+		float sx = 0.0f, sy = 0.0f;
+		for (int c : group) {
+			sx += c % w;
+			sy += c / w;
+		}
+		g.nodes.push_back(RoadGraph::Pt(sx / group.size(), sy / group.size()));
+	}
+
+	// The cells each node owns: its own, then the line cells round them.
+	Common::Array<int> owner(nodeOf);
+	Common::Array<int> ownerOrder(nodeOrder);
+	for (int c0 : nodeOrder) {
+		for (int k = 0; k < 8; k++) {
+			const int x = c0 % w + kDX[k], y = c0 / w + kDY[k];
+			if (!sk.in(x, y) || !sk.v[y * w + x])
+				continue;
+			const int c = y * w + x;
+			if (owner[c] < 0) {
+				owner[c] = nodeOf[c0];
+				ownerOrder.push_back(c);
+			}
+		}
+	}
+	auto centre = [&](int n) { return roundCell(g.nodes[n]); };
+	auto cellPoint = [&](int c) { return Common::Point(c % w, c / w); };
+
+	// Nodes whose cells touch are joined straight away (a junction traced as
+	// a few nodes; prune() makes them one).
+	Common::HashMap<uint32, int> direct;	// a << 16 | b -> the smallest cell where they touch
+	for (int c0 : ownerOrder) {
+		const int n = owner[c0];
+		for (int k = 0; k < 8; k++) {
+			const int x = c0 % w + kDX[k], y = c0 / w + kDY[k];
+			if (!sk.in(x, y))
+				continue;
+			const int c = y * w + x;
+			const int m = owner[c];
+			if (m < 0 || m == n)
+				continue;
+			const uint32 key = (uint32)MIN(n, m) << 16 | (uint32)MAX(n, m);
+			const int cell = MIN(c0, c);
+			if (!direct.contains(key) || cell < direct[key])
+				direct[key] = cell;
+		}
+	}
+	Common::Array<uint32> keys;
+	for (auto &it : direct)
+		keys.push_back(it._key);
+	Common::sort(keys.begin(), keys.end());
+	for (uint32 key : keys) {
+		CellEdge e;
+		e.a = key >> 16;
+		e.b = key & 0xffff;
+		e.path.push_back(centre(e.a));
+		e.path.push_back(cellPoint(direct[key]));
+		e.path.push_back(centre(e.b));
+		g.edges.push_back(e);
+	}
+
+	// The pieces of line.
+	Common::Array<int> pieceOf(w * h);
+	for (auto &p : pieceOf)
+		p = -1;
+	int pieces = 0;
+	for (int start = 0; start < w * h; start++) {
+		if (!sk.v[start] || owner[start] >= 0 || pieceOf[start] >= 0)
+			continue;
+		const int id = pieces++;
+		Common::Array<int> todo;
+		Common::HashMap<int, Common::Array<int> > touch;	// node -> the piece's cells next to it
+		pieceOf[start] = id;
+		todo.push_back(start);
+		while (!todo.empty()) {
+			const int c0 = todo.back();
+			todo.pop_back();
+			for (int k = 0; k < 8; k++) {
+				const int x = c0 % w + kDX[k], y = c0 / w + kDY[k];
+				if (!sk.in(x, y) || !sk.v[y * w + x])
+					continue;
+				const int c = y * w + x;
+				if (owner[c] >= 0) {
+					Common::Array<int> &t = touch[owner[c]];
+					bool have = false;
+					for (int q : t)
+						have |= q == c0;
+					if (!have)
+						t.push_back(c0);
+				} else if (pieceOf[c] < 0) {
+					pieceOf[c] = id;
+					todo.push_back(c);
+				}
+			}
+		}
+		Common::Array<int> nodes;
+		for (auto &it : touch)
+			nodes.push_back(it._key);
+		Common::sort(nodes.begin(), nodes.end());
+		if (nodes.empty())
+			continue;	// a ring with no junction (none in Bygger bilar)
+
+		// The shortest way through the piece from cells next to one node to
+		// cells next to another.
+		auto shortest = [&](Common::Array<int> from, const Common::Array<int> &to, Common::Array<Common::Point> &path) {
+			Common::sort(from.begin(), from.end());
+			Common::HashMap<int, int> prev;
+			Common::Array<int> queue;
+			for (int c : from) {
+				prev[c] = -1;
+				queue.push_back(c);
+			}
+			for (uint qi = 0; qi < queue.size(); qi++) {
+				const int c = queue[qi];
+				bool goal = false;
+				for (int t : to)
+					goal |= t == c;
+				if (goal) {
+					Common::Array<int> cells;
+					for (int p = c; p >= 0; p = prev[p])
+						cells.push_back(p);
+					for (int i = cells.size() - 1; i >= 0; i--)
+						path.push_back(cellPoint(cells[i]));
+					return true;
+				}
+				for (int k = 0; k < 8; k++) {
+					const int x = c % w + kDX[k], y = c / w + kDY[k];
+					if (!sk.in(x, y))
+						continue;
+					const int n = y * w + x;
+					if (pieceOf[n] == id && !prev.contains(n)) {
+						prev[n] = c;
+						queue.push_back(n);
+					}
+				}
+			}
+			return false;
+		};
+
+		if (nodes.size() == 1) {
+			const int n = nodes[0];
+			Common::Array<int> ends = touch[n];
+			Common::sort(ends.begin(), ends.end());
+			if (ends.size() >= 2) {
+				Common::Array<int> first, rest;
+				first.push_back(ends[0]);
+				for (uint i = 1; i < ends.size(); i++)
+					rest.push_back(ends[i]);
+				CellEdge e;
+				e.a = e.b = n;
+				e.path.push_back(centre(n));
+				if (shortest(first, rest, e.path)) {
+					e.path.push_back(centre(n));
+					g.edges.push_back(e);
+				}
+			}
+			continue;
+		}
+		for (uint i = 0; i < nodes.size(); i++) {
+			for (uint k = i + 1; k < nodes.size(); k++) {
+				CellEdge e;
+				e.a = nodes[i];
+				e.b = nodes[k];
+				e.path.push_back(centre(e.a));
+				if (shortest(touch[e.a], touch[e.b], e.path)) {
+					e.path.push_back(centre(e.b));
+					g.edges.push_back(e);
+				}
+			}
+		}
+	}
+}
+
+// Drops small loops, joins nodes a few cells apart, drops short dead ends
+// (not those at the map's edge) and joins the edges of nodes left with two.
+void prune(CellGraph &g) {
+	while (true) {
+		bool changed = false;
+		for (uint i = 0; i < g.edges.size() && !changed; i++) {
+			CellEdge &e = g.edges[i];
+			const float length = pathLength(e.path);
+			if (e.a == e.b && length < kLoop) {
+				g.edges.remove_at(i);
+				changed = true;
+			} else if (e.a != e.b && length < kJoin) {
+				const int keep = e.a, gone = e.b;
+				g.edges.remove_at(i);
+				const RoadGraph::Pt ka = g.nodes[keep], kb = g.nodes[gone];
+				g.nodes[keep] = RoadGraph::Pt((ka.x + kb.x) / 2, (ka.y + kb.y) / 2);
+				const Common::Point at = roundCell(g.nodes[keep]);
+				for (auto &f : g.edges) {
+					if (f.a == gone) {
+						f.a = keep;
+						f.path.insert_at(0, at);
+					}
+					if (f.b == gone) {
+						f.b = keep;
+						f.path.push_back(at);
+					}
+				}
+				changed = true;
+			}
+		}
+		if (changed)
+			continue;
+		for (uint i = 0; i < g.edges.size() && !changed; i++) {
+			const CellEdge &e = g.edges[i];
+			for (int end = 0; end < 2 && !changed; end++) {
+				const int n = end ? e.b : e.a, other = end ? e.a : e.b;
+				if (g.degree(n) == 1 && g.degree(other) >= 3 && pathLength(e.path) < kSpur && !atEdge(g.nodes[n])) {
+					g.edges.remove_at(i);
+					changed = true;
+				}
+			}
+		}
+		if (changed)
+			continue;
+		// Through nodes with exactly two edges (not loops).
+		for (int n = 0; n < (int)g.nodes.size() && !changed; n++) {
+			Common::Array<int> es;
+			for (uint i = 0; i < g.edges.size(); i++)
+				if (g.edges[i].a == n || g.edges[i].b == n)
+					es.push_back(i);
+			if (es.size() != 2)
+				continue;
+			CellEdge e1 = g.edges[es[0]], e2 = g.edges[es[1]];
+			if (e1.a == e1.b || e2.a == e2.b)
+				continue;
+			Common::Array<Common::Point> p1 = e1.path, p2 = e2.path;
+			int a, b;
+			if (e1.b == n) {
+				a = e1.a;
+			} else {
+				a = e1.b;
+				Common::reverse(p1.begin(), p1.end());
+			}
+			if (e2.a == n) {
+				b = e2.b;
+			} else {
+				b = e2.a;
+				Common::reverse(p2.begin(), p2.end());
+			}
+			g.edges.remove_at(es[1]);
+			g.edges.remove_at(es[0]);
+			CellEdge joined;
+			joined.a = a;
+			joined.b = b;
+			joined.path = p1;
+			for (uint i = 1; i < p2.size(); i++)
+				joined.path.push_back(p2[i]);
+			g.edges.push_back(joined);
+			changed = true;
+		}
+		if (!changed)
+			break;
+	}
+	// Only the nodes still used, renumbered.
+	Common::Array<int> renum(g.nodes.size());
+	for (auto &r : renum)
+		r = -1;
+	for (auto &e : g.edges)
+		renum[e.a] = renum[e.b] = 0;
+	Common::Array<RoadGraph::Pt> nodes;
+	for (uint n = 0; n < g.nodes.size(); n++) {
+		if (renum[n] >= 0) {
+			renum[n] = nodes.size();
+			nodes.push_back(g.nodes[n]);
+		}
+	}
+	g.nodes = nodes;
+	for (auto &e : g.edges) {
+		e.a = renum[e.a];
+		e.b = renum[e.b];
+	}
+}
+
+} // End of anonymous namespace
+
+void RoadGraph::build(const byte *terrain) {
+	_terrain.resize(kW * kH);
+	memcpy(_terrain.data(), terrain, kW * kH);
+
+	// Roads that leave the map go on: the edge cells repeated outwards, so
+	// their centre lines run to the edge rather than turning away from it.
+	Grid big(kW + 2 * kPad, kH + 2 * kPad);
+	for (int y = 0; y < big.h; y++) {
+		for (int x = 0; x < big.w; x++) {
+			const int sx = CLIP(x - kPad, 0, kW - 1), sy = CLIP(y - kPad, 0, kH - 1);
+			big.v[y * big.w + x] = terrain[sy * kW + sx] < kBlocked ? 1 : 0;
+		}
+	}
+	zhangSuen(big);
+	Grid sk(kW, kH);
+	for (int y = 0; y < kH; y++)
+		for (int x = 0; x < kW; x++)
+			sk.v[y * kW + x] = big.v[(y + kPad) * big.w + x + kPad];
+	tidy(sk);
+	CellGraph g;
+	trace(sk, g);
+	prune(g);
+
+	nodes.clear();
+	edges.clear();
+	for (auto &n : g.nodes)
+		nodes.push_back(Pt(5.0f + 2.0f * n.x, 5.0f + 2.0f * n.y));
+	for (auto &ce : g.edges) {
+		Edge e;
+		e.a = ce.a;
+		e.b = ce.b;
+		// Smoothed: the cells' stair steps averaged out over up to kSmooth
+		// cells either side (the ends stay on their nodes), so the car's aim
+		// moves along a smooth line (user, 2026-10-14: "we can smooth the
+		// movement along the path a bit").
+		const int n = ce.path.size();
+		float len = 0.0f;
+		for (int i = 0; i < n; i++) {
+			const int r = MIN(kSmooth, MIN(i, n - 1 - i));
+			float sx = 0.0f, sy = 0.0f;
+			for (int k = i - r; k <= i + r; k++) {
+				const Pt c = cellCentre(ce.path[k].x, ce.path[k].y);
+				sx += c.x;
+				sy += c.y;
+			}
+			const Pt p(sx / (2 * r + 1), sy / (2 * r + 1));
+			if (i)
+				len += sqrtf((p.x - e.path.back().x) * (p.x - e.path.back().x) + (p.y - e.path.back().y) * (p.y - e.path.back().y));
+			e.path.push_back(p);
+			e.along.push_back(len);
+		}
+		edges.push_back(e);
+	}
+}
+
+int RoadGraph::degree(int node) const {
+	int d = 0;
+	for (auto &e : edges)
+		d += (e.a == node) + (e.b == node);
+	return d;
+}
+
+bool RoadGraph::isExit(int node) const {
+	const Pt &p = nodes[node];
+	const float cx = (p.x - 5.0f) / 2.0f, cy = (p.y - 5.0f) / 2.0f;
+	return degree(node) == 1 && (cx < kExitMargin || cy < kExitMargin || cx >= kW - kExitMargin || cy >= kH - kExitMargin);
+}
+
+RoadGraph::Spot RoadGraph::nearest(float x, float y, int onlyEdge) const {
+	Spot best;
+	float bestD2 = 1e30f;
+	for (uint ei = 0; ei < edges.size(); ei++) {
+		if (onlyEdge >= 0 && (int)ei != onlyEdge)
+			continue;
+		const Edge &e = edges[ei];
+		for (uint i = 0; i + 1 < e.path.size(); i++) {
+			const Pt &p = e.path[i], &q = e.path[i + 1];
+			const float dx = q.x - p.x, dy = q.y - p.y;
+			const float l2 = dx * dx + dy * dy;
+			float t = l2 > 0.0f ? ((x - p.x) * dx + (y - p.y) * dy) / l2 : 0.0f;
+			t = CLIP(t, 0.0f, 1.0f);
+			const float px = p.x + t * dx - x, py = p.y + t * dy - y;
+			const float d2 = px * px + py * py;
+			if (d2 < bestD2) {
+				bestD2 = d2;
+				best.edge = ei;
+				best.s = e.along[i] + t * (e.along[i + 1] - e.along[i]);
+			}
+		}
+	}
+	best.dist = sqrtf(bestD2);
+	return best;
+}
+
+RoadGraph::Pt RoadGraph::pointAt(int edge, float s) const {
+	const Edge &e = edges[edge];
+	if (e.path.size() == 1 || s <= 0.0f)
+		return e.path[0];
+	for (uint i = 0; i + 1 < e.path.size(); i++) {
+		if (s <= e.along[i + 1]) {
+			const float seg = e.along[i + 1] - e.along[i];
+			const float t = seg > 0.0f ? (s - e.along[i]) / seg : 0.0f;
+			return Pt(e.path[i].x + t * (e.path[i + 1].x - e.path[i].x), e.path[i].y + t * (e.path[i + 1].y - e.path[i].y));
+		}
+	}
+	return e.path.back();
+}
+
+RoadGraph::Pt RoadGraph::tangentAt(int edge, float s) const {
+	// Over a few pixels either side: the path goes in steps of cells.
+	const Pt p = pointAt(edge, s - 6.0f), q = pointAt(edge, s + 6.0f);
+	const float dx = q.x - p.x, dy = q.y - p.y, l = sqrtf(dx * dx + dy * dy);
+	return l > 0.0f ? Pt(dx / l, dy / l) : Pt(0.0f, -1.0f);
+}
+
+RoadGraph::Pt RoadGraph::leaving(int node, int edge, bool forward) const {
+	const Edge &e = edges[edge];
+	const float len = e.length();
+	const float s = forward ? MIN(24.0f, len) : MAX(0.0f, len - 24.0f);
+	const Pt from = nodes[node], to = pointAt(edge, s);
+	const float dx = to.x - from.x, dy = to.y - from.y, l = sqrtf(dx * dx + dy * dy);
+	return l > 0.0f ? Pt(dx / l, dy / l) : tangentAt(edge, forward ? 0.0f : len);
+}
+
+byte RoadGraph::terrainAt(float x, float y) const {
+	const int cx = ((int)x - 4) / 2, cy = ((int)y - 4) / 2;
+	if (cx < 0 || cy < 0 || cx >= kW || cy >= kH || _terrain.empty())
+		return kBlocked;
+	return _terrain[cy * kW + cx];
+}
+
+// The driver.
+
+namespace {
+
+float dot(const RoadGraph::Pt &a, const RoadGraph::Pt &b) {
+	return a.x * b.x + a.y * b.y;
+}
+
+RoadGraph::Pt unit(float x, float y) {
+	const float l = sqrtf(x * x + y * y);
+	return l > 0.0f ? RoadGraph::Pt(x / l, y / l) : RoadGraph::Pt();
+}
+
+// The game's heading (sixteenths, 16 up, 4 right) of a direction on screen.
+float headingOf(float dx, float dy) {
+	float h = atan2f(dx, -dy) * 16.0f / (2.0f * (float)M_PI);
+	if (h <= 0.0f)
+		h += 16.0f;
+	return h;
+}
+
+int propInt(AbstractObject *obj, const char *name, int def = 0) {
+	if (!obj->hasProp(name))
+		return def;
+	Datum d = obj->getProp(name);
+	return d.type == INT || d.type == FLOAT ? d.asInt() : def;
+}
