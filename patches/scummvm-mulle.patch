+// D7+ flipH/flipV mirror a sprite around its registration point (the rect's
+// origin here). Bygg hus draws the walls along one axis as flipped copies of
+// the other's.
+Common::Rect Sprite::flipAroundRegistration(const Common::Rect &r) const {
+	if (g_director->getVersion() < 700 || !(_thickness & kTFlip))
+		return r;
+	Common::Rect out = r;
+	if (_thickness & kTFlipH) {
+		out.left = -r.right;
+		out.right = -r.left;
+	}
+	if (_thickness & kTFlipV) {
+		out.top = -r.bottom;
+		out.bottom = -r.top;
+	}
+	return out;
