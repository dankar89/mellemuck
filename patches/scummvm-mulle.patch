+ *
+ */
+
+#include "common/system.h"
+
+#include "director/director.h"
+#include "director/movie.h"
+#include "director/lingo/lingo.h"
+#include "director/lingo/lingo-timeoutobj.h"
+
+namespace Director {
+
+// The running timeouts, in the order they were made (the timeoutList).
+static Common::Array<TimeoutObject *> *s_timeouts = nullptr;
+
+static const MethodProto timeoutMethods[] = {
+	{ "new",			LM::m_timeoutNew,		2, 3,	700 },
+	{ "forget",			LM::m_timeoutForget,	0, 0,	700 },
+	{ nullptr, nullptr, 0, 0, 0 }
+};
+
+TimeoutObject::TimeoutObject(const Common::String &name) : Object<TimeoutObject>("timeout"),
+	_timeoutName(name), _period(0), _next(0), _persistent(false), _movie(nullptr) {
+}
+
+TimeoutObject::TimeoutObject(const TimeoutObject &other) : Object<TimeoutObject>(other),
+	_timeoutName(other._timeoutName), _period(other._period), _handler(other._handler), _target(other._target),
+	_next(other._next), _persistent(other._persistent), _movie(other._movie) {
+}
+
+void TimeoutObject::initMethods() {
+	Object<TimeoutObject>::initMethods(timeoutMethods);
+}
+
+void TimeoutObject::cleanup() {
+	if (s_timeouts) {
+		for (auto &t : *s_timeouts)
+			t->decRefCount();
+		delete s_timeouts;
+		s_timeouts = nullptr;
+	}
+	cleanupMethods();
+}
+
+static Common::Array<TimeoutObject *> &timeouts() {
+	if (!s_timeouts)
+		s_timeouts = new Common::Array<TimeoutObject *>();
+	return *s_timeouts;
+}
+
+// timeout("name"): the running one with that name, or a new one to start
+// with .new().
+Datum TimeoutObject::get(const Common::String &name) {
+	for (auto &t : timeouts()) {
+		if (t->_timeoutName.equalsIgnoreCase(name))
+			return Datum(t);
+	}
+	return Datum(new TimeoutObject(name));
+}
+
+void TimeoutObject::forgetNamed(const Common::String &name) {
+	Common::Array<TimeoutObject *> &list = timeouts();
+	for (uint i = 0; i < list.size(); i++) {
+		if (list[i]->_timeoutName.equalsIgnoreCase(name)) {
+			TimeoutObject *t = list[i];
+			list.remove_at(i);
+			t->decRefCount();
+			return;
+		}
+	}
+}
+
+void TimeoutObject::fireDue() {
+	if (!s_timeouts || s_timeouts->empty())
+		return;
+	uint32 now = g_system->getMillis();
+	Movie *movie = g_director->getCurrentMovie();
+	// A copy: a handler may make or forget timeouts.
+	Common::Array<TimeoutObject *> due;
+	for (uint i = 0; i < s_timeouts->size(); i++) {
+		TimeoutObject *t = (*s_timeouts)[i];
+		if (!t->_persistent && t->_movie != movie) {
+			// Its movie has gone.
+			s_timeouts->remove_at(i--);
+			t->decRefCount();
+			continue;
+		}
+		if ((int32)(now - t->_next) >= 0)
+			due.push_back(t);
+	}
+	for (auto &t : due) {
+		t->incRefCount();
+		t->_next = now + MAX(t->_period, 1);
+		Datum self(t);
+		if (t->_target.type == OBJECT) {
+			g_lingo->push(t->_target);
+			g_lingo->push(self);
+			g_lingo->executeHandler(t->_handler, 2);
+		} else {
+			g_lingo->push(self);
+			g_lingo->executeHandler(t->_handler, 1);
+		}
+		t->decRefCount();
+	}
+}
+
+bool TimeoutObject::hasProp(const Common::String &propName) {
+	return propName.equalsIgnoreCase("name") || propName.equalsIgnoreCase("period") ||
+		propName.equalsIgnoreCase("persistent") || propName.equalsIgnoreCase("target") ||
+		propName.equalsIgnoreCase("timeoutHandler") || propName.equalsIgnoreCase("time");
+}
+
+Datum TimeoutObject::getProp(const Common::String &propName) {
+	if (propName.equalsIgnoreCase("name"))
+		return Datum(_timeoutName);
+	if (propName.equalsIgnoreCase("period"))
+		return Datum(_period);
+	if (propName.equalsIgnoreCase("persistent"))
+		return Datum(_persistent ? 1 : 0);
+	if (propName.equalsIgnoreCase("target"))
+		return _target;
+	if (propName.equalsIgnoreCase("time"))
+		return Datum((int)_next);
+	Datum d(_handler);
+	d.type = SYMBOL;
+	return d;
+}
+
+void TimeoutObject::setProp(const Common::String &propName, const Datum &value, bool force) {
+	if (propName.equalsIgnoreCase("period"))
+		_period = value.asInt();
+	else if (propName.equalsIgnoreCase("persistent"))
+		_persistent = value.asInt() != 0;
+	else if (propName.equalsIgnoreCase("target"))
+		_target = value;
+	else if (propName.equalsIgnoreCase("timeoutHandler"))
+		_handler = value.asString();
+	else if (propName.equalsIgnoreCase("name"))
+		_timeoutName = value.asString();
+}
+
+Common::String TimeoutObject::asString() {
+	return Common::String::format("timeout(\"%s\")", _timeoutName.c_str());
+}
+
+static TimeoutObject *me() {
+	return static_cast<TimeoutObject *>(g_lingo->_state->me.u.obj);
+}
+
+// timeout("name").new(period, #handler [, target]): LC::call runs "new" on a
+// copy of the object, which becomes the running timeout.
+void LM::m_timeoutNew(int nargs) {
+	Datum target = nargs > 2 ? g_lingo->pop() : Datum();
+	Datum handler = g_lingo->pop();
+	Datum period = g_lingo->pop();
+	TimeoutObject *t = me();
+	TimeoutObject::forgetNamed(t->_timeoutName);
+	t->_period = period.asInt();
+	t->_handler = handler.asString();
+	t->_target = target;
+	t->_next = g_system->getMillis() + MAX(t->_period, 1);
+	t->_movie = g_director->getCurrentMovie();
+	t->incRefCount();
+	timeouts().push_back(t);
+	g_lingo->push(Datum(t));
+}
+
+void LM::m_timeoutForget(int nargs) {
+	TimeoutObject::forgetNamed(me()->_timeoutName);
+}
+
+void LB::b_timeout(int nargs) {
+	g_lingo->push(TimeoutObject::get(g_lingo->pop().asString()));
+}
+
+} // End of namespace Director
