+
+static void feedTestPad(int p) {
+	SDL_Joystick *pad = s_testPads[p];
+	SDL_RWops *file = SDL_RWFromFile(SDL_getenv(kTestPadVars[p]), "rb");
+	if (!file)
+		return;
+	const Sint64 size = SDL_RWsize(file);
+	Common::String text;
+	if (size > s_testPadRead[p] && SDL_RWseek(file, s_testPadRead[p], RW_SEEK_SET) >= 0) {
+		char buf[512];
+		size_t got;
+		while (text.size() < 65536 && (got = SDL_RWread(file, buf, 1, sizeof(buf))) > 0)
+			text += Common::String(buf, got);
+	}
+	SDL_RWclose(file);
+	// Whole lines only: the rest is still being written.
+	const size_t end = text.findLastOf('\n');
+	if (end == Common::String::npos)
+		return;
+	s_testPadRead[p] += end + 1;
+	Common::String line;
+	for (size_t i = 0; i <= end; i++) {
+		if (text[i] != '\n') {
+			line += text[i];
+			continue;
+		}
+		line.trim();
+		const size_t space = line.findFirstOf(' ');
+		if (space != Common::String::npos) {
+			const Common::String name = line.substr(0, space);
+			Common::String arg = line.substr(space + 1);
+			arg.trim();
+			const SDL_GameControllerButton button = SDL_GameControllerGetButtonFromString(name.c_str());
+			const SDL_GameControllerAxis axis = SDL_GameControllerGetAxisFromString(name.c_str());
+			if (button != SDL_CONTROLLER_BUTTON_INVALID && (arg == "down" || arg == "up"))
+				SDL_JoystickSetVirtualButton(pad, button, arg == "down" ? SDL_PRESSED : SDL_RELEASED);
+			else if (axis != SDL_CONTROLLER_AXIS_INVALID)
+				SDL_JoystickSetVirtualAxis(pad, axis, (Sint16)CLIP<int>(atoi(arg.c_str()), -32768, 32767));
+			else
+				warning("Test pad: cannot read '%s'", line.c_str());
+		}
+		line.clear();
+	}
