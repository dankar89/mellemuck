+
+#ifndef DIRECTOR_LINGO_LINGO_TIMEOUTOBJ_H
+#define DIRECTOR_LINGO_LINGO_TIMEOUTOBJ_H
+
+#include "director/lingo/lingo-object.h"
+
+namespace Director {
+
+class Movie;
+
+// D7+ timeout objects: timeout("name").new(period, #handler, target) calls
+// handler(target, timeout) every period milliseconds until
+// timeout("name").forget(). Not persistent ones end with their movie. Bygg hus
+// med Mulle Meck lets Mulle explain a build book button after 1.2 s on it.
+class TimeoutObject : public Object<TimeoutObject> {
+public:
+	TimeoutObject(const Common::String &name);
+	TimeoutObject(const TimeoutObject &other);
+
+	static void initMethods();
+	static void cleanup();
+	static Datum get(const Common::String &name);
+	static void fireDue();	// from Score::update()
+	static void forgetNamed(const Common::String &name);
+
+	bool hasProp(const Common::String &propName) override;
+	Datum getProp(const Common::String &propName) override;
+	void setProp(const Common::String &propName, const Datum &value, bool force = false) override;
+	Common::String asString() override;
+
+	Common::String _timeoutName;
+	int _period;
+	Common::String _handler;
+	Datum _target;
+	uint32 _next;
+	bool _persistent;
+	Movie *_movie;
+};
+
+namespace LM {
+void m_timeoutNew(int nargs);
+void m_timeoutForget(int nargs);
+} // End of namespace LM
+
+namespace LB {
+void b_timeout(int nargs);
+} // End of namespace LB
+
+} // End of namespace Director
+
+#endif
