+
+bool Channel::scriptsTakeMouse() {
+	// The score's own behaviors are Sprite::respondsToMouse()'s; a pointer sprite
+	// whose behaviors ignore the mouse must not catch clicks.
+	if (g_director->getVersion() < 600 || !_sprite || !_scriptInstanceList.changedByScript(_sprite->_behaviors.size()))
+		return false;
+	static const char *const mouseHandlers[] = {
+		"mouseDown", "mouseUp", "rightMouseDown", "rightMouseUp", "mouseEnter", "mouseLeave", "mouseWithin", "mouseUpOutSide"
+	};
+	for (uint i = 0; i < _scriptInstanceList.size(); i++) {
+		Datum &instance = _scriptInstanceList[i];
+		if (instance.type != OBJECT)
+			continue;
+		for (const char *name : mouseHandlers) {
+			if (instance.u.obj->getMethod(name).type != VOIDSYM)
+				return true;
+		}
+	}
+	return false;
+}
+
+void ScriptInstanceList::set(const Datum &list) {
+	_set = true;
+	if (list.type == ARRAY)
+		_list->u.farr->arr = list.u.farr->arr;
+	else
+		_list->u.farr->arr.clear();
+}
