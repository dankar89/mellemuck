+			{ "MENULEFT", _s("Left"), Director::kActionMenuLeft, { "LEFT", "JOY_LEFT", "JOY_LEFT_STICK_X-", nullptr } },
+			{ "MENURIGHT", _s("Right"), Director::kActionMenuRight, { "RIGHT", "JOY_RIGHT", "JOY_LEFT_STICK_X+", nullptr } },
+			{ "MENUSELECT", _s("Select"), Director::kActionMenuSelect, { "RETURN", "KP_ENTER", "SPACE", "JOY_A" } },
+			{ "MENUBACK", _s("Back"), Director::kActionMenuBack, { "ESCAPE", "BACKSPACE", "JOY_B", nullptr } },
+			{ "MENUCLOSE", _s("Close the menu"), Director::kActionMenuClose, { "F5", nullptr, nullptr, nullptr } },
+		};
+		for (auto &m : menuActions) {
+			act = new Action(m.id, _(m.desc));
+			act->setCustomEngineActionEvent(m.action);
+			for (const char *input : m.inputs) {
+				if (input)
+					act->addDefaultInputMapping(input);
+			}
+			menu->addAction(act);
+		}
+		menu->setEnabled(false);
+
+		KeymapArray keymaps;
+		keymaps.push_back(keymap);
+		keymaps.push_back(driving);
+		keymaps.push_back(menu);
+		return keymaps;
+	}
