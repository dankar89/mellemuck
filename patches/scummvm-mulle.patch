+// The play log's view of the gamepad: its buttons as the system sends them,
+// before the keymapper makes clicks, keys or actions of them (so a release that
+// never reaches the game shows). Maps nothing itself.
+bool PadLog::mapEvent(const Common::Event &ev, Common::List<Common::Event> &mappedEvents) {
+	if (g_director && (ev.type == Common::EVENT_JOYBUTTON_DOWN || ev.type == Common::EVENT_JOYBUTTON_UP))
+		g_director->logPlayEvent(ev);
+	return false;
