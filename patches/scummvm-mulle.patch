+// D8.5 bytecode turns dot-syntax chunks into calls with a chunk symbol:
+// s.char[a..b] is getProp(s, #char, a, b).
+static bool chunkSymbol(const Datum &d, ChunkType &type) {
+	if (d.type != SYMBOL)
+		return false;
+	if (d.u.s->equalsIgnoreCase("char") || d.u.s->equalsIgnoreCase("chars"))
+		type = kChunkChar;
+	else if (d.u.s->equalsIgnoreCase("word") || d.u.s->equalsIgnoreCase("words"))
+		type = kChunkWord;
+	else if (d.u.s->equalsIgnoreCase("item") || d.u.s->equalsIgnoreCase("items"))
+		type = kChunkItem;
+	else if (d.u.s->equalsIgnoreCase("line") || d.u.s->equalsIgnoreCase("lines"))
+		type = kChunkLine;
+	else
+		return false;
+	return true;
+}
+
+// obj.prop[a] or obj.prop[a..b] (getPropRef, setProp): the chunk reference,
+// or VOID with isChunk false for list properties.
+static Datum chunkOrPropRef(const Datum &src, const Datum &what, const Datum &first, const Datum *last, bool &isChunk) {
+	ChunkType type;
+	isChunk = chunkSymbol(what, type) && (src.type == STRING || src.isRef());
+	if (!isChunk)
+		return Datum();
+	return LC::chunkRef(type, first.asInt(), last ? last->asInt() : 0, src);
+}
+
+void LB::b_getPropRef(int nargs) {
+	Datum last = nargs == 4 ? g_lingo->pop() : Datum();
+	Datum first = g_lingo->pop();
+	Datum what = g_lingo->pop();
+	Datum src = g_lingo->pop();
+	bool isChunk;
+	Datum ref = chunkOrPropRef(src, what, first, nargs == 4 ? &last : nullptr, isChunk);
+	if (isChunk) {
+		g_lingo->push(ref);
+		return;
+	}
+	g_lingo->push(src.eval());
+	g_lingo->push(what);
+	g_lingo->push(first);
+	if (nargs == 4)
+		g_lingo->push(last);
+	b_getProp(nargs);
+}
