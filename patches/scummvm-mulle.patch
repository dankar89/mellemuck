+
+void SdlGraphicsManager::setSystemCursor(SDL_Surface *image, int hotspotX, int hotspotY) {
+	SDL_Cursor *cursor = SDL_CreateColorCursor(image, hotspotX, hotspotY);
+	if (!cursor) {
+		warning("SdlGraphicsManager::setSystemCursor(): %s", SDL_GetError());
+		clearSystemCursor();
+		return;
+	}
+	SDL_Cursor *old = _systemCursor;
+	_systemCursor = cursor;
+	refreshSystemCursor();
+	if (old) {
+#if SDL_VERSION_ATLEAST(3, 0, 0)
+		SDL_DestroyCursor(old);
+#else
+		SDL_FreeCursor(old);
+#endif
+	}
+}
+
+void SdlGraphicsManager::clearSystemCursor() {
+	if (!_systemCursor)
+		return;
+	SDL_Cursor *old = _systemCursor;
+	_systemCursor = nullptr;
+	SDL_SetCursor(SDL_GetDefaultCursor());
+#if SDL_VERSION_ATLEAST(3, 0, 0)
+	SDL_DestroyCursor(old);
+#else
+	SDL_FreeCursor(old);
+#endif
+}
+
+void SdlGraphicsManager::applySystemCursor(bool showDefault, bool showGameCursor) {
+	showGameCursor = showGameCursor && _systemCursor;
+	SDL_Cursor *cursor = showGameCursor ? _systemCursor : SDL_GetDefaultCursor();
+	if (cursor && SDL_GetCursor() != cursor)
+		SDL_SetCursor(cursor);
+	showSystemMouseCursor(showDefault || showGameCursor);
+}
+
+void SdlGraphicsManager::refreshSystemCursor() {
+	int x, y;
+	getMouseState(&x, &y);
+	bool inside = _activeArea.drawRect.contains(Common::Point(x, y));
+	applySystemCursor(_cursorVisible && !inside, _cursorVisible && inside);
+}
