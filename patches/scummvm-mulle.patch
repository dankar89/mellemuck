+HDArt::HDArt(DirectorEngine *vm) : _vm(vm) {
+	memset(_palette, 0, sizeof(_palette));
+}
+
+HDArt::~HDArt() {
+	for (auto &it : _carClean)
+		delete it._value;
+	for (auto &it : _turned)
+		delete it._value;
+	for (auto &it : _images)
+		delete it._value.surface;
+	for (auto layer : _layers)
+		delete layer;
+}
+
+uint32 HDArt::screenColor(uint32 c) const {
+	if (_vm->_pixelformat.bytesPerPixel == 1)
+		return _palette[c & 0xff];
+	byte a, r, g, b;
+	_vm->_pixelformat.colorToARGB(c, a, r, g, b);
+	return _format.ARGBToColor(0xff, r, g, b);
+}
+
+bool HDArt::init() {
+	// The classic layers between HD images are drawn on scratch stages in
+	// the window manager's format: 8-bit, or true colour (Bygg hus, D8.5).
+
+	if (ConfMan.hasKey("hd_path"))
+		_dir = Common::FSNode(ConfMan.getPath("hd_path"));
+	else
+		_dir = Common::FSNode(ConfMan.getPath("path")).getChild("HD");
+	if (!_dir.exists() || !_dir.isDirectory())
+		return false;
+
+	// One line per bitmap: cast file, member, category, then variant=file for
+	// each ink variant (copy, matte, bgtrans), separated by tabs.
+	Common::SeekableReadStream *stream = _dir.getChild("index.txt").createReadStream();
+	if (!stream)
+		return false;
+	while (!stream->eos() && !stream->err()) {
+		Common::String line = stream->readLine();
+		if (line.empty() || line[0] == '#')
+			continue;
+		Common::StringTokenizer tok(line, "\t");
+		Common::String cast = tok.nextToken();
+		Common::String member = tok.nextToken();
+		Common::String category = tok.nextToken();
+		Entry entry;
+		entry.background = (category == "background");
+		while (!tok.empty()) {
+			Common::String item = tok.nextToken();
+			size_t eq = item.findFirstOf('=');
+			if (eq == Common::String::npos)
+				continue;
+			Common::String variant = item.substr(0, eq);
+			Common::String file = item.substr(eq + 1);
+			if (variant == "copy")
+				entry.file[kVariantCopy] = file;
+			else if (variant == "matte")
+				entry.file[kVariantMatte] = file;
+			else if (variant == "bgtrans")
+				entry.file[kVariantBgTrans] = file;
+		}
+		_index[cast + ":" + member] = entry;
+	}
+	delete stream;
+	if (_index.empty())
+		return false;
+
+	_showArt = !ConfMan.hasKey("hd_art") || ConfMan.getBool("hd_art");
+	_sprites = !ConfMan.hasKey("hd_sprites") || ConfMan.getBool("hd_sprites");
+	int cacheMB = ConfMan.hasKey("hd_cache_mb") ? ConfMan.getInt("hd_cache_mb") : 1024;
+	_cacheLimit = (uint32)CLIP(cacheMB, 64, 4000) * 1024 * 1024;
+	_format = Graphics::BlendBlit::getSupportedPixelFormat();
+
+	Common::String msg = Common::String::format("HD art: %u images from %s (%s, %s)\n", _index.size(),
+		_dir.getPath().toString(Common::Path::kNativeSeparator).c_str(), _showArt ? "shown" : "hidden",
+		_sprites ? "backgrounds and sprites" : "backgrounds");
+	g_system->logMessage(LogMessageType::kInfo, msg.c_str());
+	return true;
+}
+
+void HDArt::toggleArt() {
+	_showArt = !_showArt;
+	ConfMan.setBool("hd_art", _showArt, Common::ConfigManager::kApplicationDomain);
+	ConfMan.flushToDisk();
+	_fullRedraw = true;
+	debugC(1, kDebugImages, "HDArt::toggleArt(): HD art %s", _showArt ? "on" : "off");
+}
