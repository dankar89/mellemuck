+
+void DirectorEngine::trackKeys(const Common::Event &event) {
+	if (event.type == Common::EVENT_KEYDOWN) {
+		bool held = false;
+		for (auto key : _keysDown)
+			held |= (key == event.kbd.keycode);
+		if (!held)
+			_keysDown.push_back(event.kbd.keycode);
+	} else if (event.type == Common::EVENT_KEYUP) {
+		for (uint i = 0; i < _keysDown.size(); i++) {
+			if (_keysDown[i] == event.kbd.keycode) {
+				_keysDown.remove_at(i);
+				break;
+			}
+		}
+	}
+}
+
+int DirectorEngine::platformKeyCode(Common::KeyCode key) {
+	if (getPlatform() != Common::kPlatformWindows)
+		return _KeyCodes.contains(key) ? _KeyCodes[key] : 0;
+
+	// Windows virtual key codes
+	if (key >= Common::KEYCODE_a && key <= Common::KEYCODE_z)
+		return 'A' + (key - Common::KEYCODE_a);
+	if (key >= Common::KEYCODE_0 && key <= Common::KEYCODE_9)
+		return '0' + (key - Common::KEYCODE_0);
+	if (key >= Common::KEYCODE_KP0 && key <= Common::KEYCODE_KP9)
+		return 0x60 + (key - Common::KEYCODE_KP0);
+	if (key >= Common::KEYCODE_F1 && key <= Common::KEYCODE_F12)
+		return 0x70 + (key - Common::KEYCODE_F1);
+	switch (key) {
+	case Common::KEYCODE_BACKSPACE:	return 0x08;
+	case Common::KEYCODE_TAB:		return 0x09;
+	case Common::KEYCODE_RETURN:
+	case Common::KEYCODE_KP_ENTER:	return 0x0D;
+	case Common::KEYCODE_LSHIFT:
+	case Common::KEYCODE_RSHIFT:	return 0x10;
+	case Common::KEYCODE_LCTRL:
+	case Common::KEYCODE_RCTRL:		return 0x11;
+	case Common::KEYCODE_LALT:
+	case Common::KEYCODE_RALT:		return 0x12;
+	case Common::KEYCODE_ESCAPE:	return 0x1B;
+	case Common::KEYCODE_SPACE:		return 0x20;
+	case Common::KEYCODE_PAGEUP:	return 0x21;
+	case Common::KEYCODE_PAGEDOWN:	return 0x22;
+	case Common::KEYCODE_END:		return 0x23;
+	case Common::KEYCODE_HOME:		return 0x24;
+	case Common::KEYCODE_LEFT:		return 0x25;
+	case Common::KEYCODE_UP:		return 0x26;
+	case Common::KEYCODE_RIGHT:		return 0x27;
+	case Common::KEYCODE_DOWN:		return 0x28;
+	case Common::KEYCODE_INSERT:	return 0x2D;
+	case Common::KEYCODE_DELETE:	return 0x2E;
+	default:						return 0;
+	}
+}
+
+// A key press or release made for the gamepad, delivered like the player's
+// own (between handlers, see processSysEvents()).
+void DirectorEngine::padKey(Common::KeyCode key, bool down) {
+	Common::Event event;
+	event.type = down ? Common::EVENT_KEYDOWN : Common::EVENT_KEYUP;
+	event.kbd = Common::KeyState(key);
+	logPlayEvent(event);
+	trackKeys(event);
+	_deferredInput.push_back(event);
+	if (!down)
+		padKeyReleased(key);
+}
+
+// Any key release stops the car turning: the driving movie's keyUp handler
+// calls Dir's keyUp without saying which key, and that ends the steering
+// (Bygger bilar 05, also for keyboard players). While the pad holds a
+// direction, press it again after another key is let go.
+void DirectorEngine::padKeyReleased(Common::KeyCode key) {
+	if (!_drivePad.steer)
+		return;
+	const Common::KeyCode steerKey = _drivePad.steer < 0 ? Common::KEYCODE_LEFT : Common::KEYCODE_RIGHT;
+	if (key == steerKey)
+		return;
+	Common::Event again;
+	again.type = Common::EVENT_KEYDOWN;
+	again.kbd = Common::KeyState(steerKey);
+	trackKeys(again);
+	_deferredInput.push_back(again);
+}
+
+// Gamepad driving. Bygger bilar steers its car like a tank: Left/Right turn
+// it while held, relative to where it points (16 headings), Up/Down change the
+// speed (docs/game-bygger-bilar.md). While the map is driven (Dir's mode is
+// #Driving) the driving keymap is on: the left stick says where on the screen
+// the car should go, and this holds Left or Right for the player until the car
+// points there, as a player would. A and B hold Up and Down. The game itself
+// (speeds, terrain, crashes, fuel) is untouched.
+void DirectorEngine::updateDrivePad() {
+	if (_drivingMovie.empty() || !g_lingo)
+		return;
+
+	// Driving now? The movie, and the game's own state.
+	bool driving = false;
+	AbstractObject *car = nullptr;
+	Movie *movie = getCurrentMovie();
+	if (movie && movie->getMacName().equalsIgnoreCase(_drivingMovie)) {
+		Datum dir = g_lingo->_globalvars.getValOrDefault("gDir");
+		if (dir.type == OBJECT && dir.u.obj->hasProp("mode")) {
+			Datum mode = dir.u.obj->getProp("mode");
+			driving = mode.type == SYMBOL && mode.u.s->equalsIgnoreCase("Driving");
+			if (driving && dir.u.obj->hasProp(_drivingVehicle)) {
+				Datum vehicle = dir.u.obj->getProp(_drivingVehicle);
+				if (vehicle.type == OBJECT)
+					car = vehicle.u.obj;
+			}
+		}
+	}
+
+	if (driving != _drivePad.active) {
+		Common::Keymapper *keymapper = g_system->getEventManager()->getKeymapper();
+		Common::Keymap *drivingMap = keymapper->getKeymap("director-garygadget-driving");
+		Common::Keymap *gameMap = keymapper->getKeymap("director-garygadget");
+		if (drivingMap && gameMap) {
+			drivingMap->setEnabled(driving);
+			gameMap->setEnabled(!driving);
+		}
+		if (!driving) {
+			// Let go of everything held for the pad.
+			if (_drivePad.up)
+				padKey(Common::KEYCODE_UP, false);
+			if (_drivePad.down)
+				padKey(Common::KEYCODE_DOWN, false);
+			if (_roads)
+				_roads->stopDriving();
+			if (_drivePad.steer)
+				padKey(_drivePad.steer < 0 ? Common::KEYCODE_LEFT : Common::KEYCODE_RIGHT, false);
+			_drivePad = DrivePad();
+		}
+		_drivePad.active = driving;
+		debugC(1, kDebugEvents, "DirectorEngine::updateDrivePad(): driving keymap %s", driving ? "on" : "off");
+	}
+	if (!driving || !car || !car->hasProp("direction"))
+		return;
+	if (_roads)
+		_roads->watchCar(car);
+
+	// Turns (and differences of turns) in sixteenths, the car's headings: 16 is
+	// up, 4 right, 8 down, 12 left.
+	auto wrap = [](float d) {
+		while (d > 8.0f)
+			d -= 16.0f;
+		while (d <= -8.0f)
+			d += 16.0f;
+		return d;
+	};
+
+	// Where the stick points, against where the car points.
+	int want = 0;
+	bool pointing = false;
+	float stick = 0.0f, diff = 0.0f;
+	const float x = (float)_drivePad.axis[1] - _drivePad.axis[0];
+	const float y = (float)_drivePad.axis[3] - _drivePad.axis[2];
+
+	// Road driving (roads.h): the road driver says where to steer and when to
+	// go and brake; the keys are held for it as for the pad below.
+	if (_roads && _roads->enabled()) {
+		RoadDriver::Command cmd;
+		const bool on = _roads->update(car, x / Common::JOYAXIS_MAX, y / Common::JOYAXIS_MAX, _drivePad.gas, cmd);
+		if (on && cmd.steer) {
+			diff = wrap(cmd.heading - car->getProp("direction").asInt());
+			if (diff > 0.6f)
+				want = 1;
+			else if (diff < -0.6f)
+				want = -1;
+		}
+		// From the brake to the gas: Down let go first, Up only once the game
+		// has taken that in (the car's acceleration back to 0). Both at once,
+		// the game's idle handles Up, then Down's release, which takes the
+		// gas away again (KeyHandlers.myidle): Up held, the car standing.
+		bool gas = on && cmd.gas;
+		const bool brake = _drivePad.brake || (on && cmd.brake);
+		if (gas && !_drivePad.up && (_drivePad.down || (car->hasProp("acceleration") && car->getProp("acceleration").asInt() != 0)))
+			gas = false;
+		padBrake(brake);
+		padGas(gas);
+		if (want != _drivePad.steer) {
+			debugC(3, kDebugEvents, "DirectorEngine::updateDrivePad(): road driving: heading %.1f, car %s, speed %s: steer %d",
+				cmd.heading, car->getProp("direction").asString().c_str(),
+				car->hasProp("speed") ? car->getProp("speed").asString().c_str() : "?", want);
+			if (_drivePad.steer)
+				padKey(_drivePad.steer < 0 ? Common::KEYCODE_LEFT : Common::KEYCODE_RIGHT, false);
+			if (want)
+				padKey(want < 0 ? Common::KEYCODE_LEFT : Common::KEYCODE_RIGHT, true);
+			_drivePad.steer = want;
+		}
+		return;
+	}
+	if (sqrtf(x * x + y * y) > Common::JOYAXIS_MAX * 0.35f) {
+		pointing = true;
+		stick = atan2f(x, -y) * 16.0f / (2.0f * (float)M_PI);
+		diff = wrap(stick - car->getProp("direction").asInt());
+		// Within about a heading: straight on, so the car does not wobble
+		// between two of its headings.
+		if (diff > 0.6f)
+			want = 1;
+		else if (diff < -0.6f)
+			want = -1;
+	}
+
+	// The game's last hit, as its mouse steering reads it: #stop (stopped and
+	// turned a heading away) or #Turn (slowed and turned to slide along).
+	bool stopped = false, turned = false;
+	if (car->hasProp("previousData")) {
+		Datum previous = car->getProp("previousData");
+		if (previous.type == ARRAY && previous.u.farr->arr.size() >= 2) {
+			Datum last = previous.u.farr->arr[previous.u.farr->arr.size() - 2];
+			if (last.type == ARRAY && last.u.farr->arr.size() >= 3 && last.u.farr->arr[2].type == SYMBOL) {
+				stopped = last.u.farr->arr[2].u.s->equalsIgnoreCase("stop");
+				turned = last.u.farr->arr[2].u.s->equalsIgnoreCase("Turn");
+			}
+		}
+	}
+
+	// Stopped by something the stick still points at: let go of the gas and
+	// keep the car facing the stick, rather than bump on (the game turns the car
+	// away at each bump). Pointing elsewhere or pressing A again drives on.
+	if (_drivePad.blocked && (!pointing || ABS(wrap(stick - _drivePad.blockedAt)) > 1.5f))
+		_drivePad.blocked = false;
+	if (!_drivePad.blocked && _drivePad.up && pointing && stopped && ABS(diff) < 2.5f) {
+		_drivePad.blocked = true;
+		_drivePad.blockedAt = stick;
+		debugC(2, kDebugEvents, "DirectorEngine::updateDrivePad(): blocked towards %.1f", stick);
+	}
+	bool gas = _drivePad.gas && !_drivePad.blocked;
+	bool brake = _drivePad.brake;
+	// Bygger båtar: the boat goes where the stick points (user, 2026-10-15:
+	// "The boat can just move in the direction of the gamepad stick"): Up
+	// (throttle, the oars) while it points within a few headings of the
+	// stick; let go, a motor boat's throttle comes down to a stop. A sail
+	// boat sails on the wind: the stick steers it, A and B work its sail.
+	if (_drivingVehicle.equalsIgnoreCase("boat") && car->hasProp("ancestor")) {
+		Datum ancestor = car->getProp("ancestor");
+		if (ancestor.type == OBJECT && ancestor.u.obj->hasProp("type")) {
+			Datum type = ancestor.u.obj->getProp("type");
+			const Common::String kind = type.type == SYMBOL ? *type.u.s : Common::String();
+			if (pointing && !kind.equalsIgnoreCase("Sail") && ABS(diff) < 2.5f)
+				gas = true;
+			const int motorSpeed = ancestor.u.obj->hasProp("motorSpeed") ? ancestor.u.obj->getProp("motorSpeed").asInt() : 0;
+			// Only a throttle the stick opened: one set with the keys stays
+			// (user, 2026-10-15, on the Deck, where Steam sends the controls as
+			// arrow keys: "you cant go west"; Down, held whenever the stick was
+			// let go, took the throttle away at once and the wind drifted the
+			// boat east).
+			if (pointing && gas && kind.equalsIgnoreCase("Motor"))
+				_drivePad.stickThrottle = true;
+			else if (motorSpeed <= 0 || _drivePad.gas)
+				_drivePad.stickThrottle = false;
+			if (!pointing && _drivePad.stickThrottle)
+				brake = true;
+			// Oars row a stroke per press of Up (Down: backwards): the stroke
+			// counts down the ancestor's Oar to 1 and only a poll without the
+			// key puts it back to 0 for the next one (OarBoatAncestor.steer), so
+			// held, they rowed once. Let go at the stroke's end and press again
+			// once the game has taken that in, as a player tapping the key; the
+			// mouse rows on while held in the game too. In mouse steering a poll
+			// does not reach steer: press anyway, which goes back to the keys.
+			if (kind.equalsIgnoreCase("Oar") && ancestor.u.obj->hasProp("Oar") && car->hasProp("steerMethod")) {
+				const int oar = ancestor.u.obj->getProp("Oar").asInt();
+				const Datum method = car->getProp("steerMethod");
+				if (method.type == SYMBOL && method.u.s->equalsIgnoreCase("Keys")) {
+					if (oar == 1)
+						gas = false;
+					if (oar == -1)
+						brake = false;
+				}
+			}
+			Datum dirObj = g_lingo->_globalvars.getValOrDefault("gDir");
+			const int keyPoll = dirObj.type == OBJECT && dirObj.u.obj->hasProp("gotKeyPoll") ? dirObj.u.obj->getProp("gotKeyPoll").asInt() : -1;
+			const Common::String change = ancestor.u.obj->hasProp("speedChange") ? ancestor.u.obj->getProp("speedChange").asString(true) : "?";
+			debugC(5, kDebugEvents, "DirectorEngine::updateDrivePad(): boat %s, motor %d, speedChange %s, keyPoll %d, stick %s: gas %d, brake %d",
+				kind.c_str(), motorSpeed, change.c_str(), keyPoll, pointing ? "on" : "off", gas, brake);
+		}
+	}
+	padGas(gas);
+	padBrake(brake);
+
+	// Sliding along something: like the game's own mouse steering
+	// (mouseSteer), do not steer back right after a hit, or the two fight; but
+	// only up to a heading off the stick, or the hits add up and the car turns
+	// away from where the player points.
+	if (_drivePad.up && ABS(diff) < 1.6f && (stopped || turned))
+		want = 0;
+	if (want != _drivePad.steer) {
+		debugC(2, kDebugEvents, "DirectorEngine::updateDrivePad(): stick %d,%d, car heading %s, speed %s: steer %d",
+			(int)x, (int)y, car->getProp("direction").asString().c_str(),
+			car->hasProp("speed") ? car->getProp("speed").asString().c_str() : "?", want);
+		if (_drivePad.steer)
+			padKey(_drivePad.steer < 0 ? Common::KEYCODE_LEFT : Common::KEYCODE_RIGHT, false);
+		if (want)
+			padKey(want < 0 ? Common::KEYCODE_LEFT : Common::KEYCODE_RIGHT, true);
+		_drivePad.steer = want;
+	}
+}
+
+void DirectorEngine::releaseHeldInput() {
+	Common::Array<Common::KeyCode> held = _keysDown;
+	for (auto key : held) {
+		Common::Event event;
+		event.type = Common::EVENT_KEYUP;
+		event.kbd = Common::KeyState(key);
+		trackKeys(event);
+		_deferredInput.push_back(event);
+	}
+	// And the mouse button (a drag lets go where the pointer is).
+	if (_leftButtonDown) {
+		Common::Event up;
+		up.type = Common::EVENT_LBUTTONUP;
+		up.mouse = _lastMousePos;
+		_deferredInput.push_back(up);
+		_leftButtonDown = false;
+	}
+	// The stick, A and B as well: their releases go to the menu.
+	DrivePad pad;
+	pad.active = _drivePad.active;
+	_drivePad = pad;
+	if (_roads)
+		_roads->stopDriving();
+}
+
+void DirectorEngine::padGas(bool on) {
+	if (on != _drivePad.up) {
+		_drivePad.up = on;
+		padKey(Common::KEYCODE_UP, on);
+	}
+}
+
+void DirectorEngine::padBrake(bool on) {
+	if (on != _drivePad.down) {
+		_drivePad.down = on;
+		padKey(Common::KEYCODE_DOWN, on);
+	}
+}
