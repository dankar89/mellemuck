+		if (!SDL_IsGameController(i))
+			continue;
+		const SDL_JoystickID id = SDL_JoystickGetDeviceInstanceID(i);
+		if (_controller && SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(_controller)) == id)
+			continue;
+		bool open = false;
+		for (uint j = 0; j < _otherControllers.size(); j++)
+			open |= SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(_otherControllers[j])) == id;
+		if (open)
+			continue;
+		SDL_GameController *c = SDL_GameControllerOpen(i);
+		if (!c)
+			continue;
+		if (!_controller && !_joystick) {
+			_controller = c;
+			debug("Using game controller: %s (pad %d, %04x:%04x)", SDL_GameControllerName(c), (int)id,
+				SDL_GameControllerGetVendor(c), SDL_GameControllerGetProduct(c));
+		} else {
+			_otherControllers.push_back(c);
+			debug("Also using game controller: %s (pad %d, %04x:%04x)", SDL_GameControllerName(c), (int)id,
+				SDL_GameControllerGetVendor(c), SDL_GameControllerGetProduct(c));
+		}
+	}
+}
