+#ifndef DIRECTOR_LINGO_LINGO_IMAGEOBJ_H
+#define DIRECTOR_LINGO_LINGO_IMAGEOBJ_H
+
+#include "graphics/surface.h"
+#include "director/lingo/lingo-object.h"
+
+namespace Director {
+
+// D7+ colour objects: rgb(r, g, b), rgb("#RRGGBB"), paletteIndex(n). Two
+// colours are equal when their values are (Datum::equalTo).
+class ColorObject : public Object<ColorObject> {
+public:
+	ColorObject(byte r, byte g, byte b);
+	ColorObject(int index);
+
+	static void initMethods();
+	static void cleanup();
+	static bool is(const AbstractObject *obj);
+	static bool same(AbstractObject *a, AbstractObject *b);
+
+	bool hasProp(const Common::String &propName) override;
+	Datum getProp(const Common::String &propName) override;
+	void setProp(const Common::String &propName, const Datum &value, bool force = false) override;
+	Common::String asString() override;
+
+	void toRGB(byte &r, byte &g, byte &b) const;
+
+	bool _indexed;
+	int _index;
+	byte _r, _g, _b;
+};
+
+// D8 image objects: image(w, h, depth), member.image, (the stage).image, with
+// getPixel, setPixel, fill, copyPixels, duplicate, crop, trimWhiteSpace.
+// member.image is a reference to the member's picture: changing it changes
+// the member. Bygg hus med Mulle Meck tests clicks on house parts and hotspot
+// masks by pixel, copies the stage for its photo and draws in minigames.
+class ImageObject : public Object<ImageObject> {
+public:
+	ImageObject(int width, int height, int depth);	// white, as in Director
+	ImageObject(const CastMemberID &member);	// member.image
+	ImageObject(const Graphics::Surface &surface, int depth, const byte *palette, int paletteCount);	// a copy
+	ImageObject(const ImageObject &other);
+	~ImageObject() override;
+
+	static void initMethods();
+	static void cleanup();
+	static bool is(const AbstractObject *obj);
+
+	bool hasProp(const Common::String &propName) override;
+	Datum getProp(const Common::String &propName) override;
+	void setProp(const Common::String &propName, const Datum &value, bool force = false) override;
+	Common::String asString() override;
+
+	// The pixels: the own surface, or the member's picture.
+	Graphics::Surface *surface();
+	int depth();
+	const byte *palette();
+	int paletteCount();
+	void changed();	// after a write: the member redraws
+
+	CastMemberID _member;
+	Graphics::Surface _own;
+	int _depth;
+	byte _palette[256 * 3];
+	int _paletteCount;
+};
+
+// member.image = img
+void setMemberImage(CastMemberID id, ImageObject *img);
+
+// The saved cast keeps pictures a script made (Cast::saveTextMembers()).
+class BitmapCastMember;
+class Cast;
+bool serializeBitmapMember(BitmapCastMember *m, Common::Array<byte> &out);
+CastMember *restoreBitmapMember(Cast *cast, int id, const Common::Array<byte> &data);
+
+void initImageObjects();
+void cleanupImageObjects();
+
+namespace LM {
+void m_imageGetPixel(int nargs);
+void m_imageSetPixel(int nargs);
+void m_imageFill(int nargs);
+void m_imageCopyPixels(int nargs);
+void m_imageDuplicate(int nargs);
+void m_imageCrop(int nargs);
+void m_imageTrimWhiteSpace(int nargs);
+void m_imageCreateMask(int nargs);
+void m_imageCreateMatte(int nargs);
+} // End of namespace LM
+
+namespace LB {
+void b_image(int nargs);
+void b_rgb(int nargs);
+void b_paletteIndex(int nargs);
+void b_bitAnd(int nargs);
+void b_bitOr(int nargs);
+void b_bitXor(int nargs);
+void b_bitNot(int nargs);
+} // End of namespace LB
+
+} // End of namespace Director
+
+#endif
