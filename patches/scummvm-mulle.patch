+bool Cast::saveTextMembers(Common::WriteStream &out, const Common::String *onlyName) {
+	out.writeString(Common::String(kCastTextMagic) + "\n");
+	Common::Array<int> ids;
+	for (auto &it : *_loadedCast) {
+		if (it._value && it._value->_type == kCastText)
+			ids.push_back(it._key);
+	}
+	Common::Array<int> vlists;
+	for (auto &it : *_loadedCast) {
+		if (it._value && dynamic_cast<VListCastMember *>(it._value))
+			vlists.push_back(it._key);
+	}
+	Common::sort(ids.begin(), ids.end());
+	Common::sort(vlists.begin(), vlists.end());
+	for (int id : vlists) {
+		CastMemberInfo *info = getCastMemberInfo(id);
+		Common::String name = info ? info->name : Common::String();
+		if (onlyName && !name.equalsIgnoreCase(*onlyName))
+			continue;
+		Common::String text = VListXtra::serialize(((VListCastMember *)getCastMember(id, true))->getContent());
+		out.writeString(Common::String::format("vlist %d %u %u\n", id, name.size(), text.size()));
+		out.writeString(name);
+		out.writeString("\n");
+		out.writeString(text);
+		out.writeString("\n");
+	}
+	// Pictures a script made or changed (not for a per-player save).
+	if (!onlyName) {
+		Common::Array<int> bitmaps;
+		for (auto &it : *_loadedCast) {
+			if (it._value && it._value->_type == kCastBitmap && ((BitmapCastMember *)it._value)->_scriptImage)
+				bitmaps.push_back(it._key);
+		}
+		Common::sort(bitmaps.begin(), bitmaps.end());
+		for (int id : bitmaps) {
+			Common::Array<byte> data;
+			if (!serializeBitmapMember((BitmapCastMember *)getCastMember(id), data))
+				continue;
+			CastMemberInfo *info = getCastMemberInfo(id);
+			Common::String name = info ? info->name : Common::String();
+			out.writeString(Common::String::format("bitmap %d %u %u\n", id, name.size(), data.size()));
+			out.writeString(name);
+			out.writeString("\n");
+			if (!data.empty())
+				out.write(data.data(), data.size());
+			out.writeString("\n");
+		}
+	}
+	for (int id : ids) {
+		CastMemberInfo *info = getCastMemberInfo(id);
+		Common::String name = info ? info->name : Common::String();
+		if (onlyName && !name.equalsIgnoreCase(*onlyName))
+			continue;
+		// Loaded first: members are read from the disc when first used, and
+		// one the game has not used yet had no text here (Bygger båtar's
+		// PartsDB, WorldsDB, hulls... were saved empty, and the next start
+		// failed on them).
+		CastMember *member = getCastMember(id, true);
+		Common::String text = member ? member->getField(kTheText).asString() : Common::String();
+		out.writeString(Common::String::format("member %d %u %u\n", id, name.size(), text.size()));
+		out.writeString(name);
+		out.writeString("\n");
+		out.writeString(text);
+		out.writeString("\n");
+	}
+	return !out.err();
+}
+
+bool Cast::readTextMember(Common::SeekableReadStream &in, const Common::String &name, Common::String &text, bool *isVListOut) {
+	if (in.readLine() != kCastTextMagic)
+		return false;
+	while (!in.eos() && !in.err()) {
+		int id;
+		uint nameLen, textLen;
+		bool isVList, isBitmap;
+		if (!readTextMemberHeader(in.readLine(), id, nameLen, textLen, isVList, &isBitmap))
+			break;
+		Common::String memberName = in.readString(0, nameLen);
+		in.readByte();
+		if (isBitmap) {
+			in.skip(textLen + 1);
+			continue;
+		}
+		Common::String memberText = in.readString(0, textLen);
+		in.readByte();
+		if ((!isVList || isVListOut) && memberName.equalsIgnoreCase(name)) {
+			text = memberText;
+			if (isVListOut)
+				*isVListOut = isVList;
+			return true;
+		}
+	}
+	return false;
+}
+
+bool Cast::applyTextMembers(Common::SeekableReadStream &in, const Common::String &source) {
+	if (in.readLine() != kCastTextMagic) {
+		warning("Cast::applyTextMembers(): %s is not a saved cast, ignoring it", source.c_str());
+		return false;
+	}
+	CastMember *textTemplate = nullptr;
+	for (auto &it : *_loadedCast) {
+		if (it._value && it._value->_type == kCastText) {
+			textTemplate = it._value;
+			break;
+		}
+	}
+	int count = 0;
+	while (!in.eos() && !in.err()) {
+		Common::String header = in.readLine();
+		int id;
+		uint nameLen, textLen;
+		bool isVList, isBitmap;
+		if (!readTextMemberHeader(header, id, nameLen, textLen, isVList, &isBitmap))
+			break;
+		Common::String name = in.readString(0, nameLen);
+		in.readByte();
+		if (isBitmap) {
+			Common::Array<byte> data(textLen);
+			if (textLen)
+				in.read(data.data(), textLen);
+			in.readByte();
+			if (getCastMember(id))
+				eraseCastMember(id);
+			CastMember *bitmap = restoreBitmapMember(this, id, data);
+			if (!bitmap) {
+				warning("Cast::applyTextMembers(): picture %d '%s' in %s does not load", id, name.c_str(), source.c_str());
+				continue;
+			}
+			setCastMember(id, bitmap);
+			getOrCreateCastMemberInfo(id)->name = name;
+			count++;
+			continue;
+		}
+		Common::String text = in.readString(0, textLen);
+		in.readByte();
+
+		if (isVList) {
+			Datum content;
+			if (!VListXtra::parse(text, content)) {
+				warning("Cast::applyTextMembers(): vList member %d '%s' in %s does not parse", id, name.c_str(), source.c_str());
+				continue;
+			}
+			VListCastMember *vlist = dynamic_cast<VListCastMember *>(getCastMember(id));
+			if (!vlist) {
+				if (getCastMember(id))
+					eraseCastMember(id);
+				vlist = new VListCastMember(this, id);
+				setCastMember(id, vlist);
+			}
+			getOrCreateCastMemberInfo(id)->name = name;
+			vlist->setContent(content);
+			vlist->setModified(false);
+			count++;
+			continue;
+		}
+
+		CastMember *member = getCastMember(id);
+		if (!member && textTemplate) {
+			// A member the game created at runtime, e.g. one per player.
+			duplicateCastMember(textTemplate, nullptr, id);
+			member = getCastMember(id);
+		}
+		if (!member || member->_type != kCastText) {
+			warning("Cast::applyTextMembers(): cannot restore member %d from %s", id, source.c_str());
+			continue;
+		}
+		// An empty text over one the disc has: written by a build that saved
+		// members it had not loaded yet (above). Keep the disc's.
+		if (text.empty() && !member->getField(kTheText).asString().empty()) {
+			warning("Cast::applyTextMembers(): member %d '%s' saved empty in %s, keeping the original", id, name.c_str(), source.c_str());
+			continue;
+		}
+		getOrCreateCastMemberInfo(id)->name = name;
+		member->setField(kTheText, Datum(text));
+		count++;
+	}
+	rebuildCastNameCache();
+	debugC(1, kDebugLoading, "Cast::applyTextMembers(): restored %d text members from %s", count, source.c_str());
+	return true;
+}
+
+// Number of older copies kept when a cast is saved over an existing save.
+static const int kCastSaveBackups = 9;
+
+// A whole file from saveTextMembers(): every member complete, nothing after.
+// A crash while writing leaves it cut off (ScummVM writes save files in place).
+static bool completeTextMembers(Common::SeekableReadStream &in) {
+	if (in.readLine() != kCastTextMagic)
+		return false;
+	while (in.pos() < in.size()) {
+		int id;
+		uint nameLen, textLen;
+		bool isVList;
+		if (!readTextMemberHeader(in.readLine(), id, nameLen, textLen, isVList))
+			return false;
+		if (in.size() - in.pos() < (int64)nameLen + textLen + 2)
+			return false;
+		in.skip(nameLen);
+		if (in.readByte() != '\n')
+			return false;
+		in.skip(textLen);
+		if (in.readByte() != '\n')
+			return false;
+	}
+	return !in.err();
+}
+
+void Cast::loadSavedTextMembers() {
+	if (!_castArchive || !_loadedCast)
+		return;
+	// The newest complete one of the save and its backups.
+	Common::SaveFileManager *saves = g_system->getSavefileManager();
+	Common::String saveName = savedTextMembersName();
+	for (int i = 0; i <= kCastSaveBackups; i++) {
+		Common::String name = i ? Common::String::format("%s.bak%d", saveName.c_str(), i) : saveName;
+		Common::ScopedPtr<Common::InSaveFile> in(saves->openForLoading(name));
+		if (!in)
+			continue;
+		if (!completeTextMembers(*in)) {
+			warning("Cast::loadSavedTextMembers(): %s is incomplete, trying an older copy", name.c_str());
+			continue;
+		}
+		in->seek(0);
+		applyTextMembers(*in, name);
+		return;
+	}
+}
+
+bool Cast::writeSavedTextMembers() {
+	// Keep the previous saves: name.bak1 is the newest backup.
+	Common::SaveFileManager *saves = g_system->getSavefileManager();
+	Common::String saveName = savedTextMembersName();
+	if (saves->exists(saveName)) {
+		for (int i = kCastSaveBackups - 1; i >= 1; i--) {
+			Common::String from = Common::String::format("%s.bak%d", saveName.c_str(), i);
+			if (saves->exists(from))
+				saves->renameSavefile(from, Common::String::format("%s.bak%d", saveName.c_str(), i + 1), false);
+		}
+		saves->copySavefile(saveName, saveName + ".bak1", false);
+	}
+
+	Common::OutSaveFile *out = saves->openForSaving(saveName, false);
+	bool ok = out && saveTextMembers(*out);
+	if (out) {
+		out->finalize();
+		ok = ok && !out->err();
+	}
+	delete out;
+	if (!ok)
+		warning("Cast::writeSavedTextMembers(): could not write %s", saveName.c_str());
+	return ok;
 }
 
