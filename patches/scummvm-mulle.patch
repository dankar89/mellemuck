+// Director 7+ Windows games name the system's TrueType fonts (Times New Roman,
+// Arial, Courier New...), which ScummVM does not have: it drew them with a
+// small bitmap font at whatever size it had. The metric-compatible Liberation
+// fonts (SIL OFL, in the package's data folder) draw them at their size.
+void DirectorEngine::addFontSubstitutes() {
+#ifdef USE_FREETYPE2
+	// D6 on Windows too: Bygger båtar's race board is Helvetica 20 (no bitmap
+	// of that size; the one drawn had no Ä for the players' names).
+	if (!_wm || !_wm->_fontMan)
+		return;
+	if (getVersion() < 700 && !(getVersion() >= 600 && getPlatform() == Common::kPlatformWindows))
+		return;
+	static const struct { const char *family; const char *file; } kFamilies[] = {
+		{ "Times New Roman", "LiberationSerif" },
+		{ "Arial", "LiberationSans" },
+		{ "Verdana", "LiberationSans" },
+		{ "Trebuchet MS", "LiberationSans" },
+		{ "Courier New", "LiberationMono" },
+		// Director's cross-platform map (FXmp) turns those into the Mac's names.
+		{ "Times", "LiberationSerif" },
+		{ "Helvetica", "LiberationSans" },
+		{ "Courier", "LiberationMono" },
+	};
+	static const char *const kStyles[] = { "Regular", "Bold", "Italic", "BoldItalic" };	// slant 0-3
+	int added = 0;
+	for (const auto &f : kFamilies) {
+		for (int slant = 0; slant < 4; slant++) {
+			Common::Path file(Common::String::format("%s-%s.ttf", f.file, kStyles[slant]));
+			Common::SeekableReadStream *stream = SearchMan.createReadStreamForMember(file);
+			if (!stream)
+				continue;
+			_wm->_fontMan->addTTFSubstitute(f.family, slant, stream);
+			added++;
+		}
+	}
+	debugC(1, kDebugLoading, "DirectorEngine::addFontSubstitutes(): %d TrueType substitutes", added);
+#endif
+}
