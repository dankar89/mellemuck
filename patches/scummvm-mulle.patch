+void HDArt::initScreen(int w, int h) {
+	_w = w;
+	_h = h;
+
+	// Screen format: what BlendBlit works in if the backend takes it,
+	// otherwise any 32-bit format (present() converts).
+	Common::List<Graphics::PixelFormat> formats = g_system->getSupportedFormats();
+	Graphics::PixelFormat screen = formats.front();
+	bool found = false;
+	for (auto &f : formats) {
+		if (f == _format) {
+			screen = f;
+			found = true;
+			break;
+		}
+	}
+	if (!found) {
+		for (auto &f : formats) {
+			if (f.bytesPerPixel == 4) {
+				screen = f;
+				break;
+			}
+		}
+	}
+	initGraphics(w * kScale, h * kScale, &screen);
+	_screenFormat = g_system->getScreenFormat();
+
+	_surface.create(w * kScale, h * kScale, _format);
+	for (int i = 0; i < 2; i++)
+		_classic[i].create(w, h, _vm->_pixelformat);
+	_fullRedraw = true;
+	_paletteDirty = true;
+	debugC(1, kDebugImages, "HDArt::initScreen(): stage %dx%d, screen %dx%d %s", w, h, w * kScale, h * kScale, _screenFormat.toString().c_str());
+}
+
+HDArt::Layer *HDArt::layerFor(Window *window) {
+	const Graphics::ManagedSurface *inner = window->getSurface();
+	if (!inner || inner->w <= 0 || inner->h <= 0)
+		return nullptr;
+	Layer *layer = nullptr;
+	for (auto l : _layers) {
+		if (l->window == window)
+			layer = l;
+	}
+	if (!layer) {
+		layer = new Layer();
+		layer->window = window;
+		_layers.push_back(layer);
+	}
+	if (layer->surface.w != inner->w * kScale || layer->surface.h != inner->h * kScale) {
+		layer->surface.create(inner->w * kScale, inner->h * kScale, _format);
+		layer->surface.fillRect(Common::Rect(layer->surface.w, layer->surface.h), screenColor(window->getStageColor()));
+		layer->dirty = Common::Rect(layer->surface.w, layer->surface.h);
+	}
+	return layer;
+}
+
+Graphics::ManagedSurface *HDArt::targetFor(Window *window, Common::Rect *&dirty) {
+	if (window == _vm->getStage()) {
+		dirty = &_dirty;
+		return &_surface;
+	}
+	Layer *layer = layerFor(window);
+	if (!layer)
+		return nullptr;
+	dirty = &layer->dirty;
+	return &layer->surface;
+}
+
+void HDArt::paletteChanged() {
+	_paletteDirty = true;
+	_fullRedraw = true;
+}
+
+void HDArt::updatePalette() {
+	if (!_paletteDirty)
+		return;
+	const byte *pal = _vm->getPalette();
+	int count = _vm->getPaletteColorCount();
+	for (int i = 0; i < 256; i++) {
+		if (pal && i < count)
+			_palette[i] = _format.ARGBToColor(0xff, pal[3 * i], pal[3 * i + 1], pal[3 * i + 2]);
+		else
+			_palette[i] = _format.ARGBToColor(0xff, 0, 0, 0);
+	}
+	_paletteDirty = false;
+}
+
+void HDArt::setPassthrough(bool on) {
+	_passthrough = on;
+	if (!on)
+		_fullRedraw = true;
+}
+
+void HDArt::composeAll(Window *window) {
+	compose(window, Common::Rect(_w, _h));
+}
+
+void HDArt::compose(Window *window, const Common::Rect &rect) {
+	Movie *movie = window->getCurrentMovie();
+	if (!movie || !_surface.getPixels())
+		return;
+	updatePalette();
+	Common::Rect *dirty;
+	Graphics::ManagedSurface *dst = targetFor(window, dirty);
+	if (!dst)
+		return;
+	Common::Rect r = rect;
+	// The window's own size, within the scratch stages' (a window is smaller
+	// than the stage).
+	r.clip(Common::Rect(MIN<int>(dst->w / kScale, _w), MIN<int>(dst->h / kScale, _h)));
+	if (r.isEmpty())
+		return;
+	if (_passthrough && window == _vm->getStage()) {
+		upscaleStage(window, r);
+		return;
+	}
+
+	// The vehicle turned smoothly reaches past its sprites: compose its area,
+	// and where it was drawn last, whenever either is touched.
+	Common::Array<VehiclePart> vehicle;
+	if (window == _vm->getStage() && findVehicle(movie, vehicle)) {
+		updateGlide(vehicle[0].ch);
+		const Common::Rect area = vehicleArea(vehicle);
+		if (r.intersects(area) || (!_carArea.isEmpty() && r.intersects(_carArea))) {
+			r.extend(area);
+			if (!_carArea.isEmpty())
+				r.extend(_carArea);
+			r.clip(Common::Rect(MIN<int>(dst->w / kScale, _w), MIN<int>(dst->h / kScale, _h)));
+			_carArea = area;
+		}
+	} else if (window == _vm->getStage()) {
+		_carArea = Common::Rect();
+		_glideKnown = false;
+	}
+
+	Score *score = movie->getScore();
+	Common::Array<Channel *> channels = score->getSpriteIntersections(r);
+	// A sprite with trails leaves copies on the stage that no sprite describes:
+	// show the classic stage there.
+	for (auto ch : channels) {
+		if (ch->_visible && ch->isTrail()) {
+			upscaleStage(window, r);
+			return;
+		}
+	}
+
+	const Common::Rect hr = scaled(r);
+	dst->fillRect(hr, screenColor(window->getStageColor()));
+	Graphics::ManagedSurface target(*dst, hr);	// clips every draw to the area
+
+	// Bottom to top: an HD image is drawn as it is; a run of sprites without
+	// one is drawn the classic way and scaled up.
+	Common::Array<Channel *> group;
+	for (auto ch : channels) {
+		if (!ch->_visible || ch->_hideFromStage || score->isCursorSprite(ch) || score->isStrayCursorSprite(ch))
+			continue;
+		// A sprite's blend, as the classic drawing applies it: Bygger bilar's
+		// garage fades the picture of the scene it came from out to nothing
+		// (blend 0), and the sprite stays so in the next scene (the album
+		// showed a hand in its corner in HD only).
+		const int opacity = spriteOpacity(ch);
+		if (opacity == 0)
+			continue;
+		bool whiteBehind = false;
+		Graphics::ManagedSurface *image = (_showArt && !ch->hasSubChannels()) ? imageFor(movie, ch, &whiteBehind) : nullptr;
+		const VehiclePart *part = nullptr;
+		for (auto &p : vehicle)
+			if (p.ch == ch)
+				part = &p;
+		if (part && image) {
+			Common::Rect carDest;
+			if (Graphics::ManagedSurface *turned = vehicleImage(movie, *part, vehicle[0], carDest)) {
+				drawClassic(group, r, *dst);
+				carDest.translate(-hr.left, -hr.top);
+				target.blendBlitFrom(*turned, Common::Rect(turned->w, turned->h), carDest, Graphics::FLIP_NONE, MS_ARGB(opacity, 255, 255, 255));
+				continue;
+			}
+		}
+		if (!image && opacity < 255) {
+			// Faded, without HD art: alone, drawn opaque, then blended.
+			drawClassic(group, r, *dst);
+			Sprite *sprite = ch->_sprite;
+			const byte blend = sprite->_blendAmount;
+			sprite->_blendAmount = 0;
+			group.push_back(ch);
+			drawClassic(group, r, *dst, opacity);
+			sprite->_blendAmount = blend;
+			continue;
+		}
+		if (!image) {
+			if (_showArt && debugChannelSet(1, kDebugImages))
+				noteClassic(movie, ch);
+			group.push_back(ch);
+			continue;
+		}
+		drawClassic(group, r, *dst);
+		debugC(6, kDebugImages, "HDArt::compose(): channel %d member %s bbox %d,%d %dx%d HD %dx%d opacity %d ink %d type %d thickness %x widget %dx%d puppet %d",
+			(int)(Common::find(score->_channels.begin(), score->_channels.end(), ch) - score->_channels.begin()), ch->_sprite->_castId.asString().c_str(), ch->getBbox().left, ch->getBbox().top,
+			ch->getBbox().width(), ch->getBbox().height(), image->w, image->h, opacity, ch->_sprite->_ink, ch->_sprite->_spriteType, ch->_sprite->_thickness,
+			ch->_widget->getSurface()->w, ch->_widget->getSurface()->h, ch->_sprite->_puppet);
+		Common::Rect dest = scaled(ch->getBbox());
+		dest.translate(-hr.left, -hr.top);
+		if (whiteBehind) {
+			Common::Rect box = dest;
+			box.clip(Common::Rect(target.w, target.h));
+			if (!box.isEmpty())
+				target.fillRect(box, screenColor(_vm->_wm->_colorWhite));
+		}
+		// D7+ flipH/flipV (the box is mirrored already, Sprite::getBbox())
+		int flip = Graphics::FLIP_NONE;
+		if (_vm->getVersion() >= 700 && (ch->_sprite->_thickness & kTFlipH))
+			flip |= Graphics::FLIP_H;
+		if (_vm->getVersion() >= 700 && (ch->_sprite->_thickness & kTFlipV))
+			flip |= Graphics::FLIP_V;
+		target.blendBlitFrom(*image, Common::Rect(image->w, image->h), dest, flip, MS_ARGB(opacity, 255, 255, 255));
+	}
+	drawClassic(group, r, *dst);
+
+	if (dirty->isEmpty())
+		*dirty = hr;
+	else
+		dirty->extend(hr);
+}
+
+// Draws the sprites of a run without HD art onto two original-size stages, one
+// white and one black. Pixels that come out the same on both are the sprites'
+// (whatever their ink), the others transparent; those are scaled up onto the
+// screen.
+uint32 HDArt::mix(uint32 under, uint32 over, int opacity) const {
+	byte a, r1, g1, b1, r2, g2, b2;
+	_format.colorToARGB(under, a, r1, g1, b1);
+	_format.colorToARGB(over, a, r2, g2, b2);
+	const int k = opacity, j = 255 - opacity;
+	return _format.ARGBToColor(0xff, (r2 * k + r1 * j) / 255, (g2 * k + g1 * j) / 255, (b2 * k + b1 * j) / 255);
+}
+
+int HDArt::spriteOpacity(Channel *channel) {
+	const Sprite *sprite = channel->_sprite;
+	if (!sprite || !((sprite->_thickness & kTHasBlend) || sprite->_ink == kInkTypeBlend))
+		return 255;
+	// The classic drawing mixes the sprite in by 255 - _blendAmount.
+	return 255 - sprite->_blendAmount;
+}
+
+void HDArt::drawClassic(Common::Array<Channel *> &group, const Common::Rect &r, Graphics::ManagedSurface &dst, int opacity) {
+	if (group.empty())
+		return;
+	const uint32 backgrounds[2] = { _vm->_wm->_colorWhite, _vm->_wm->_colorBlack };
+	for (int i = 0; i < 2; i++) {
+		_classic[i].fillRect(r, backgrounds[i]);
+		for (auto ch : group) {
+			if (ch->hasSubChannels()) {
+				for (auto &sub : *ch->getSubChannels())
+					Window::inkBlitFrom(&sub, r, &_classic[i]);
+			} else {
+				Window::inkBlitFrom(ch, r, &_classic[i]);
+			}
+		}
+	}
+	group.clear();
+
+	const bool indexed = _vm->_pixelformat.bytesPerPixel == 1;
+	for (int y = r.top; y < r.bottom; y++) {
+		const byte *a = (const byte *)_classic[0].getBasePtr(r.left, y);
+		const byte *b = (const byte *)_classic[1].getBasePtr(r.left, y);
+		byte *row = (byte *)dst.getBasePtr(r.left * kScale, y * kScale);
+		for (int x = 0; x < r.width(); x++) {
+			const uint32 pa = indexed ? a[x] : _classic[0].getPixel(r.left + x, y);
+			if (pa != (indexed ? b[x] : _classic[1].getPixel(r.left + x, y)))
+				continue;
+			const uint32 color = screenColor(pa);
+			for (int dy = 0; dy < kScale; dy++) {
+				uint32 *d = (uint32 *)(row + dy * dst.pitch) + x * kScale;
+				for (int dx = 0; dx < kScale; dx++)
+					d[dx] = opacity >= 255 ? color : mix(d[dx], color, opacity);
+			}
+		}
+	}
+}
+
+void HDArt::upscaleStage(Window *window, const Common::Rect &r) {
+	updatePalette();
+	Common::Rect *dirty;
+	Graphics::ManagedSurface *dst = targetFor(window, dirty);
+	if (!dst)
+		return;
+	Graphics::ManagedSurface *stage = window->getSurface();
+	Common::Rect area = r;
+	area.clip(Common::Rect(MIN<int>(stage->w, dst->w / kScale), MIN<int>(stage->h, dst->h / kScale)));
+	for (int y = area.top; y < area.bottom; y++) {
+		const byte *src = (const byte *)stage->getBasePtr(area.left, y);
+		byte *row = (byte *)dst->getBasePtr(area.left * kScale, y * kScale);
+		for (int x = 0; x < area.width(); x++) {
+			const uint32 color = screenColor(stage->format.bytesPerPixel == 1 ? src[x] : stage->getPixel(area.left + x, y));
+			for (int dy = 0; dy < kScale; dy++) {
+				uint32 *d = (uint32 *)(row + dy * dst->pitch) + x * kScale;
+				for (int dx = 0; dx < kScale; dx++)
+					d[dx] = color;
+			}
+		}
+	}
+	const Common::Rect hr = scaled(area);
+	if (dirty->isEmpty())
+		*dirty = hr;
+	else
+		dirty->extend(hr);
+}
+
+void HDArt::present() {
+	if (!_surface.getPixels())
+		return;
+	Window *stage = _vm->getStage();
+	const bool full = _fullRedraw && !_passthrough;
+	if (_passthrough) {
+		upscaleStage(stage, Common::Rect(_w, _h));
+	} else if (_fullRedraw) {
+		_fullRedraw = false;
+		composeAll(stage);
+	}
+
+	// The windows over the stage (movies in a window), in the window
+	// manager's order. A window's area is shown again when its layer
+	// changed, and the stage's where a window opened, closed or moved.
+	Common::Array<Layer *> showing;
+	Common::Array<Common::Rect> shown;
+	const Common::Array<Window *> *windows = _vm->getWindowList();
+	for (auto window : *windows) {
+		if (!window->getMacWindow()->isVisible() || !window->getCurrentMovie())
+			continue;
+		if (full)
+			composeAll(window);
+		Layer *layer = layerFor(window);
+		if (!layer)
+			continue;
+		const Common::Rect inner = window->getMacWindow()->getInnerDimensions();
+		Common::Rect sr(inner.left * kScale, inner.top * kScale, inner.left * kScale + layer->surface.w, inner.top * kScale + layer->surface.h);
+		if (!layer->dirty.isEmpty()) {
+			Common::Rect d = layer->dirty;
+			d.translate(sr.left, sr.top);
+			if (_dirty.isEmpty())
+				_dirty = d;
+			else
+				_dirty.extend(d);
+			layer->dirty = Common::Rect();
+		}
+		showing.push_back(layer);
+		shown.push_back(sr);
+	}
+	if (!(shown == _shown)) {
+		for (auto &r : _shown) {
+			if (_dirty.isEmpty())
+				_dirty = r;
+			else
+				_dirty.extend(r);
+		}
+		for (auto &r : shown) {
+			if (_dirty.isEmpty())
+				_dirty = r;
+			else
+				_dirty.extend(r);
+		}
+		_shown = shown;
+	}
+	// Layers of windows that are gone (only compared, never used).
+	for (uint i = 0; i < _layers.size();) {
+		bool alive = false;
+		for (auto window : *windows)
+			alive |= _layers[i]->window == window;
+		if (alive) {
+			i++;
+		} else {
+			delete _layers[i];
+			_layers.remove_at(i);
+		}
+	}
+
+	// The vehicle between the game's frames (updateGlide()).
+	if (!_passthrough && stage->getCurrentMovie()) {
+		Common::Array<VehiclePart> vehicle;
+		if (findVehicle(stage->getCurrentMovie(), vehicle)) {
+			updateGlide(vehicle[0].ch);
+			const Common::Rect area = vehicleArea(vehicle);
+			if (gliding() || !_carArea.contains(area))
+				compose(stage, area);
+		}
+	}
+
+	// The road driver's debug view (F7) over the map: redrawn every time,
+	// the car moves under it; once more when it goes, to take it away.
+	const bool roads = _vm->_roads && _vm->_roads->debugShown() && _vm->_drivePad.active;
+	if (roads || _roadsShown) {
+		const Common::Rect r = scaled(RoadDriver::mapRect());
+		if (_dirty.isEmpty())
+			_dirty = r;
+		else
+			_dirty.extend(r);
+		_roadsShown = roads;
+	}
+
+	// The keyboard badge by a name field (Steam Deck), and away again.
+	Common::Rect badge;
+	if (_vm->_steamKeyboard && !_passthrough) {
+		const Common::Rect field = _vm->editableFieldRect();
+		if (!field.isEmpty())
+			badge = keyboardBadge(field);
+	}
+	if (!(badge == _badgeShown)) {
+		for (const Common::Rect &b : { badge, _badgeShown }) {
+			if (b.isEmpty())
+				continue;
+			if (_dirty.isEmpty())
+				_dirty = scaled(b);
+			else
+				_dirty.extend(scaled(b));
+		}
+		if (!_badgeShown.isEmpty())
+			compose(stage, _badgeShown);
+		_badgeShown = badge;
+	}
+	if (!badge.isEmpty()) {
+		if (_dirty.isEmpty())
+			_dirty = scaled(badge);
+		else
+			_dirty.extend(scaled(badge));
+	}
+
+	if (_dirty.isEmpty())
+		return;
+	_dirty.clip(Common::Rect(_surface.w, _surface.h));
+
+	Graphics::ManagedSurface *screen = &_surface;
+	if (!showing.empty() || roads || !badge.isEmpty()) {
+		if (_out.w != _surface.w || _out.h != _surface.h)
+			_out.create(_surface.w, _surface.h, _format);
+		_out.blitFrom(_surface, _dirty, Common::Point(_dirty.left, _dirty.top));
+		for (uint i = 0; i < showing.size(); i++) {
+			Common::Rect part = shown[i].findIntersectingRect(_dirty);
+			if (part.isEmpty())
+				continue;
+			Common::Rect src = part;
+			src.translate(-shown[i].left, -shown[i].top);
+			_out.blitFrom(showing[i]->surface, src, Common::Point(part.left, part.top));
+		}
+		if (roads)
+			_vm->_roads->drawDebug(_out, kScale, _dirty);
+		if (!badge.isEmpty())
+			drawKeyboardBadge(_out, badge);
+		screen = &_out;
+	}
+
+	if (_screenFormat == _format) {
+		g_system->copyRectToScreen(screen->getBasePtr(_dirty.left, _dirty.top), screen->pitch,
+			_dirty.left, _dirty.top, _dirty.width(), _dirty.height());
+	} else {
+		Graphics::Surface area = screen->rawSurface().getSubArea(_dirty);
+		Graphics::Surface *converted = area.convertTo(_screenFormat);
+		g_system->copyRectToScreen(converted->getPixels(), converted->pitch,
+			_dirty.left, _dirty.top, _dirty.width(), _dirty.height());
+		converted->free();
+		delete converted;
+	}
+	_dirty = Common::Rect();
+}
+
+Common::Rect HDArt::keyboardBadge(const Common::Rect &field) const {
+	// Right of the field, its middle level with the field's; left of it if
+	// there is no room.
+	const int w = 30, h = 20;
+	int x = field.right + 6;
+	if (x + w > _w)
+		x = field.left - 6 - w;
+	const int y = CLIP<int>((field.top + field.bottom) / 2 - h / 2, 0, _h - h);
+	return Common::Rect(x, y, x + w, y + h);
+}
+
+void HDArt::drawKeyboardBadge(Graphics::ManagedSurface &screen, const Common::Rect &badge) {
+	// A keyboard: paper-coloured keys in the ink colour of our pause menu.
+	const uint32 ink = _format.RGBToColor(0x4A, 0x2E, 0x17), paper = _format.RGBToColor(0xFF, 0xF3, 0xD6);
+	const uint32 yellow = _format.RGBToColor(0xFF, 0xC5, 0x31);
+	const Common::Rect r = scaled(badge);
+	auto box = [&](int l, int t, int rr, int b, uint32 c) {
+		Common::Rect k(l, t, rr, b);
+		k.clip(Common::Rect(screen.w, screen.h));
+		if (!k.isEmpty())
+			screen.fillRect(k, c);
+	};
+	// Rounded: the corners cut.
+	const int c = 6;
+	box(r.left + c, r.top, r.right - c, r.bottom, ink);
+	box(r.left, r.top + c, r.right, r.bottom - c, ink);
+	box(r.left + c / 2, r.top + c / 2, r.right - c / 2, r.bottom - c / 2, ink);
+	const Common::Rect in(r.left + 6, r.top + 6, r.right - 6, r.bottom - 6);
+	box(in.left + 3, in.top, in.right - 3, in.bottom, yellow);
+	box(in.left, in.top + 3, in.right, in.bottom - 3, yellow);
+	// Three rows of keys and a space bar.
+	const int keyW = 9, keyH = 8, gap = 3;
+	const int cols = (in.width() - 6 + gap) / (keyW + gap);
+	const int left = in.left + (in.width() - (cols * (keyW + gap) - gap)) / 2;
+	for (int row = 0; row < 3; row++) {
+		const int y = in.top + 5 + row * (keyH + gap);
+		const int shift = row == 1 ? keyW / 2 : 0;
+		for (int col = 0; col < cols - (row == 1 ? 1 : 0); col++) {
+			const int x = left + shift + col * (keyW + gap);
+			box(x, y, x + keyW, y + keyH, paper);
+		}
+	}
+	const int y = in.top + 5 + 3 * (keyH + gap);
+	box(left + 2 * (keyW + gap), y, left + (cols - 2) * (keyW + gap) - gap, MIN<int>(y + keyH, in.bottom - 3), paper);
+}
+
+void HDArt::setCursor(const Graphics::ManagedSurface &cursor, uint32 keyColor, int hotX, int hotY) {
+	updatePalette();
+	Graphics::ManagedSurface big(cursor.w * kScale, cursor.h * kScale, _format);
+	for (int y = 0; y < cursor.h; y++) {
+		for (int x = 0; x < cursor.w; x++) {
+			const uint32 pixel = cursor.getPixel(x, y);
+			uint32 color = 0;	// transparent
+			if (pixel != keyColor) {
+				if (cursor.format.isCLUT8()) {
+					color = _palette[pixel & 0xff];
+				} else {
+					byte r, g, b;
+					cursor.format.colorToRGB(pixel, r, g, b);
+					color = _format.ARGBToColor(0xff, r, g, b);
+				}
+			}
+			big.fillRect(Common::Rect(x * kScale, y * kScale, (x + 1) * kScale, (y + 1) * kScale), color);
+		}
+	}
+	CursorMan.replaceCursor(big.rawSurface(), hotX * kScale + kScale / 2, hotY * kScale + kScale / 2, 0);
+}
+
+// A member's HD image in any transparent variant (for cursors).
+Graphics::ManagedSurface *HDArt::memberImage(Movie *movie, CastMemberID id) {
+	if (!id.member)
+		return nullptr;
+	const Common::String stem = castStem(movie, id.castLib);
+	if (stem.empty())
+		return nullptr;
+	auto it = _index.find(Common::String::format("%s:%d", stem.c_str(), id.member));
+	if (it == _index.end())
+		return nullptr;
+	for (int v : { kVariantMatte, kVariantBgTrans, kVariantCopy }) {
+		if (!it->_value.file[v].empty())
+			return load(it->_value.file[v]);
+	}
+	return nullptr;
+}
+
+bool HDArt::setMemberCursor(Movie *movie, CastMemberID id, Common::Point hotspot) {
+	if (!_showArt)
+		return false;
+	Graphics::ManagedSurface *image = memberImage(movie, id);
+	debugC(2, kDebugImages, "HDArt::setMemberCursor(): %s (%s) hotspot %d,%d: %s", id.asString().c_str(),
+		castStem(movie, id.castLib).c_str(), hotspot.x, hotspot.y, image ? "HD" : "no HD image");
+	if (!image)
+		return false;
+	CursorMan.replaceCursor(image->rawSurface(), hotspot.x * kScale + kScale / 2, hotspot.y * kScale + kScale / 2, 0);
+	return true;
+}
+
+void HDArt::cursorChanged(int type, Cursor *cursor) {
+	debugC(2, kDebugImages, "HDArt::cursorChanged(): type %d%s%s", type, cursor ? ", resource " : "",
+		cursor ? cursor->_cursorResId.asString().c_str() : "");
+	Movie *movie = _vm->getCurrentMovie();
+	if (!movie || !_showArt)
+		return;
+	// Bygger bilar's driving arrows: a cursor of two members (image, mask)
+	// counted from the first one, two per heading.
+	if (type == Graphics::kMacCursorCustom && cursor && cursor->_cursorResId.type == ARRAY && !_vm->_drivingArrows.empty()) {
+		const Common::Array<Datum> &members = cursor->_cursorResId.u.farr->arr;
+		const CastMemberID first = movie->getCastMemberIDByName(_vm->_drivingArrows);
+		if (!members.empty() && first.member) {
+			const CastMemberID id = members[0].asMemberID();
+			if (id.castLib == first.castLib && id.member >= first.member && id.member < first.member + 32) {
+				setArrowCursor((id.member - first.member) / 2 + 1);
+				return;
+			}
+		}
+	}
+	auto it = _vm->_pointerArt.find(type);
+	if (it == _vm->_pointerArt.end())
+		return;
+	const CastMemberID id = movie->getCastMemberIDByName(it->_value);
+	CastMember *member = id.member ? movie->getCastMember(id) : nullptr;
+	if (!member || member->_type != kCastBitmap)
+		return;
+	setMemberCursor(movie, id, ((BitmapCastMember *)member)->getRegistrationOffset());
+}
+
+// Our arrow for the driving map, pointing in a heading 1-16 (16 up, 4 right,
+// 8 down, 12 left, as the game's own 1-bit arrows): white with a dark
+// outline, smooth edges (each pixel's coverage from 4x4 samples).
+void HDArt::setArrowCursor(int heading) {
+	Graphics::ManagedSurface &arrow = _arrows[(heading - 1) & 15];
+	const int size = 18 * kScale;
+	if (!arrow.getPixels()) {
+		arrow.create(size, size, _format);
+		arrow.clear(0);
+		// The arrow pointing up, in units of the size, centred.
+		static const float shape[7][2] = { { 0.0f, -0.44f }, { 0.30f, -0.06f }, { 0.11f, -0.06f }, { 0.11f, 0.40f },
+			{ -0.11f, 0.40f }, { -0.11f, -0.06f }, { -0.30f, -0.06f } };
+		const float angle = (heading % 16) * (float)M_PI / 8.0f;	// clockwise from up
+		const float c = cosf(angle), s = sinf(angle);
+		const float outline = 0.07f;
+		auto inside = [&](float x, float y) {
+			// Even-odd test against the polygon.
+			bool in = false;
+			for (int i = 0, j = 6; i < 7; j = i++) {
+				if ((shape[i][1] > y) != (shape[j][1] > y) &&
+						x < (shape[j][0] - shape[i][0]) * (y - shape[i][1]) / (shape[j][1] - shape[i][1]) + shape[i][0])
+					in = !in;
+			}
+			return in;
+		};
+		auto edgeDistance = [&](float x, float y) {
+			float best = 1.0f;
+			for (int i = 0, j = 6; i < 7; j = i++) {
+				const float ax = shape[j][0], ay = shape[j][1], bx = shape[i][0], by = shape[i][1];
+				const float dx = bx - ax, dy = by - ay;
+				float t = ((x - ax) * dx + (y - ay) * dy) / (dx * dx + dy * dy);
+				t = CLIP(t, 0.0f, 1.0f);
+				const float ex = ax + t * dx - x, ey = ay + t * dy - y;
+				best = MIN(best, sqrtf(ex * ex + ey * ey));
+			}
+			return best;
+		};
+		for (int py = 0; py < size; py++) {
+			for (int px = 0; px < size; px++) {
+				int white = 0, dark = 0;
+				for (int sy = 0; sy < 4; sy++) {
+					for (int sx = 0; sx < 4; sx++) {
+						// The sample, turned back into the upright arrow's frame.
+						const float x = (px + (sx + 0.5f) / 4) / size - 0.5f, y = (py + (sy + 0.5f) / 4) / size - 0.5f;
+						const float ux = x * c + y * s, uy = -x * s + y * c;
+						if (inside(ux, uy))
+							(edgeDistance(ux, uy) < outline ? dark : white)++;
+						else if (edgeDistance(ux, uy) < outline)
+							dark++;
+					}
+				}
+				const int cover = white + dark;
+				if (!cover)
+					continue;
+				const int shade = (white * 255 + dark * 40) / cover;
+				arrow.setPixel(px, py, _format.ARGBToColor(cover * 255 / 16, shade, shade, shade));
+			}
+		}
+	}
+	CursorMan.replaceCursor(arrow.rawSurface(), size / 2, size / 2, 0);
+}
+
+bool HDArt::findVehicle(Movie *movie, Common::Array<VehiclePart> &parts) {
+	parts.clear();
+	if (!_vm->_roads || _vm->_roads->carHeading() < 0.0f || !_showArt || !_sprites || _vm->_vehicleArt.empty())
+		return false;
+	if (!movie->getMacName().equalsIgnoreCase(_vm->_drivingMovie))
+		return false;
+	Score *score = movie->getScore();
+	for (uint a = 0; a < _vm->_vehicleArt.size(); a++) {
+		const DirectorEngine::VehicleArt &art = _vm->_vehicleArt[a];
+		const CastMemberID first = movie->getCastMemberIDByName(art.first);
+		if (!first.member)
+			continue;
+		for (auto ch : score->_channels) {
+			Sprite *sprite = ch ? ch->_sprite : nullptr;
+			if (!sprite || !ch->_visible || sprite->_castId.castLib != first.castLib)
+				continue;
+			const int n = sprite->_castId.member - first.member - art.offset;
+			if (n < 0 || n >= art.count)
+				continue;
+			VehiclePart part;
+			part.ch = ch;
+			part.art = a;
+			part.first = first;
+			part.index = n;
+			if (art.attached) {
+				parts.push_back(part);
+			} else if (parts.empty() || _vm->_vehicleArt[parts[0].art].attached) {
+				parts.insert_at(0, part);
+			}
+			break;
+		}
+	}
+	if (parts.empty() || _vm->_vehicleArt[parts[0].art].attached) {
+		parts.clear();
+		return false;
+	}
+	return true;
+}
+
+Graphics::ManagedSurface *HDArt::carClean(int member, Graphics::ManagedSurface *image) {
+	if (_carClean.contains(member) && _carClean[member]->w == image->w && _carClean[member]->h == image->h)
+		return _carClean[member];
+	Graphics::ManagedSurface *clean = new Graphics::ManagedSurface(image->w, image->h, _format);
+	clean->blitFrom(*image);
+	// Light, colourless pixels within a few pixels of the transparent outside.
+	const int reach = kScale;
+	for (int y = 0; y < image->h; y++) {
+		for (int x = 0; x < image->w; x++) {
+			byte a, r, g, b;
+			_format.colorToARGB(image->getPixel(x, y), a, r, g, b);
+			if (a == 0 || MIN(r, MIN(g, b)) < 150 || MAX(r, MAX(g, b)) - MIN(r, MIN(g, b)) > 45)
+				continue;
+			bool edge = false;
+			for (int dy = -reach; dy <= reach && !edge; dy++) {
+				for (int dx = -reach; dx <= reach && !edge; dx++) {
+					const int nx = x + dx, ny = y + dy;
+					byte na, nr, ng, nb;
+					if (nx < 0 || ny < 0 || nx >= image->w || ny >= image->h) {
+						edge = true;
+					} else {
+						_format.colorToARGB(image->getPixel(nx, ny), na, nr, ng, nb);
+						edge = na == 0;
+					}
+				}
+			}
+			if (edge)
+				clean->setPixel(x, y, 0);
+		}
+	}
+	delete _carClean.getValOrDefault(member, nullptr);
+	_carClean[member] = clean;
+	return clean;
+}
+
+Graphics::ManagedSurface *HDArt::vehicleImage(Movie *movie, const VehiclePart &part, const VehiclePart &main, Common::Rect &dest) {
+	const DirectorEngine::VehicleArt &art = _vm->_vehicleArt[part.art];
+	const DirectorEngine::VehicleArt &mainArt = _vm->_vehicleArt[main.art];
+	// How far the heading shown is from the main picture's: the pictures
+	// shifted by the whole headings, turned by the rest.
+	const int gameHeading = (mainArt.heading0 - 1 + main.index % 16) % 16 + 1;
+	float delta = glideHeading() - gameHeading;
+	while (delta > 8.0f)
+		delta -= 16.0f;
+	while (delta <= -8.0f)
+		delta += 16.0f;
+	const int shift = (int)floorf(delta + 0.5f);
+	const float rest = delta - shift;
+	const int row = part.index / 16;
+	const int heading = ((part.index % 16 + shift) % 16 + 16) % 16;
+	const CastMemberID id(part.first.member + art.offset + row * 16 + heading, part.first.castLib);
+	CastMember *member = movie->getCastMember(id);
+	if (!member || member->_type != kCastBitmap)
+		return nullptr;
+	Graphics::ManagedSurface *image = memberImage(movie, id);
+	if (!image)
+		return nullptr;
+	if (art.clean)
+		image = carClean(id.member, image);
+
+	// Turned round the sprite's place (the registration point), by rest
+	// sixteenths, onto a canvas with room for the corners.
+	BitmapCastMember *bitmap = (BitmapCastMember *)member;
+	const Common::Point reg = bitmap->getRegistrationOffset();
+	const int margin = 8 * kScale;
+	const float turn = roundf(rest * 50.0f) / 50.0f;	// some steps, for reuse
+	Turned *t = _turned.getValOrDefault(part.art, nullptr);
+	if (!t) {
+		t = new Turned();
+		_turned[part.art] = t;
+	}
+	if (!(id == t->from) || turn != t->by || t->surface.w != image->w + 2 * margin || t->surface.h != image->h + 2 * margin) {
+		t->from = id;
+		t->by = turn;
+		t->surface.create(image->w + 2 * margin, image->h + 2 * margin, _format);
+		t->surface.clear(0);
+		const float a = turn * 2.0f * (float)M_PI / 16.0f;
+		const float c = cosf(a), s = sinf(a);
+		const float cx = reg.x * kScale + kScale / 2.0f, cy = reg.y * kScale + kScale / 2.0f;
+		for (int y = 0; y < t->surface.h; y++) {
+			uint32 *out = (uint32 *)t->surface.getBasePtr(0, y);
+			for (int x = 0; x < t->surface.w; x++) {
+				// Back into the picture: turn the other way round its centre.
+				const float px = x - margin + 0.5f - cx, py = y - margin + 0.5f - cy;
+				const float sx = px * c + py * s + cx - 0.5f, sy = -px * s + py * c + cy - 0.5f;
+				const int x0 = (int)floorf(sx), y0 = (int)floorf(sy);
+				const float fx = sx - x0, fy = sy - y0;
+				float acc[4] = { 0, 0, 0, 0 };	// premultiplied a, r, g, b
+				for (int k = 0; k < 4; k++) {
+					const int ix = x0 + (k & 1), iy = y0 + (k >> 1);
+					if (ix < 0 || iy < 0 || ix >= image->w || iy >= image->h)
+						continue;
+					const float w = ((k & 1) ? fx : 1.0f - fx) * ((k >> 1) ? fy : 1.0f - fy);
+					byte pa, pr, pg, pb;
+					_format.colorToARGB(image->getPixel(ix, iy), pa, pr, pg, pb);
+					const float wa = w * pa;
+					acc[0] += wa;
+					acc[1] += wa * pr;
+					acc[2] += wa * pg;
+					acc[3] += wa * pb;
+				}
+				if (acc[0] < 1.0f)
+					continue;
+				out[x] = _format.ARGBToColor((byte)CLIP(acc[0] + 0.5f, 0.0f, 255.0f), (byte)CLIP(acc[1] / acc[0] + 0.5f, 0.0f, 255.0f),
+					(byte)CLIP(acc[2] / acc[0] + 0.5f, 0.0f, 255.0f), (byte)CLIP(acc[3] / acc[0] + 0.5f, 0.0f, 255.0f));
+			}
+		}
+	}
+	// Where the picture would be, at the place the vehicle is shown (an
+	// attached part keeps its place on the main one), with the canvas's margin.
+	float x, y;
+	glidePlace(x, y);
+	x += part.ch->_sprite->_startPoint.x - main.ch->_sprite->_startPoint.x;
+	y += part.ch->_sprite->_startPoint.y - main.ch->_sprite->_startPoint.y;
+	const Common::Rect bbox = member->getBbox();
+	const int left = (int)floorf((bbox.left + x) * kScale + 0.5f) - margin, top = (int)floorf((bbox.top + y) * kScale + 0.5f) - margin;
+	dest = Common::Rect(left, top, left + t->surface.w, top + t->surface.h);
+	debugC(5, kDebugImages, "HDArt::vehicleImage(): %u ms: %s at %.1f,%.1f heading %.2f", g_system->getMillis(), id.asString().c_str(), x, y, glideHeading());
+	return &t->surface;
+}
+
+void HDArt::updateGlide(Channel *car) {
+	const Common::Point loc = car->_sprite->_startPoint;
+	const float heading = _vm->_roads->carHeading();
+	const uint32 now = g_system->getMillis();
+	if (!_glideKnown) {
+		_glideKnown = true;
+		_glideTo = loc;
+		_glideFromX = loc.x;
+		_glideFromY = loc.y;
+		_headFrom = _headTo = heading;
+		_glideStart = _headStart = now;
+		return;
+	}
+	if (loc != _glideTo) {
+		float x, y;
+		glidePlace(x, y);
+		// The time between the game's moves, for the next glide.
+		_glideTime = CLIP<uint32>(now - _glideStart, 40, 160);
+		if (ABS(loc.x - _glideTo.x) + ABS(loc.y - _glideTo.y) > 40) {
+			// A jump (another map, a ferry): no glide.
+			x = loc.x;
+			y = loc.y;
+		}
+		_glideFromX = x;
+		_glideFromY = y;
+		_glideTo = loc;
+		_glideStart = now;
+	}
+	if (heading != _headTo) {
+		_headFrom = glideHeading();
+		_headTo = heading;
+		_headStart = now;
+	}
+}
+
+bool HDArt::gliding() const {
+	const uint32 now = g_system->getMillis();
+	return _glideKnown && (now - _glideStart < _glideTime + 20 || now - _headStart < _glideTime + 20);
+}
+
+void HDArt::glidePlace(float &x, float &y) const {
+	const float t = CLIP((g_system->getMillis() - _glideStart) / (float)_glideTime, 0.0f, 1.0f);
+	x = _glideFromX + (_glideTo.x - _glideFromX) * t;
+	y = _glideFromY + (_glideTo.y - _glideFromY) * t;
+}
+
+float HDArt::glideHeading() const {
+	const float t = CLIP((g_system->getMillis() - _headStart) / (float)_glideTime, 0.0f, 1.0f);
+	float d = _headTo - _headFrom;
+	while (d > 8.0f)
+		d -= 16.0f;
+	while (d <= -8.0f)
+		d += 16.0f;
+	float h = _headFrom + d * t;
+	while (h <= 0.0f)
+		h += 16.0f;
+	while (h > 16.0f)
+		h -= 16.0f;
+	return h;
+}
+
+Common::Rect HDArt::partArea(Channel *ch, Channel *main) const {
+	// The sprite's box where the vehicle is shown, with room for the turned
+	// picture of a neighbouring heading.
+	float x, y;
+	glidePlace(x, y);
+	Common::Rect area = ch->getBbox();
+	area.translate((int)floorf(x - main->_sprite->_startPoint.x + 0.5f), (int)floorf(y - main->_sprite->_startPoint.y + 0.5f));
+	area.grow(16);
+	return area;
+}
+
+Common::Rect HDArt::vehicleArea(const Common::Array<VehiclePart> &parts) const {
+	Common::Rect area;
+	for (auto &p : parts) {
+		const Common::Rect a = partArea(p.ch, parts[0].ch);
+		if (area.isEmpty())
+			area = a;
+		else
+			area.extend(a);
+	}
+	return area;
+}
+
+Graphics::ManagedSurface *HDArt::imageFor(Movie *movie, Channel *channel, bool *whiteBehind) {
+	if (whiteBehind)
+		*whiteBehind = false;
+	Sprite *sprite = channel->_sprite;
+	if (!sprite || !sprite->_cast || sprite->_cast->_type != kCastBitmap)
+		return nullptr;
+	// Only what the classic drawing shows: a channel without a widget draws
+	// nothing there.
+	if (!channel->_widget || !channel->_widget->getSurface())
+		return nullptr;
+	// A sprite recoloured by its foreColor/backColor is drawn the classic way:
+	// only its black and white pixels show, recoloured (Bygger bilar's album
+	// keeps the garage's sprite 119, a picture of the album with a hand, so;
+	// with its HD image the picture showed in the album's corner).
+	if (channel->getPlotData().applyColor)
+		return nullptr;
+	// A picture a script made or changed is not the one the HD set was made
+	// from (Bygg hus paints its dirt, maze and mud at runtime), and a turned
+	// sprite is drawn turned the classic way (D7+ rotation).
+	if (static_cast<BitmapCastMember *>(sprite->_cast)->_scriptImage || sprite->isRotated())
+		return nullptr;
+	int variant;
+	switch (sprite->_ink) {
+	case kInkTypeCopy:
+		variant = kVariantCopy;
+		break;
+	case kInkTypeMatte:
+		variant = kVariantMatte;
+		break;
+	case kInkTypeBackgndTrans:
+		variant = kVariantBgTrans;
+		break;
+	default:
+		return nullptr;
+	}
+	Common::String stem = castStem(movie, sprite->_castId.castLib);
+	if (stem.empty())
+		return nullptr;
+	auto it = _index.find(Common::String::format("%s:%d", stem.c_str(), sprite->_castId.member));
+	if (it == _index.end())
+		return nullptr;
+	const Entry &entry = it->_value;
+	if (!entry.background && !_sprites)
+		return nullptr;
+	// The variants come from the inks in the scores; a sprite the scripts
+	// give another ink at runtime (Mulle's pointer, matte only, shown
+	// background transparent) uses the other transparent one: matte and
+	// background transparent differ only in white enclosed by the drawing.
+	// Copy ink without a copy variant: a transparent one over white is the
+	// same picture (copy shows the image's white; the transparent variants
+	// drop only pure white). Bygger bilar's 82/83 put small sprites with
+	// copy ink at runtime.
+	if (entry.file[variant].empty()) {
+		if (variant == kVariantMatte && !entry.file[kVariantBgTrans].empty()) {
+			variant = kVariantBgTrans;
+		} else if (variant == kVariantBgTrans && !entry.file[kVariantMatte].empty()) {
+			variant = kVariantMatte;
+		} else if (variant == kVariantCopy && (!entry.file[kVariantBgTrans].empty() || !entry.file[kVariantMatte].empty())) {
+			variant = entry.file[kVariantBgTrans].empty() ? kVariantMatte : kVariantBgTrans;
+			if (whiteBehind)
+				*whiteBehind = true;
+		} else {
+			return nullptr;
+		}
+	}
+	// The file is named after the member ("06/0093_06b001v0.matte.png"): a
+	// member whose name is another one's is not the image the HD set was made
+	// from (cast numbering off by one, as once for some internal casts), so
+	// the original is drawn instead, and it is said once.
+	CastMemberInfo *info = sprite->_cast->getInfo();
+	if (info && !info->name.empty()) {
+		const Common::String &file = entry.file[variant];
+		const size_t slash = file.findLastOf('/');
+		const Common::String base = slash == Common::String::npos ? file : file.substr(slash + 1);
+		const Common::String expected = Common::String::format("%04d_%s.", sprite->_castId.member, safeName(info->name).c_str());
+		if (!base.hasPrefixIgnoreCase(expected)) {
+			const Common::String key = it->_key;
+			if (!_mismatches.contains(key)) {
+				_mismatches[key] = true;
+				warning("HDArt: %s member %d is \"%s\", its HD image %s is another one's; drawing the original",
+					stem.c_str(), sprite->_castId.member, info->name.c_str(), file.c_str());
+			}
+			return nullptr;
+		}
+	}
+	return load(entry.file[variant]);
+}
+
+// Why a sprite is drawn the classic way with HD art on, once per movie and
+// member (debug channel images, level 1): what is left to make HD.
+void HDArt::noteClassic(Movie *movie, Channel *ch) {
+	Sprite *sprite = ch->_sprite;
+	if (!sprite || !sprite->_castId.member)
+		return;
+	const Common::String key = Common::String::format("%s/%s", movie->getMacName().c_str(), sprite->_castId.asString().c_str());
+	if (_notedClassic.contains(key))
+		return;
+	_notedClassic[key] = true;
+	Common::String why;
+	CastType type = sprite->_cast ? sprite->_cast->_type : kCastTypeNull;
+	if (ch->hasSubChannels())
+		why = "film loop or movie (sub-channels)";
+	else if (type != kCastBitmap)
+		why = Common::String::format("not a bitmap (%s)", castType2str(type));
+	else if (!ch->_widget || !ch->_widget->getSurface())
+		why = "no widget";
+	else if (ch->getPlotData().applyColor)
+		why = "recoloured (foreColor/backColor)";
+	else if (sprite->_ink != kInkTypeCopy && sprite->_ink != kInkTypeMatte && sprite->_ink != kInkTypeBackgndTrans)
+		why = Common::String::format("ink %d", (int)sprite->_ink);
+	else
+		why = Common::String::format("no HD image for ink %d (none in index.txt, or its file is named for another member)", (int)sprite->_ink);
+	CastMemberInfo *info = sprite->_cast ? sprite->_cast->getInfo() : nullptr;
+	debugC(1, kDebugImages, "HDArt: classic: %s member %s \"%s\" %dx%d: %s", movie->getMacName().c_str(),
+		sprite->_castId.asString().c_str(), info ? info->name.c_str() : "", ch->getBbox().width(), ch->getBbox().height(), why.c_str());
+}
+
+// A member's name as tools/extract_assets.py puts it in file names: runs of
+// characters other than A-Z a-z 0-9 . _ - become "_", no "_" at the ends,
+// "unnamed" for none ("GÅ-1" -> "G_-1").
+Common::String HDArt::safeName(const Common::String &name) {
+	Common::String out;
+	bool run = false;
+	for (uint i = 0; i < name.size(); i++) {
+		const byte b = (byte)name[i];
+		if (b < 128 && (Common::isAlnum(b) || b == '.' || b == '_' || b == '-')) {
+			out += (char)b;
+			run = false;
+		} else if (!run) {
+			out += '_';
+			run = true;
+		}
+	}
+	while (!out.empty() && out.firstChar() == '_')
+		out.deleteChar(0);
+	while (!out.empty() && out.lastChar() == '_')
+		out.deleteLastChar();
+	return out.empty() ? Common::String("unnamed") : out;
+}
+
+// The name of the file a cast library comes from, without extension: "05" for
+// movie 05's own cast, "00" or "CDDATA" for the shared casts.
+Common::String HDArt::castStem(Movie *movie, int castLib) {
+	// The cache is for one movie. Its address alone does not say which: the
+	// next movie can be allocated where the last one was (Bygger bilar, the
+	// driving map 05 -> the car show 94), and 94's own cast was then taken
+	// for 05's: the announcer's frames 32-42 showed the fuel gauge's needle
+	// (05's members 32-42).
+	const Common::Path path = movie->getArchive() ? movie->getArchive()->getPathName() : Common::Path();
+	if (movie != _stemMovie || path != _stemMoviePath) {
+		if (movie == _stemMovie)
+			debugC(1, kDebugImages, "HDArt::castStem(): a new movie where the last one was: %s -> %s", _stemMoviePath.toString().c_str(), path.toString().c_str());
+		_stems.clear();
+		_stemMovie = movie;
+		_stemMoviePath = path;
+	}
+	auto it = _stems.find(castLib);
+	if (it != _stems.end())
+		return it->_value;
+
+	Common::String stem;
+	Cast *cast = movie->getCasts()->getValOrDefault(castLib, nullptr);
+	if (cast && cast->getArchive()) {
+		stem = cast->getArchive()->getFileName();
+		size_t dot = stem.findLastOf('.');
+		if (dot != Common::String::npos)
+			stem = stem.substr(0, dot);
+		stem.toUppercase();
+	}
+	_stems[castLib] = stem;
+	debugC(2, kDebugImages, "HDArt::castStem(): %s cast library %d is %s", movie->getMacName().c_str(), castLib, stem.c_str());
+	return stem;
+}
+
+Graphics::ManagedSurface *HDArt::load(const Common::String &file) {
+	auto it = _images.find(file);
+	if (it != _images.end()) {
+		it->_value.lastUse = ++_useCounter;
+		return it->_value.surface;
+	}
+
+	uint32 start = g_system->getMillis();
+	Image image;
+	Common::FSNode node = _dir;
+	Common::StringTokenizer parts(file, "/");
+	while (!parts.empty())
+		node = node.getChild(parts.nextToken());
+	Common::SeekableReadStream *stream = node.createReadStream();
+	if (stream) {
+		::Image::PNGDecoder png;
+		if (png.loadStream(*stream)) {
+			const Graphics::Palette &pal = png.getPalette();
+			Graphics::Surface *converted = png.getSurface()->convertTo(_format, pal.data(), pal.size());
+			image.surface = new Graphics::ManagedSurface();
+			image.surface->copyFrom(*converted);
+			image.bytes = converted->pitch * converted->h;
+			converted->free();
+			delete converted;
+		} else {
+			warning("HDArt: cannot decode %s", file.c_str());
+		}
+		delete stream;
+	} else {
+		warning("HDArt: cannot open %s", file.c_str());
+	}
+	// Failures are remembered too, so they are not retried every frame.
+	image.lastUse = ++_useCounter;
+	_images[file] = image;
+	_cacheBytes += image.bytes;
+	debugC(2, kDebugImages, "HDArt::load(): %s in %d ms, cache %u MB", file.c_str(), g_system->getMillis() - start, _cacheBytes >> 20);
+	evict();
+	return image.surface;
+}
+
+// Drops the least recently used images while the cache is over its limit,
+// never the one just loaded.
+void HDArt::evict() {
+	while (_cacheBytes > _cacheLimit) {
+		Common::String oldest;
+		uint32 oldestUse = _useCounter;
+		for (auto &it : _images) {
+			if (it._value.surface && it._value.lastUse < oldestUse) {
+				oldest = it._key;
+				oldestUse = it._value.lastUse;
+			}
+		}
+		if (oldest.empty())
+			break;
+		Image &image = _images[oldest];
+		_cacheBytes -= image.bytes;
+		delete image.surface;
+		_images.erase(oldest);
+	}
+}
+
+} // End of namespace Director
