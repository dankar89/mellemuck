+void setMemberImage(CastMemberID id, ImageObject *img) {
+	BitmapCastMember *m = bitmapMember(id);
+	Graphics::Surface *s = img->surface();
+	if (!m || !s) {
+		warning("setMemberImage(): %s is not a bitmap", id.asString().c_str());
+		return;
+	}
+	int depth = img->depth();
+	const byte *pal = img->palette();
+	int palCount = img->paletteCount();
+	// Copy first: the image may be the member's own (member.image = member.image).
+	Graphics::Surface copy;
+	copy.copyFrom(*s);
+	byte palCopy[256 * 3];
+	if (pal && palCount)
+		memcpy(palCopy, pal, palCount * 3);
+
+	bool sameSize = m->_picture && m->_picture->_surface.w == copy.w && m->_picture->_surface.h == copy.h;
+	if (!m->_picture)
+		m->_picture = new Picture();
+	m->_picture->_surface.free();
+	m->_picture->_surface = copy;	// takes the pixels
+	m->_picture->_paletteColors = (pal && palCount) ? palCount : 0;
+	if (pal && palCount)
+		memcpy(m->_picture->_palette, palCopy, palCount * 3);
+	m->_bitsPerPixel = depth;
+	if (!sameSize) {
+		m->_initialRect = Common::Rect(copy.w, copy.h);
+		m->_regX = (copy.w + 1) / 2;
+		m->_regY = (copy.h + 1) / 2;
+		Movie *movie = g_director->getCurrentMovie();
+		Score *score = movie ? movie->getScore() : nullptr;
+		if (score) {
+			for (uint i = 0; i < score->_channels.size(); i++) {
+				Channel *ch = score->_channels[i];
+				if (ch && ch->_sprite && ch->_sprite->_cast == m && !ch->_sprite->_stretch) {
+					ch->_sprite->_width = copy.w;
+					ch->_sprite->_height = copy.h;
+				}
+			}
+		}
+	}
+	bitmapChanged(m);
+}
+
+// A picture a script made or changed, for the saved cast (Cast::saveTextMembers()):
+// w, h (BE16), bytes per pixel, member depth, the pixel format (losses, shifts),
+// regX, regY (BE16), palette count (BE16) and colours, then the rows.
+bool serializeBitmapMember(BitmapCastMember *m, Common::Array<byte> &out) {
+	if (!m || !m->_picture)
+		return false;
+	const Graphics::Surface &s = m->_picture->_surface;
+	if (!s.getPixels() || s.w <= 0 || s.h <= 0)
+		return false;
+	const Graphics::PixelFormat &f = s.format;
+	auto u16 = [&](int v) { out.push_back((v >> 8) & 255); out.push_back(v & 255); };
+	u16(s.w);
+	u16(s.h);
+	out.push_back(f.bytesPerPixel);
+	out.push_back(m->_bitsPerPixel);
+	const byte fmt[8] = { f.rLoss, f.gLoss, f.bLoss, f.aLoss, f.rShift, f.gShift, f.bShift, f.aShift };
+	for (byte b : fmt)
+		out.push_back(b);
+	u16(m->_regX);
+	u16(m->_regY);
+	int palCount = m->_picture->_paletteColors;
+	u16(palCount);
+	for (int i = 0; i < palCount * 3; i++)
+		out.push_back(m->_picture->_palette[i]);
+	for (int y = 0; y < s.h; y++) {
+		const byte *row = (const byte *)s.getBasePtr(0, y);
+		out.insert_at(out.size(), Common::Array<byte>(row, s.w * f.bytesPerPixel));
+	}
+	return true;
+}
