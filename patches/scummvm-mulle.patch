+static void flipSurface(Graphics::Surface *s, bool h, bool v) {
+	int bpp = s->format.bytesPerPixel;
+	byte tmp[4];
+	if (h) {
+		for (int y = 0; y < s->h; y++) {
+			byte *row = (byte *)s->getBasePtr(0, y);
+			for (int x = 0; x < s->w / 2; x++) {
+				byte *a = row + x * bpp, *b = row + (s->w - 1 - x) * bpp;
+				memcpy(tmp, a, bpp);
+				memcpy(a, b, bpp);
+				memcpy(b, tmp, bpp);
+			}
+		}
+	}
+	if (v) {
+		Common::Array<byte> line(s->pitch);
+		for (int y = 0; y < s->h / 2; y++) {
+			byte *a = (byte *)s->getBasePtr(0, y), *b = (byte *)s->getBasePtr(0, s->h - 1 - y);
+			memcpy(line.data(), a, s->pitch);
+			memcpy(a, b, s->pitch);
+			memcpy(b, line.data(), s->pitch);
+		}
+	}
+}
