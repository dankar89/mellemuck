+	if (!forceUpdate && _cursorSpriteShown == channelId && key == _cursorSpriteKey)
+		return;
+
+	// Draw the sprite with its ink onto two different backgrounds: the pixels
+	// that come out the same in both belong to the pointer, the rest is
+	// transparent. This keeps matte and background-transparent edges exactly
+	// as on the stage.
+	Channel *channel = _channels[channelId];
+	const Graphics::PixelFormat &format = _vm->_wm->_pixelformat;
+	const int w = MAX<int>(key.width, 1);
+	const int h = MAX<int>(key.height, 1);
+	const uint32 backgrounds[2] = { 0, format.isCLUT8() ? 0xffu : format.RGBToColor(0xff, 0xff, 0xff) };
+	Graphics::ManagedSurface drawn[2];
+	DirectorPlotData pd = channel->getPlotData();
+	const Graphics::Surface *mask = channel->getMask();
+	for (int i = 0; i < 2; i++) {
+		drawn[i].create(w, h, format);
+		drawn[i].clear(backgrounds[i]);
+		Common::Rect srcRect(w, h);
+		pd.dst = &drawn[i];
+		pd.destRect = srcRect;
+		pd.inkBlitSurface(srcRect, mask);
+	}
+
+	// Mark the transparent pixels with a colour the pointer does not use.
+	Common::HashMap<uint32, bool> used;
+	for (int y = 0; y < h; y++)
+		for (int x = 0; x < w; x++)
+			if (drawn[0].getPixel(x, y) == drawn[1].getPixel(x, y))
+				used[drawn[0].getPixel(x, y)] = true;
+	uint32 keyColor = 0;
+	for (int n = 0; n < 256; n++) {
+		keyColor = format.isCLUT8() ? 0xff - n : format.RGBToColor(0xff, 0x00, 0xff - n);
+		if (!used.contains(keyColor))
+			break;
+	}
+	for (int y = 0; y < h; y++)
+		for (int x = 0; x < w; x++)
+			if (drawn[0].getPixel(x, y) != drawn[1].getPixel(x, y))
+				drawn[0].setPixel(x, y, keyColor);
+
+	// Cursors need their hotspot inside the image.
+	const int hotX = CLIP<int>(key.hotspot.x, 0, w - 1);
+	const int hotY = CLIP<int>(key.hotspot.y, 0, h - 1);
