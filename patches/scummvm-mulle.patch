+void GameMenu::addItem(ItemId id, const Common::Rect &box, const char *label, bool enabled, int slot) {
+	Item item;
+	item.id = id;
+	item.box = box;
+	item.label = Common::U32String(label);
+	item.enabled = enabled;
+	item.slot = slot;
+	_items.push_back(item);
+}
+
+// Focuses an item of the page showing, if it is there and can be chosen.
+void GameMenu::focusItem(ItemId id, int slot) {
+	for (uint i = 0; i < _items.size(); i++) {
+		if (_items[i].id == id && _items[i].slot == slot && _items[i].enabled) {
+			_focus = i;
+			_dirty = true;
+			return;
+		}
+	}
+}
