+// Save games for Director titles that keep their progress as text in a cast,
+// such as the Mulle Meck / Gary Gadget games. A game quirk fills in
+// DirectorEngine::SaveSupport with the cast and the Lingo to sync, identify and
+// restart the game; the ScummVM save file then holds the cast's text members.
+
+#include "common/config-manager.h"
+#include "common/memstream.h"
+#include "common/ptr.h"
+#include "common/savefile.h"
+#include "common/system.h"
+#include "common/translation.h"
+#include "engines/metaengine.h"
+
+#include "director/director.h"
+#include "director/cast.h"
+#include "director/castmember/castmember.h"
+#include "director/movie.h"
+#include "director/window.h"
+#include "director/lingo/lingo.h"
+#include "director/lingo/lingo-code.h"
+#include "director/lingo/lingo-codegen.h"
+#include "director/lingo/lingo-object.h"
+#include "director/lingo/lingo-the.h"
+#include "director/lingo/xtras-cast/vlistxtra.h"
+
+namespace Director {
+
+static const char *const kProgressMagic = "DIRECTOR-PROGRESS 1";
+
+// Saving and loading belong to the stage's movie, whichever window is current.
+// Event polling in the main loop runs with the last window stepped as the
+// current one: with Bygger bilar's file dialog (a movie in a window) open, a
+// load's restart (go to the garage) went to the dialog, which stopped its
+// movie and crashed (2026-10-14), and saving looked for the progress cast in
+// the dialog's movie.
+class StageScope {
+public:
+	StageScope() : _prev(g_director->getCurrentWindow()) {
+		_prev->incRefCount();
+		g_director->setCurrentWindow(g_director->getStage());
+		g_lingo->switchStateFromWindow();
+	}
+	~StageScope() {
+		g_director->setCurrentWindow(_prev);
+		g_lingo->switchStateFromWindow();
+		_prev->decRefCount();
+	}
+private:
+	Window *_prev;
+};
+
+Datum DirectorEngine::runLingoSnippet(const Common::String &code) {
+	StageScope stage;
+	// Compiled each time: anonymous scripts are reference counted and freed once
+	// the call finishes.
+	ScriptContext *script = g_lingo->_compiler->compileAnonymous(code);
+	if (!script) {
+		warning("DirectorEngine::runLingoSnippet(): could not compile:\n%s", code.c_str());
+		return Datum();
+	}
+	uint stackSize = g_lingo->_state->stack.size();
+	LC::call(script->_eventHandlers[kEventGeneric], 0, true);
+	g_lingo->execute();
+	return g_lingo->_state->stack.size() > stackSize ? g_lingo->pop() : Datum();
+}
+
+Common::String DirectorEngine::currentPlayerName() {
+	if (!hasSaveSupport())
+		return Common::String();
+	Datum user = runLingoSnippet(_saveSupport.userLingo);
+	return user.type == STRING ? user.asString() : Common::String();
+}
+
+Cast *DirectorEngine::saveSupportCast() {
+	Movie *movie = getStage() ? getStage()->getCurrentMovie() : nullptr;
+	if (!movie || !hasSaveSupport())
+		return nullptr;
+	int lib = movie->getCastLibIDByName(_saveSupport.castName);
+	return movie->getCasts()->contains(lib) ? movie->getCasts()->getVal(lib) : nullptr;
+}
+
+// Saving and loading run the game's Lingo, so only between scripts.
+bool DirectorEngine::canSaveGameStateCurrently(Common::U32String *msg) {
+	if (!getStage())
+		return false;
+	StageScope stage;
+	if (!hasSaveSupport())
+		return false;
+	if (!g_lingo->_state->callstack.empty() || !saveSupportCast()) {
+		if (msg)
+			*msg = _("The game cannot be saved right now; please try again in a moment.");
+		return false;
+	}
+	return true;
+}
+
+bool DirectorEngine::canLoadGameStateCurrently(Common::U32String *msg) {
+	if (!getStage())
+		return false;
+	StageScope stage;
+	if (!hasSaveSupport())
+		return false;
+	if (!g_lingo->_state->callstack.empty() || !saveSupportCast()) {
+		if (msg)
+			*msg = _("A saved game cannot be loaded right now; please try again in a moment.");
+		return false;
+	}
+	return true;
+}
+
+// ScummVM's own autosave timer runs from event polling, which also happens while
+// scripts execute; when it cannot save it backs off for minutes. runAutosave()
+// saves at a safe point in the main loop instead.
+bool DirectorEngine::canSaveAutosaveCurrently() {
+	return false;
+}
+
+// When to autosave (user, 2026-10-14): when the player has come to another
+// scene (movie), once it shows (kSceneAutosaveDelay), and in a long scene
+// (building the car) every autosave_period as a safety net, but not while a
+// part is held. writeAutosave() skips it when the game has not changed.
+void DirectorEngine::runAutosave() {
+	if (!hasSaveSupport())
+		return;
+	int period = ConfMan.getInt("autosave_period");	// seconds, 0 = off
+	if (period <= 0)
+		return;
+	uint32 now = g_system->getMillis();
+	if (_lastAutosave == 0)
+		_lastAutosave = now;
+	Movie *movie = getStage()->getCurrentMovie();
+	const Common::String scene = movie ? movie->getMacName() : Common::String();
+	if (scene != _autosaveScene) {
+		_autosaveScene = scene;
+		_sceneSince = now;
+		_sceneAutosave = true;
+	}
+	const bool sceneDue = _sceneAutosave && now - _sceneSince >= kSceneAutosaveDelay;
+	if (!sceneDue && now - _lastAutosave < (uint32)period * 1000)
+		return;
+	// A script frozen by go() waiting for the next frame is normal here; only a
+	// script that is actually executing blocks the save.
+	if (_leftButtonDown || !canSaveGameStateCurrently())
+		return;
+	_lastAutosave = now;
+	_sceneAutosave = false;
+	Common::Error status = writeAutosave(sceneDue ? "new scene" : "timer");
+	if (status.getCode() != Common::kNoError)
+		warning("DirectorEngine::runAutosave(): %s", status.getDesc().c_str());
+}
+
+// Leaving a scene (Window::step(), before the movie stops): the player's
+// progress there is complete, and loading the next scene is where crashes
+// have been most likely (user, 2026-10-14: "what if the game crashes when
+// entering/exiting a scene?"). The save on entering the next scene then
+// usually finds nothing changed.
+void DirectorEngine::autosaveLeavingScene() {
+	if (!hasSaveSupport() || ConfMan.getInt("autosave_period") <= 0)
+		return;
+	if (_leftButtonDown || !canSaveGameStateCurrently())
+		return;
+	_lastAutosave = g_system->getMillis();
+	Common::Error status = writeAutosave("leaving the scene");
+	if (status.getCode() != Common::kNoError)
+		warning("DirectorEngine::autosaveLeavingScene(): %s", status.getDesc().c_str());
+}
+
+// The game data in a save file, without ScummVM's part at the end (name,
+// date, thumbnail); false for an empty slot.
+static bool readSaveData(Common::SaveFileManager *saveFileMan, const Common::String &file, Common::Array<byte> &data) {
+	Common::ScopedPtr<Common::InSaveFile> in(saveFileMan->openForLoading(file));
+	if (!in || in->size() < 4)
+		return false;
+	in->seek(-4, SEEK_END);
+	const uint32 headerOffset = in->readUint32LE();
+	if (headerOffset == 0 || headerOffset >= (uint32)in->size())
+		return false;
+	data.resize(headerOffset);
+	in->seek(0);
+	return in->read(data.data(), headerOffset) == headerOffset;
+}
+
+static bool sameData(const Common::Array<byte> &a, const byte *b, uint32 size) {
+	return a.size() == size && (size == 0 || !memcmp(a.data(), b, size));
+}
+
+// Autosaves only when the game's progress changed since the last autosave
+// (user, 2026-10-14: a game left running must not push the older autosaves
+// out with copies of the same moment). The game's own save routine still runs
+// every time, as it did.
+Common::Error DirectorEngine::writeAutosave(const char *why) {
+	// Before a player is logged in there is no progress to keep (a load would
+	// only open the player selection).
+	const Common::String player = currentPlayerName();
+	if (player.empty())
+		return Common::kNoError;
+	const int base = playerSlotBase(player, true);
+	if (base < 0) {
+		logPlayNote("autosave", Common::String::format("%s: no free save slots for %s", why, player.c_str()));
+		return Common::kNoError;
+	}
+	Common::MemoryWriteStreamDynamic data(DisposeAfterUse::YES);
+	Common::Error result = saveGameStream(&data, true);
+	if (result.getCode() != Common::kNoError)
+		return result;
+	Common::SaveFileManager *saveFileMan = getSaveFileManager();
+	const Common::String file = getSaveStateName(base);
+	Common::Array<byte> last;
+	if (readSaveData(saveFileMan, file, last) && sameData(last, data.getData(), data.size())) {
+		logPlayNote("autosave", Common::String::format("%s: unchanged", why));
+		return Common::kNoError;
+	}
+
+	const int older = keepOlderAutosave(base);
+	Common::ScopedPtr<Common::OutSaveFile> out(saveFileMan->openForSaving(file));
+	if (!out)
+		return Common::kWritingFailed;
+	out->write(data.getData(), data.size());
+	getMetaEngine()->appendExtendedSave(out.get(), getTotalPlayTime(), player, true);
+	out->finalize();
+	if (out->err())
+		return Common::kWritingFailed;
+	logPlayNote("autosave", older < 0 ? Common::String::format("%s: saved", why)
+		: Common::String::format("%s: saved, the last one kept in slot %d", why, older));
+	return Common::kNoError;
+}
+
+// A save slot's time in minutes (a running count, for comparing), or -1 when
+// the slot is empty and -2 when it holds a game the player saved.
+static int autosaveMinutes(Common::SaveFileManager *saveFileMan, const Common::String &file) {
+	Common::ScopedPtr<Common::InSaveFile> in(saveFileMan->openForLoading(file));
+	if (!in)
+		return -1;
+	ExtendedSavegameHeader header;
+	if (!MetaEngine::readSavegameHeader(in.get(), &header) || !header.isAutosave)
+		return -2;
+	uint16 year;
+	uint8 month, day, hour, minute;
+	MetaEngine::decodeSavegameDate(&header, year, month, day);
+	MetaEngine::decodeSavegameTime(&header, hour, minute);
+	// Days since a fixed point, counting across month and year ends.
+	int y = year, m = month;
+	if (m < 3) {
+		y--;
+		m += 12;
+	}
+	const int days = 365 * y + y / 4 - y / 100 + y / 400 + (153 * (m - 3) + 2) / 5 + day;
+	return (days * 24 + hour) * 60 + minute;
+}
+
+// The player's first slot has the latest autosave (see writeAutosave()). To
+// let the player go back further (the pause menu's "Tidigare"), before it is
+// overwritten it is copied into the older of the next two when the newer of them is
+// kOlderAutosaveMinutes older than it, unless one of them holds the same game
+// already (after loading it). So the previous session's last autosave is kept
+// too. Those two are only overwritten when empty or autosaves (ScummVM's own
+// save dialog could put the player's games there before saves were per
+// player).
+int DirectorEngine::keepOlderAutosave(int latestSlot) {
+	Common::SaveFileManager *saveFileMan = getSaveFileManager();
+	const int latest = autosaveMinutes(saveFileMan, getSaveStateName(latestSlot));
+	Common::Array<byte> latestData;
+	if (latest < 0 || !readSaveData(saveFileMan, getSaveStateName(latestSlot), latestData))
+		return -1;
+	int target = -1, targetMinutes = 0, newest = -1;
+	for (int slot = latestSlot + 1; slot <= latestSlot + kOlderAutosaves; slot++) {
+		const int minutes = autosaveMinutes(saveFileMan, getSaveStateName(slot));
+		if (minutes == -2)
+			continue;
+		Common::Array<byte> data;
+		if (minutes >= 0 && readSaveData(saveFileMan, getSaveStateName(slot), data) && sameData(data, latestData.data(), latestData.size()))
+			return -1;
+		newest = MAX(newest, minutes);
+		if (target == -1 || minutes < targetMinutes) {
+			target = slot;
+			targetMinutes = minutes;
+		}
+	}
+	if (target == -1 || (newest >= 0 && latest - newest < kOlderAutosaveMinutes))
+		return -1;
+	if (!saveFileMan->copySavefile(getSaveStateName(latestSlot), getSaveStateName(target))) {
+		warning("DirectorEngine::keepOlderAutosave(): could not copy slot %d to %d", latestSlot, target);
+		return -1;
+	}
+	return target;
+}
+
+// Per-player saves (user, 2026-10-14, the Mulle Meck games): each player has
+// kPlayerSlots slots, +0 the latest autosave, +1 and +2 older autosaves, +3 to
+// +8 their own saves. A save holds only the player's own member of the
+// progress cast (SaveSupport::playerMember), and loading it puts back only
+// that, so the other players keep their progress. A block of slots belongs to
+// the player in the save data of its first save; a player without saves gets
+// the first empty block when they first save.
+static Common::String playerMemberName(const Common::String &pattern, const Common::String &player) {
+	Common::String name = pattern;
+	for (size_t pos = name.find("{user}"); pos != Common::String::npos; pos = name.find("{user}")) {
+		name.erase(pos, 6);
+		name.insertString(player, pos);
+	}
+	return name;
+}
+
+bool DirectorEngine::readSaveOwner(int slot, Common::String &owner) {
+	Common::ScopedPtr<Common::InSaveFile> in(getSaveFileManager()->openForLoading(getSaveStateName(slot)));
+	if (!in)
+		return false;
+	owner.clear();
+	uint userLen;
+	if (in->readLine() == kProgressMagic && sscanf(in->readLine().c_str(), "user %u", &userLen) == 1)
+		owner = in->readString(0, userLen);
+	return true;
+}
+
+int DirectorEngine::playerSlotBase(const Common::String &player, bool claim) {
+	if (_saveSupport.playerMember.empty())
+		return 0;	// one set of slots for everyone
+	if (player.empty())
+		return -1;
+	const int blocks = (getMetaEngine()->getMaximumSaveSlot() + 1) / kPlayerSlots;
+	Common::Array<int> first;
+	for (int b = 0; b < blocks; b++)
+		first.push_back(-1);
+	Common::StringArray files = getSaveFileManager()->listSavefiles(getMetaEngine()->getSavegameFilePattern(_targetName.c_str()));
+	for (auto &file : files) {
+		if (file.size() < 3)
+			continue;
+		const int slot = atoi(file.c_str() + file.size() - 3);
+		const int b = slot / kPlayerSlots;
+		if (slot >= 0 && b < blocks && (first[b] < 0 || slot < first[b]))
+			first[b] = slot;
+	}
+	int empty = -1;
+	for (int b = 0; b < blocks; b++) {
+		Common::String owner;
+		if (first[b] < 0) {
+			if (empty < 0)
+				empty = b;
+		} else if (readSaveOwner(first[b], owner) && owner.equalsIgnoreCase(player)) {
+			return b * kPlayerSlots;
+		}
+	}
+	return claim && empty >= 0 ? empty * kPlayerSlots : -1;
+}
+
+Common::Error DirectorEngine::saveGameStream(Common::WriteStream *stream, bool isAutosave) {
+	StageScope stage;
+	Cast *cast = saveSupportCast();
+	if (!cast)
+		return Common::kWritingFailed;
+	// Let the game write its in-memory state into the cast (this is also the
+	// game's own save, kept in the save folder by "save castLib").
+	runLingoSnippet(_saveSupport.syncLingo);
+	Common::String user = currentPlayerName();
+
+	stream->writeString(Common::String(kProgressMagic) + "\n");
+	stream->writeString(Common::String::format("user %u\n", user.size()));
+	stream->writeString(user + "\n");
+	bool ok;
+	if (!_saveSupport.playerMember.empty() && !user.empty()) {
+		const Common::String member = playerMemberName(_saveSupport.playerMember, user);
+		ok = cast->saveTextMembers(*stream, &member);
+	} else {
+		ok = cast->saveTextMembers(*stream);
+	}
+	return ok ? Common::kNoError : Common::kWritingFailed;
+}
+
+Common::Error DirectorEngine::loadGameStream(Common::SeekableReadStream *stream) {
+	StageScope stage;
+	Cast *cast = saveSupportCast();
+	if (!cast)
+		return Common::kReadingFailed;
+	if (stream->readLine() != kProgressMagic)
+		return Common::Error(Common::kReadingFailed, "not a Director progress save");
+	uint userLen;
+	if (sscanf(stream->readLine().c_str(), "user %u", &userLen) != 1)
+		return Common::kReadingFailed;
+	Common::String user = stream->readString(0, userLen);
+	stream->readByte();
+	if (!_saveSupport.playerMember.empty() && !user.empty()) {
+		// Only the player's own member. (Saves from before per-player saves hold
+		// every member; the others are left alone too.)
+		const Common::String name = playerMemberName(_saveSupport.playerMember, user);
+		Common::String text;
+		bool isVList = false;
+		if (!Cast::readTextMember(*stream, name, text, &isVList))
+			return Common::Error(Common::kReadingFailed, "no " + name + " in the saved game");
+		// Whoever plays now keeps their progress (the game writes it into the cast).
+		runLingoSnippet(_saveSupport.syncLingo);
+		if (isVList) {
+			// Bygg hus keeps each player in a vList member.
+			Datum content;
+			VListCastMember *member = dynamic_cast<VListCastMember *>(cast->getCastMemberByNameAndType(name, kCastXtra));
+			if (!member)
+				return Common::Error(Common::kReadingFailed, "no player " + user + " in the game");
+			if (!VListXtra::parse(text, content))
+				return Common::Error(Common::kReadingFailed, name + " in the saved game does not parse");
+			member->setContent(content);
+		} else {
+			CastMember *member = cast->getCastMemberByNameAndType(name, kCastText);
+			if (!member)
+				return Common::Error(Common::kReadingFailed, "no player " + user + " in the game");
+			member->setField(kTheText, Datum(text));
+		}
+	} else if (!cast->applyTextMembers(*stream, "saved game")) {
+		return Common::kReadingFailed;
+	}
+	// A restart continues from the loaded game.
+	cast->writeSavedTextMembers();
+
+	// Lingo string literals cannot contain quotes; splice them in with QUOTE.
+	Common::String userLiteral = "\"";
+	for (char c : user)
+		userLiteral += (c == '"') ? Common::String("\" & QUOTE & \"") : Common::String(c);
+	userLiteral += "\"";
+	Common::String code = _saveSupport.loadLingo;
+	for (size_t pos = code.find("{user}"); pos != Common::String::npos; pos = code.find("{user}")) {
+		code.erase(pos, 6);
+		code.insertString(userLiteral, pos);
+	}
+	// The restart goes to a movie, often the one playing (the garage). ScummVM
+	// then only jumps to the frame, but stopMovie has run and the game's
+	// prepareMovie and startMovie set the scene up again (its Dir object): load
+	// it properly.
+	getStage()->_reloadSameMovie = true;
+	runLingoSnippet(code);
+	return Common::kNoError;
+}
+
+} // End of namespace Director
