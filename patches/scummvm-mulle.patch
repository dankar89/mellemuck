+#ifndef DIRECTOR_ROADS_H
+#define DIRECTOR_ROADS_H
+
+#include "common/array.h"
+#include "common/hashmap.h"
+#include "common/rect.h"
+
+namespace Graphics {
+class ManagedSurface;
+}
+
+namespace Director {
+
+class AbstractObject;
+class DirectorEngine;
+
+/**
+ * Road driving (Mulle Meck remaster; user, 2026-10-14: "what if we made a road
+ * network, where we could like click on the road and mulle drove there
+ * following the road? ... Just move the cursor or stick in the direction you
+ * wanna go, and mulle moves there, along the roads").
+ *
+ * Bygger bilar's driving maps each have a terrain grid (two text members,
+ * 316 x 198 cells of 2 x 2 pixels from (4, 4); a byte under 240 is drivable),
+ * and the drivable cells are exactly the painted roads. RoadGraph thins them
+ * to centre lines and traces those into a graph: nodes at junctions and ends,
+ * edges along the roads (tools/roads.py draws the same graph over the maps).
+ *
+ * RoadDriver drives the car along that graph the way a player would: it holds
+ * the game's own keys (Left/Right to turn, Up for gas, Down to brake) through
+ * DirectorEngine::updateDrivePad(), so the game's speeds, fuel, terrain,
+ * crashes, map changes and destinations stay as they were.
+ * - A direction (the left stick; the mouse held on the map, towards the
+ *   pointer): the car follows the road that way, and at a junction takes the
+ *   branch nearest the direction. A alone drives on the way the car points.
+ * - A click on the map: the car drives there along the roads, the shortest
+ *   way, and stops.
+ * F7 shows the graph, the car's plan and its aim over the map (HD only).
+ * scummvm.ini: road_driving (default true).
+ */
+class RoadGraph {
+public:
+	static const int kW = 316, kH = 198;	// cells
+
+	struct Pt {
+		float x = 0.0f, y = 0.0f;
+		Pt() {}
+		Pt(float x_, float y_) : x(x_), y(y_) {}
+	};
+	struct Edge {
+		int a = 0, b = 0;					// nodes; the path runs from a to b
+		Common::Array<Pt> path;			// stage pixels
+		Common::Array<float> along;		// distance from a at each point
+		float length() const { return along.empty() ? 0.0f : along.back(); }
+	};
+	// A place on the graph: an edge and the distance along it from its a.
+	struct Spot {
+		int edge = -1;
+		float s = 0.0f;
+		float dist = 0.0f;	// from the point it was found for
+		bool valid() const { return edge >= 0; }
+	};
+
+	// Builds the graph from a terrain grid of kW * kH bytes.
+	void build(const byte *terrain);
+	bool empty() const { return edges.empty(); }
+
+	Common::Array<Pt> nodes;	// stage pixels
+	Common::Array<Edge> edges;
+
+	int degree(int node) const;
+	// An end at the map's edge: the road goes on in the next map.
+	bool isExit(int node) const;
+	Spot nearest(float x, float y, int onlyEdge = -1) const;
+	Pt pointAt(int edge, float s) const;
+	// The road's direction at s (unit vector, from a towards b).
+	Pt tangentAt(int edge, float s) const;
+	// The way out of a node along an edge: a unit vector from the node to a
+	// point some distance along it.
+	Pt leaving(int node, int edge, bool forward) const;
+	// Terrain byte of the cell under a stage pixel (240 outside).
+	byte terrainAt(float x, float y) const;
+
+	static Pt cellCentre(int cx, int cy) { return Pt(5.0f + 2.0f * cx, 5.0f + 2.0f * cy); }
+
+private:
+	Common::Array<byte> _terrain;
+};
+
+class RoadDriver {
+public:
+	RoadDriver(DirectorEngine *vm);
+	~RoadDriver();
+
+	bool enabled() const { return _enabled; }
+
+	// What the driver wants this moment. heading in sixteenths of a turn (the
+	// game's directions: 16 up, 4 right), valid while steer is set.
+	struct Command {
+		bool steer = false;
+		float heading = 0.0f;
+		bool gas = false;
+		bool brake = false;
+	};
+	// Called with the game's CarDriving object while the map is driven. stick:
+	// the left stick (x, y in -1..1; 0, 0 when let go); go: A held. False when
+	// the driver has nothing to do (the player drives).
+	bool update(AbstractObject *car, float stickX, float stickY, bool go, Command &cmd);
+	// The map is not driven any more (a destination, the garage).
+	void stopDriving();
+	// B: stop and forget the way.
+	void cancel();
+	// Mouse presses on the map while driving; true when taken (not for the game).
+	bool mouseDown(const Common::Point &pos, bool driving);
+	bool mouseUp(const Common::Point &pos);
+	bool mouseHeld() const { return _mouseHeld; }
+	// The player used the keyboard's arrows: they drive.
+	void playerKey();
+
+	// The car's heading for its picture, in sixteenths (0..16, fractions too):
+	// the way it went over the last few frames, or where it points while it
+	// stands; -1 when it is not driven. HD turns the car's picture so
+	// (hd.cpp carImage()): the game has 16 pictures, and on a winding road the
+	// car switches between two of them all the time.
+	float carHeading() const { return _carHeading; }
+	// Called each poll while the map is driven (with road driving off too).
+	void watchCar(AbstractObject *car);
+
+	void toggleDebug() { _debug = !_debug; }
+	bool debugShown() const { return _debug && _graph; }
+	// Draws the graph, the plan and the aim (screen at scale x the stage).
+	void drawDebug(Graphics::ManagedSurface &screen, int scale, const Common::Rect &clip);
+	// The map's area on the stage (what the debug view redraws).
+	static Common::Rect mapRect() { return Common::Rect(4, 4, 636, 400); }
+
+private:
+	struct Step {
+		int edge;
+		bool forward;	// a -> b
+	};
+
+	RoadGraph *graphFor(AbstractObject *car);
+	bool locate(float x, float y, RoadGraph::Spot &spot);
+	// The way on along the plan from the car: a point dist ahead (or the end),
+	// and how far the plan goes before it ends (a dead end or the clicked spot).
+	RoadGraph::Pt aimAhead(float dist, float &toEnd, bool &offMap);
+	// Extends the plan past its last node, choosing the edge nearest dir.
+	bool extendPlan(const RoadGraph::Pt &dir);
+	bool route(const RoadGraph::Spot &from, const RoadGraph::Spot &to);
+	// Where a click at pos sends the car: off the map near an edge, the
+	// place clicked on a road, a destination near it, else the nearest road.
+	RoadGraph::Spot clickTarget(const Common::Point &pos, bool &offMap, const char *&why);
+	bool placeNear(const Common::Point &pos, RoadGraph::Pt &place);
+	void reset();
+	void stop();	// brake to a halt, then idle
+
+	DirectorEngine *_vm;
+	bool _enabled = true;
+	bool _debug = false;
+
+	Common::HashMap<uint32, RoadGraph *> _graphs;	// by the terrain's hash
+	RoadGraph *_graph = nullptr;
+	const void *_terrainId = nullptr;	// the Lingo string the graph was made from
+
+	// The car on the graph and what it does.
+	// kStopping: let go; braking until the car stands (releasing the gas
+	// alone keeps the speed in this game).
+	enum Mode { kIdle, kDirection, kRoute, kStopping };
+	Mode _mode = kIdle;
+	RoadGraph::Spot _at;
+	Common::Array<Step> _plan;	// from the car's edge on
+	float _endS = -1.0f;		// route: stop at this distance along the last step's edge (as the edge runs, a -> b)
+	RoadGraph::Pt _dir;			// direction input (unit)
+	RoadGraph::Pt _choiceDir;	// the input when the way along the car's road was chosen
+	RoadGraph::Pt _aim;			// where it steers to now (debug view)
+	RoadGraph::Pt _car;
+	bool _committed = false;	// the node ahead's branch is chosen
+	RoadGraph::Pt _committedDir;
+	// Stuck: gas held, the car not moving.
+	uint32 _stuckSince = 0;
+	RoadGraph::Pt _stuckAt;
+	bool _stuck = false;
+	RoadGraph::Pt _stuckDir;
+
+	// The car's picture (watchCar()).
+	float _carHeading = -1.0f;
+	int _carFrame = -1;
+	Common::Array<RoadGraph::Pt> _carTrail;	// its places, a frame apart
+
+	// The mouse on the map.
+	bool _mouseHeld = false;
+	Common::Point _mouseDownPos;
+	uint32 _mouseDownTime = 0;
+	RoadGraph::Spot _clicked;	// route target
+	bool _exitRun = false;		// the route leaves the map (a click by its edge)
+	bool _arriving = false;		// ... and the car just came into the next one
+};
+
+} // End of namespace Director
