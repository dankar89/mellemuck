+static void putInto(int where) {
+	Datum value = g_lingo->pop();
+	Datum var = g_lingo->pop();
+	if (where == 0) {
+		g_lingo->varAssign(var, value);
+		return;
+	}
+	Datum old = g_lingo->varFetch(var);
+	g_lingo->varAssign(var, Datum(where < 0 ? value.asString() + old.asString() : old.asString() + value.asString()));
+}
