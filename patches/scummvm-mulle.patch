+void Score::followMouse() {
+	if (_vm->_dragSpriteChannels.empty() || _playState != kPlayStarted)
+		return;
+	Common::Point mouse = _window->getMousePos();
+	Common::Point last = _followMousePos;
+	_followMousePos = mouse;
+	if (mouse == last)
+		return;
+	int id = _vm->_dragSpriteChannels.getValOrDefault(_movie->getMacName(), 0);
+	if (id <= 0 || id >= (int)_channels.size())
+		return;
+	Channel *channel = _channels[id];
+	if (channel->isEmpty() || !channel->_visible || channel->getPosition() != last)
+		return;
+	channel->setPosition(mouse.x, mouse.y);
+	channel->setNeedsDraw();
+	_window->render();
