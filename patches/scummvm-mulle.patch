+	Common::Rect keyboardBadge(const Common::Rect &field) const;	// stage
+	void drawKeyboardBadge(Graphics::ManagedSurface &screen, const Common::Rect &badge);
+	Common::Rect _badgeShown;
+
+	// The vehicle (Bygger bilar's car, Bygger båtar's boat and its sail),
+	// turned smoothly (roads.h carHeading()): the game's picture for the
+	// nearest of its 16 headings, turned by the rest (at most half a
+	// heading); an attached part (the sail) shifted and turned by as much as
+	// the first. Bigger than the sprites, so the area round them is composed
+	// with them. DirectorEngine::_vehicleArt says which pictures.
+	struct VehiclePart {
+		Channel *ch = nullptr;
+		int art = -1;			// in DirectorEngine::_vehicleArt
+		CastMemberID first;	// the member its pictures count from
+		int index = 0;		// the picture shown, counted from first + offset
+	};
+	// The vehicle's parts on the stage, the main one first; false without it.
+	bool findVehicle(Movie *movie, Common::Array<VehiclePart> &parts);
+	Graphics::ManagedSurface *vehicleImage(Movie *movie, const VehiclePart &part, const VehiclePart &main, Common::Rect &dest);
+	Common::Rect partArea(Channel *ch, Channel *main) const;
+	Common::Rect vehicleArea(const Common::Array<VehiclePart> &parts) const;
+	Common::Rect _carArea;		// stage: where the vehicle was last drawn
+	// The car glides between the game's frames: the game moves it 12 times a
+	// second, 6-13 pixels at a time (18-40 on the screen); HD draws about 60
+	// times a second, so the car's place and heading are drawn moving from
+	// where they were shown towards the game's newest over one frame's time
+	// (user, 2026-10-14: "we can smooth the movement along the path a bit").
+	void updateGlide(Channel *car);
+	bool gliding() const;
+	void glidePlace(float &x, float &y) const;	// stage, the sprite's loc as shown
+	float glideHeading() const;
+	bool _glideKnown = false;
+	Common::Point _glideTo;			// the sprite's loc as the game set it last
+	float _glideFromX = 0.0f, _glideFromY = 0.0f;
+	uint32 _glideStart = 0, _glideTime = 83;
+	float _headFrom = 0.0f, _headTo = 0.0f;
+	uint32 _headStart = 0;
+	struct Turned {
+		Graphics::ManagedSurface surface;
+		CastMemberID from;
+		float by = 0.0f;
+	};
+	Common::HashMap<int, Turned *> _turned;	// by art
+	// The car's HD pictures without the light grey their edges have (the
+	// originals' anti-aliasing towards white, kept by Director's background
+	// transparent ink and shown as specks over the map), by member.
+	Common::HashMap<int, Graphics::ManagedSurface *> _carClean;
+	Graphics::ManagedSurface *carClean(int member, Graphics::ManagedSurface *image);
+	Common::HashMap<Common::String, bool> _notedClassic;	// "movie/member" already explained
+	void drawClassic(Common::Array<Channel *> &group, const Common::Rect &rect, Graphics::ManagedSurface &dst, int opacity = 255);
+	// 255 opaque ... 0 invisible, from the sprite's blend.
+	static int spriteOpacity(Channel *channel);
+	uint32 mix(uint32 under, uint32 over, int opacity) const;
+	// A colour of the classic drawing (the window manager's format: palette
+	// indices, or true colour for Bygg hus's 16-bit art) in the HD format
+	uint32 screenColor(uint32 c) const;
+	void upscaleStage(Window *window, const Common::Rect &rect);
+	void updatePalette();
+	Common::Rect scaled(const Common::Rect &r) const {
+		return Common::Rect(r.left * kScale, r.top * kScale, r.right * kScale, r.bottom * kScale);
+	}
+
+	DirectorEngine *_vm;
+	Common::FSNode _dir;
+	Common::HashMap<Common::String, Entry> _index;	// "CAST:member", CAST the cast file's name
+	Common::HashMap<Common::String, Image> _images;	// by file
+	uint32 _useCounter = 0;
+	uint32 _cacheBytes = 0;
+	uint32 _cacheLimit = 0;
+	Movie *_stemMovie = nullptr;
+	Common::Path _stemMoviePath;	// with the address: a new movie can take the old one's place
+	Common::HashMap<int, Common::String> _stems;	// cast library -> cast file name, for _stemMovie
+	Common::HashMap<Common::String, bool> _mismatches;	// "CAST:member" whose HD file is named for another member
+
+	bool _showArt = true;
+	bool _sprites = false;
+	bool _passthrough = false;
+	bool _fullRedraw = true;
+	bool _paletteDirty = true;
+	int _w = 0, _h = 0;
+	Graphics::PixelFormat _format;	// of _surface and the images (what BlendBlit takes)
+	Graphics::PixelFormat _screenFormat;
+	Graphics::ManagedSurface _surface;	// the screen, 3x
+	Graphics::ManagedSurface _classic[2];	// original-size scratch stages, white and black
+	Common::Rect _dirty;
+	uint32 _palette[256];
+	Common::Array<Layer *> _layers;
+	Common::Array<Common::Rect> _shown;	// screen rects of the windows shown last time
+	Graphics::ManagedSurface _out;	// the screen with the windows over the stage
+};
+
+} // End of namespace Director
+
+#endif
