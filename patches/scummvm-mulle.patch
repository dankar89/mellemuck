-				g_lingo->push(1);
-				return;
-			}
-		default:
-			break;
+	for (auto key : g_director->_keysDown) {
+		if (g_director->platformKeyCode(key) == requestedKey) {
+			g_lingo->push(1);
+			return;
 		}
 	}
-
 	g_lingo->push(0);
 }
 
-XOBJSTUB(KeypollXtra::m_bgAllKeys, 0)
+void KeypollXtra::m_bgAllKeys(int nargs) {
+	ARGNUMCHECK(0);
+	Datum keys;
+	keys.type = ARRAY;
+	keys.u.farr = new FArray;
+	for (auto key : g_director->_keysDown) {
+		int code = g_director->platformKeyCode(key);
