+static void attachTestPad() {
+	for (int p = 0; p < 2; p++) {
+		if (!SDL_getenv(kTestPadVars[p]))
+			continue;
+		const int index = SDL_JoystickAttachVirtual(SDL_JOYSTICK_TYPE_GAMECONTROLLER, SDL_CONTROLLER_AXIS_MAX, SDL_CONTROLLER_BUTTON_MAX, 0);
+		s_testPads[p] = index >= 0 ? SDL_JoystickOpen(index) : nullptr;
+		if (!s_testPads[p])
