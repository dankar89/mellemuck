+	if (id <= 0 || id >= (int)_channels.size() || _playState == kPlayStopped)
+		return 0;
+	// Only while the real cursor is hidden; a game that shows a cursor (Mulle's
+	// driving map uses cast-member cursors) gets its sprite drawn as usual.
+	if (_defaultCursor._cursorType != Graphics::kMacCursorOff)
+		return 0;
+	Channel *channel = _channels[id];
+	if (channel->isEmpty() || !channel->_visible || !channel->_sprite->_cast ||
+			channel->_sprite->_cast->_type != kCastBitmap || !channel->_widget || isStrayCursorSprite(channel))
+		return 0;
+	return id;
