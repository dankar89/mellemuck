+// The member's picture changed: drop what was made from it and redraw.
+static void bitmapChanged(BitmapCastMember *m) {
+	if (m->_ditheredImg) {
+		m->_ditheredImg->free();
+		delete m->_ditheredImg;
+		m->_ditheredImg = nullptr;
+	}
+	if (m->_matte) {
+		m->_matte->free();
+		delete m->_matte;
+		m->_matte = nullptr;
+	}
+	m->_noMatte = false;
+	m->_scriptImage = true;
+	m->_imageVersion++;
+	m->_alpha.clear();
+	delete m->_alphaMask;
+	m->_alphaMask = nullptr;
+	m->setModified(true);
+	Movie *movie = g_director->getCurrentMovie();
+	Score *score = movie ? movie->getScore() : nullptr;
+	if (score) {
+		for (uint i = 0; i < score->_channels.size(); i++) {
+			Channel *ch = score->_channels[i];
+			if (ch && ch->_sprite && ch->_sprite->_cast == m)
+				ch->setDirty();
+			// A mask-ink sprite's mask is the member after its own (Bygg hus's
+			// mud: the scoop bites holes into the mask with setPixel).
+			else if (ch && ch->_sprite && ch->_sprite->_ink == kInkTypeMask &&
+					ch->_sprite->_castId.member + 1 == m->getID() && ch->_sprite->_cast &&
+					ch->_sprite->_cast->getCast() == m->getCast())
+				ch->setDirty();
+		}
+	}
+}
