+// Input ----------------------------------------------------------------------
+
+void GameMenu::handleEvent(const Common::Event &event) {
+	switch (event.type) {
+	case Common::EVENT_CUSTOM_ENGINE_ACTION_START: {
+		if (event.customType >= kActionMenuSelect && event.customType <= kActionMenuClose)
+			_heldButtons |= 1 << (event.customType - kActionMenuSelect);
+		int dx = 0, dy = 0;
+		switch (event.customType) {
+		case kActionMenuUp:		dy = -1; break;
+		case kActionMenuDown:	dy = 1; break;
+		case kActionMenuLeft:	dx = -1; break;
+		case kActionMenuRight:	dx = 1; break;
+		case kActionMenuSelect:	activate(_focus); return;
+		case kActionMenuBack:	back(); return;
+		case kActionMenuClose:	_done = true; return;
+		default:				return;
+		}
+		if (dx == _heldDx && dy == _heldDy)
+			return;	// key repeat; we repeat ourselves
+		_heldDx = dx;
+		_heldDy = dy;
+		_nextRepeat = g_system->getMillis() + kRepeatDelay;
+		move(dx, dy);
+		break;
+	}
+	case Common::EVENT_CUSTOM_ENGINE_ACTION_END: {
+		if (event.customType >= kActionMenuSelect && event.customType <= kActionMenuClose)
+			_heldButtons &= ~(1 << (event.customType - kActionMenuSelect));
+		const bool horizontal = event.customType == kActionMenuLeft || event.customType == kActionMenuRight;
+		const bool vertical = event.customType == kActionMenuUp || event.customType == kActionMenuDown;
+		if ((horizontal && _heldDx) || (vertical && _heldDy))
+			_heldDx = _heldDy = 0;
+		break;
+	}
+	case Common::EVENT_MOUSEMOVE: {
+		int index = itemAt(event.mouse);
+		if (index >= 0 && index != _focus && _items[index].enabled) {
+			_focus = index;
+			_dirty = true;
+		}
+		break;
+	}
+	case Common::EVENT_LBUTTONDOWN:
+		_pressed = itemAt(event.mouse);
+		break;
+	case Common::EVENT_LBUTTONUP: {
+		int index = itemAt(event.mouse);
+		if (index >= 0 && index == _pressed && _items[index].enabled) {
+			_focus = index;
+			activate(index);
+		}
+		_pressed = -1;
+		break;
+	}
+	case Common::EVENT_RBUTTONUP:
+		back();
+		break;
+	case Common::EVENT_QUIT:
+		// The window was closed while the game locks quitting (its own quit
+		// saves first): ask here; ours saves too.
+		if (g_lingo && g_lingo->_exitLock) {
+			g_system->getEventManager()->resetQuit();
+			_confirm = kConfirmQuit;
+			_confirmFrom = kPageMain;
+			showPage(kPageConfirm, 1);
+		}
+		break;
+	case Common::EVENT_MAINMENU:
+		// Start (the global keymap) while the menu is open: the engine is
+		// paused, so ScummVM does not open the menu again. Close it.
+		_done = true;
+		break;
+	case Common::EVENT_SCREEN_CHANGED:
+		_ow = _oh = 0;
+		break;
+	default:
+		break;
+	}
+}
+
+// Moves the focus to the nearest item in that direction, or wraps around.
+void GameMenu::move(int dx, int dy) {
+	if (_items.empty())
+		return;
+	const Common::Rect &from = _items[_focus].box;
+	const int cx = (from.left + from.right) / 2, cy = (from.top + from.bottom) / 2;
+	int best = -1, bestScore = 0;
+	int wrap = -1, wrapScore = 0;
+	for (uint i = 0; i < _items.size(); i++) {
+		if ((int)i == _focus || !_items[i].enabled)
+			continue;
+		const Common::Rect &to = _items[i].box;
+		const int vx = (to.left + to.right) / 2 - cx, vy = (to.top + to.bottom) / 2 - cy;
+		const int along = dx ? vx * dx : vy * dy;
+		const int across = ABS(dx ? vy : vx);
+		if (along > 0) {
+			const int score = along + 2 * across;
+			if (best < 0 || score < bestScore) {
+				best = i;
+				bestScore = score;
+			}
+		} else if (along < 0) {
+			const int score = along + 2 * across;	// the farthest back, in line
+			if (wrap < 0 || score < wrapScore) {
+				wrap = i;
+				wrapScore = score;
+			}
+		}
+	}
+	if (best < 0)
+		best = wrap;
+	if (best >= 0 && best != _focus) {
+		_focus = best;
+		_dirty = true;
+	}
+}
+
+void GameMenu::activate(int index) {
+	if (index < 0 || index >= (int)_items.size() || !_items[index].enabled)
+		return;
+	const Item item = _items[index];
+	switch (item.id) {
+	case kItemContinue:
+		_done = true;
+		break;
+	case kItemSave:
+		// Start on the first slot.
+		showPage(kPageSave, 1);
+		break;
+	case kItemLoad:
+		// Start on the latest save.
+		showPage(kPageLoad, 1);
+		break;
+	case kItemFullscreen:
+		toggleFullscreen();
+		break;
+	case kItemSettings:
+		runSettings();
+		break;
+	case kItemQuit:
+		_confirm = kConfirmQuit;
+		_confirmFrom = kPageMain;
+		showPage(kPageConfirm, 1);
+		break;
+	case kItemBack:
+		back();
+		break;
+	case kItemSlot:
+		if (_page == kPageSave) {
+			if (_slots[item.slot].used) {
+				_confirm = kConfirmOverwrite;
+				_confirmSlot = item.slot;
+				_confirmFrom = kPageSave;
+				showPage(kPageConfirm, 0);
+			} else {
+				saveTo(item.slot);
+			}
+		} else {
+			// Engine::openMainMenuDialog() loads it once the menu has closed.
+			_vm->setGameToLoadSlot(_slotBase + item.slot);
+			_done = true;
+		}
+		break;
+	case kItemYes:
+		if (_confirm == kConfirmQuit)
+			quit();
+		else
+			saveTo(_confirmSlot);
+		break;
+	case kItemNo:
+		back();
+		break;
+	}
+}
+
+void GameMenu::back() {
+	switch (_page) {
+	case kPageMain:
+		_done = true;
+		break;
+	case kPageSave:
+		showPage(kPageMain);
+		focusItem(kItemSave);
+		break;
+	case kPageLoad:
+		showPage(kPageMain);
+		focusItem(kItemLoad);
+		break;
+	case kPageConfirm:
+		if (_confirmFrom == kPageSave) {
+			showPage(kPageSave, 1);
+			focusItem(kItemSlot, _confirmSlot);
+		} else if (_askedQuit) {
+			_done = true;
+		} else {
+			showPage(kPageMain);
+			focusItem(kItemQuit);
+		}
+		break;
+	}
+}
+
+int GameMenu::itemAt(const Common::Point &pos) const {
+	for (uint i = 0; i < _items.size(); i++) {
+		if (pxRect(_items[i].box).contains(pos))
+			return i;
+	}
+	return -1;
+}
+
+// What items do ----------------------------------------------------------------
+
+// slot: the player's own numbering (kFirstManualSlot...); a player's first save
+// gives them their block of slots.
+void GameMenu::saveTo(int slot) {
+	const Common::String player = _vm->currentPlayerName();
+	const int base = _vm->playerSlotBase(player, true);
+	Common::Error status = base < 0 ? Common::Error(Common::kWritingFailed, "no free save slots")
+		: _vm->saveGameState(base + slot, player, false);
+	if (status.getCode() != Common::kNoError) {
+		warning("GameMenu::saveTo(): %s", status.getDesc().c_str());
+		showPage(kPageMain);
+		focusItem(kItemSave);
+		toast("Det gick inte att spara");
+		return;
+	}
+	showPage(kPageMain);
+	toast("Sparat!");
+}
+
+// Saves (an autosave) and quits. The game sets the exitLock so that quitting
+// goes through its own routine, which saves; this has saved already.
+void GameMenu::quit() {
+	if (_vm->canSaveGameStateCurrently())
+		_vm->writeAutosave();
+	if (g_lingo)
+		g_lingo->_exitLock = false;
+	_vm->quitGame();
+	_done = true;
+}
+
+void GameMenu::toggleFullscreen() {
+	const bool on = !g_system->getFeatureState(OSystem::kFeatureFullscreenMode);
+	g_system->beginGFXTransaction();
+	g_system->setFeatureState(OSystem::kFeatureFullscreenMode, on);
+	g_system->endGFXTransaction();
+	ConfMan.setBool("fullscreen", on, Common::ConfigManager::kApplicationDomain);
+	if (ConfMan.hasKey("fullscreen", ConfMan.getActiveDomainName()))
+		ConfMan.setBool("fullscreen", on);
+	ConfMan.flushToDisk();
+	// The window changed size: lay out again, keep the focus.
+	g_system->showOverlay(true);
+	_ow = _oh = 0;
+	showPage(kPageMain);
+	focusItem(kItemFullscreen);
+}
+
+// ScummVM's own menu: options, keys, saves in its own dialogs, return to the
+// launcher. Leaving it goes back to the game, as its Resume button says; a
+// game loaded there is loaded by Engine::openMainMenuDialog() as from ours.
+void GameMenu::runSettings() {
+	_vm->runScummVMMenu();
+	_done = true;
+}
+
+void GameMenu::toast(const char *text) {
+	_toast = Common::U32String(text);
+	_toastUntil = g_system->getMillis() + 2000;
+	_dirty = true;
+}
+
+// Drawing --------------------------------------------------------------------
+
+// The game screen as the menu opened, for the background.
+void GameMenu::grabGame() {
+	_game.free();
+	Graphics::Surface *screen = g_system->lockScreen();
+	if (!screen)
+		return;
+	Graphics::Surface *converted;
+	if (screen->format.isCLUT8()) {
+		byte palette[256 * 3];
+		g_system->getPaletteManager()->grabPalette(palette, 0, 256);
+		converted = screen->convertTo(_format, palette);
+	} else {
+		converted = screen->convertTo(_format);
+	}
+	g_system->unlockScreen();
+	_game.copyFrom(*converted);
+	converted->free();
+	delete converted;
+}
+
+void GameMenu::layout() {
+	_ow = g_system->getOverlayWidth();
+	_oh = g_system->getOverlayHeight();
+	_scale = MIN(_ow / 640.0f, _oh / 480.0f);
+	_origin = Common::Point((int)((_ow - 640 * _scale) / 2), (int)((_oh - 480 * _scale) / 2));
+	freeFonts();
+	for (auto &slot : _slots)
+		slot.scaled.free();
+	_canvas.create(_ow, _oh, _format);
+
+	// The background: the game screen fitted to the overlay as the game is,
+	// blurred (shrunk and grown again, smoothly) and dimmed.
+	_background.create(_ow, _oh, _format);
+	_background.fillRect(Common::Rect(_ow, _oh), 0xFF1A120B);
+	if (_game.w > 0 && _game.h > 0) {
+		const float fit = MIN(_ow / (float)_game.w, _oh / (float)_game.h);
+		const int w = (int)(_game.w * fit), h = (int)(_game.h * fit);
+		const int x0 = (_ow - w) / 2, y0 = (_oh - h) / 2;
+
+		// Average blocks of the screen into a small picture (160 high), then
+		// grow it bilinearly: a soft blur at any size.
+		const int sh = MIN<int>(160, _game.h), sw = MAX(1, _game.w * sh / _game.h);
+		Common::Array<float> small(sw * sh * 3);
+		for (int y = 0; y < sh; y++) {
+			const int gy0 = y * _game.h / sh, gy1 = MAX(gy0 + 1, (y + 1) * _game.h / sh);
+			for (int x = 0; x < sw; x++) {
+				const int gx0 = x * _game.w / sw, gx1 = MAX(gx0 + 1, (x + 1) * _game.w / sw);
+				uint32 sum[3] = { 0, 0, 0 };
+				for (int gy = gy0; gy < gy1; gy++) {
+					const uint32 *p = (const uint32 *)_game.getBasePtr(gx0, gy);
+					for (int gx = gx0; gx < gx1; gx++, p++) {
+						sum[0] += (*p >> 16) & 0xFF;
+						sum[1] += (*p >> 8) & 0xFF;
+						sum[2] += *p & 0xFF;
+					}
+				}
+				const float n = (float)((gx1 - gx0) * (gy1 - gy0));
+				for (int c = 0; c < 3; c++)
+					small[(y * sw + x) * 3 + c] = sum[c] / n;
+			}
+		}
+		// Dimmed to about 40%, a little warm.
+		static const float dim[3] = { 0.42f, 0.39f, 0.35f };
+		for (int y = 0; y < h; y++) {
+			const float fy = CLIP((y + 0.5f) * sh / h - 0.5f, 0.0f, sh - 1.0f);
+			const int iy = MIN((int)fy, sh - 2 < 0 ? 0 : sh - 2), iy1 = MIN(iy + 1, sh - 1);
+			const float ty = fy - iy;
+			uint32 *out = (uint32 *)_background.getBasePtr(x0, y0 + y);
+			for (int x = 0; x < w; x++, out++) {
+				const float fx = CLIP((x + 0.5f) * sw / w - 0.5f, 0.0f, sw - 1.0f);
+				const int ix = MIN((int)fx, sw - 2 < 0 ? 0 : sw - 2), ix1 = MIN(ix + 1, sw - 1);
+				const float tx = fx - ix;
+				uint32 rgb[3];
+				for (int c = 0; c < 3; c++) {
+					const float top = small[(iy * sw + ix) * 3 + c] * (1 - tx) + small[(iy * sw + ix1) * 3 + c] * tx;
+					const float bottom = small[(iy1 * sw + ix) * 3 + c] * (1 - tx) + small[(iy1 * sw + ix1) * 3 + c] * tx;
+					rgb[c] = (uint32)CLIP((top * (1 - ty) + bottom * ty) * dim[c] + 8.0f, 0.0f, 255.0f);
+				}
+				*out = 0xFF000000 | (rgb[0] << 16) | (rgb[1] << 8) | rgb[2];
+			}
+		}
+	}
+	_dirty = true;
+}
+
+void GameMenu::freeFonts() {
+	for (auto &font : _fonts)
+		delete font._value;
+	_fonts.clear();
+}
+
+// The menu font at a size in layout units, loaded for the current scale.
+Graphics::Font *GameMenu::font(int units) {
+	if (_fonts.contains(units) && _fonts[units])
+		return _fonts[units];
+	const int size = MAX(8, (int)(units * _scale + 0.5f));
+	Graphics::Font *f = nullptr;
+#ifdef USE_FREETYPE2
+	Common::SeekableReadStream *stream = SearchMan.createReadStreamForMember(kFontFile);
+	if (stream)
+		f = Graphics::loadTTFFont(stream, DisposeAfterUse::YES, size, Graphics::kTTFSizeModeCharacter, 0, 0, Graphics::kTTFRenderModeLight);
+	if (!f) {
+		static bool warned = false;
+		if (!warned)
+			warning("GameMenu: %s not found, using ScummVM's font", kFontFile);
+		warned = true;
+		f = Graphics::loadTTFFontFromArchive("FreeSansBold.ttf", size, Graphics::kTTFSizeModeCharacter, 0, 0, Graphics::kTTFRenderModeLight);
+	}
+#endif
+	if (!f)
+		return const_cast<Graphics::Font *>(FontMan.getFontByUsage(Graphics::FontManager::kBigGUIFont));
+	_fonts[units] = f;
+	return f;
+}
+
+Common::Rect GameMenu::pxRect(const Common::Rect &unitBox, float grow) const {
+	return Common::Rect((int)pxX(unitBox.left - grow), (int)pxY(unitBox.top - grow),
+		(int)pxX(unitBox.right + grow), (int)pxY(unitBox.bottom + grow));
+}
+
+void GameMenu::draw() {
+	_canvas.blitFrom(_background);
+
+	// The panel, with a soft shadow.
+	const float r = 22.0f * _scale;
+	roundRectPx(pxX(_panel.left) + 4 * _scale, pxY(_panel.top) + 8 * _scale, pxX(_panel.right) + 4 * _scale, pxY(_panel.bottom) + 8 * _scale,
+		r, 0x000000, 0.45f, 10.0f * _scale);
+	roundRect(_panel, 22.0f, kPaper, 3.5f, kInk);
+
+	// The title: beside the back button on the slot pages, above the
+	// buttons in the middle of the panel on the others.
+	Common::Rect titleBox(_panel.left, _panel.top + 12, _panel.right, _panel.top + 62);
+	if (_page == kPageConfirm)
+		titleBox = Common::Rect(_panel.left + 10, _panel.top + 26, _panel.right - 10, _panel.top + 80);
+	else if (_page != kPageMain)
+		titleBox = Common::Rect(_panel.left + 130, _panel.top + 12, _panel.right - 130, _panel.top + 54);
+	text(_page == kPageConfirm ? kButtonSize + 2 : kTitleSize, _title, titleBox, kInk);
+
+	for (uint i = 0; i < _items.size(); i++) {
+		if (_items[i].id == kItemSlot)
+			drawSlotCard(_items[i], (int)i == _focus);
+		else
+			drawButton(_items[i], (int)i == _focus);
+	}
+
+	if (!_toast.empty()) {
+		Graphics::Font *f = font(kButtonSize - 4);
+		const int w = (int)(f->getStringWidth(_toast) / _scale) + 48;
+		Common::Rect box(320 - w / 2, _panel.top - 18, 320 + w / 2, _panel.top + 18);
+		roundRect(box, 18.0f, kToastFill, 3.0f, kWhite);
+		text(kButtonSize - 4, _toast, box, kWhite);
+	}
+
+	drawHints();
+
+	Graphics::Surface *out = _canvas.rawSurface().convertTo(g_system->getOverlayFormat());
+	g_system->copyRectToOverlay(out->getPixels(), out->pitch, 0, 0, out->w, out->h);
+	out->free();
+	delete out;
+	_dirty = false;
+}
+
+void GameMenu::drawButton(const Item &item, bool focused) {
+	const bool back = item.id == kItemBack;
+	const float grow = focused ? 3.0f : 0.0f;
+	uint32 fill = focused ? kButtonFocus : kButton, ink = kInk;
+	if (!item.enabled) {
+		fill = kDisabledFill;
+		ink = kDisabledInk;
+	}
+	Common::Rect box = item.box;
+	roundRect(box, back ? 18.0f : 16.0f, fill, focused ? 4.0f : 2.5f, item.enabled ? kInk : kDisabledInk, grow);
+	Common::U32String label = back ? Common::U32String("‹ ") + item.label : item.label;
+	text(back ? kCaptionSize + 3 : kButtonSize, label, box, ink);
+}
+
+// A save slot: its thumbnail, with the date on a band along the bottom.
+void GameMenu::drawSlotCard(const Item &item, bool focused) {
+	Slot &slot = _slots[item.slot];
+	const float grow = focused ? 4.0f : 0.0f;
+	const uint32 frame = focused ? kButtonFocus : (item.enabled ? kButton : kDisabledFill);
+	roundRect(item.box, 12.0f, frame, focused ? 4.0f : 2.5f, item.enabled ? kInk : kDisabledInk, grow);
+
+	// The picture inside the frame.
+	const float pad = 6.0f + grow * 0.5f;
+	const Common::Rect inner((int)pxX(item.box.left - grow + pad), (int)pxY(item.box.top - grow + pad),
+		(int)pxX(item.box.right + grow - pad), (int)pxY(item.box.bottom + grow - pad));
+	if (slot.used && slot.thumb.w > 0) {
+		if (slot.scaled.w != inner.width() || slot.scaled.h != inner.height()) {
+			Graphics::ManagedSurface *scaled = slot.thumb.scale(inner.width(), inner.height(), true);
+			slot.scaled.copyFrom(*scaled);
+			delete scaled;
+		}
+		_canvas.blitFrom(slot.scaled, Common::Point(inner.left, inner.top));
+	} else {
+		_canvas.fillRect(inner, item.enabled ? 0xFFFFF8E8 : 0xFFF1EBDD);
+		if (_page == kPageSave)
+			text(44, Common::U32String("+"), Common::Rect(item.box.left, item.box.top, item.box.right, item.box.bottom - 22), kInk);
+	}
+
+	// The band with the date.
+	const int bandH = (int)(26 * _scale);
+	Common::Rect band(inner.left, inner.bottom - bandH, inner.right, inner.bottom);
+	for (int y = band.top; y < band.bottom; y++) {
+		uint32 *p = (uint32 *)_canvas.getBasePtr(band.left, y);
+		for (int x = band.left; x < band.right; x++, p++) {
+			const uint32 c = *p;
+			// 80% paper
+			const uint32 r = (((c >> 16) & 0xFF) + 4 * ((kPaper >> 16) & 0xFF)) / 5;
+			const uint32 g = (((c >> 8) & 0xFF) + 4 * ((kPaper >> 8) & 0xFF)) / 5;
+			const uint32 b = ((c & 0xFF) + 4 * (kPaper & 0xFF)) / 5;
+			*p = 0xFF000000 | (r << 16) | (g << 8) | b;
+		}
+	}
+	Common::Rect bandUnits(item.box.left, (int)((band.top - _origin.y) / _scale), item.box.right, (int)((band.bottom - _origin.y) / _scale));
+	text(kCaptionSize, slot.caption, bandUnits, item.enabled ? kInk : kDisabledInk);
+}
+
+// What the controller's buttons do, below the panel.
+void GameMenu::drawHints() {
+	struct Hint {
+		const char *button;
+		uint32 color;
+		const char *label;
+	};
+	const Hint hints[] = {
+		{ "A", kPadA, "Välj" },
+		{ "B", kPadB, _page == kPageMain ? "Fortsätt" : "Tillbaka" },
+	};
+	Graphics::Font *f = font(kHintSize);
+	int widths[ARRAYSIZE(hints)], total = 0;
+	for (uint i = 0; i < ARRAYSIZE(hints); i++) {
+		widths[i] = 24 + 6 + (int)(f->getStringWidth(Common::U32String(hints[i].label)) / _scale) + 1;
+		total += widths[i] + (i ? 28 : 0);
+	}
+	const int top = MIN(480 - 30, _panel.bottom + 10);
+	int x = 320 - total / 2;
+	for (uint i = 0; i < ARRAYSIZE(hints); i++) {
+		Common::Rect badge(x, top, x + 24, top + 24);
+		roundRect(badge, 12.0f, hints[i].color, 2.0f, kWhite);
+		text(kHintSize - 2, Common::U32String(hints[i].button), badge, kWhite);
+		text(kHintSize, Common::U32String(hints[i].label), Common::Rect(x + 30, top, x + widths[i], top + 24), kWhite, false);
+		x += widths[i] + 28;
+	}
+}
+
+// A rounded rectangle in layout units, optionally with a border, grown by
+// `grow` units on each side.
+void GameMenu::roundRect(const Common::Rect &unitBox, float radius, uint32 color, float border, uint32 borderColor, float grow) {
+	const float x0 = pxX(unitBox.left - grow), y0 = pxY(unitBox.top - grow);
+	const float x1 = pxX(unitBox.right + grow), y1 = pxY(unitBox.bottom + grow);
+	const float r = (radius + grow) * _scale;
+	if (border > 0.0f) {
+		const float b = border * _scale;
+		roundRectPx(x0, y0, x1, y1, r, borderColor);
+		roundRectPx(x0 + b, y0 + b, x1 - b, y1 - b, MAX(0.0f, r - b), color);
+	} else {
+		roundRectPx(x0, y0, x1, y1, r, color);
+	}
+}
+
+// Fills a rounded rectangle with smooth edges: each pixel is covered by how
+// far its centre lies inside the shape (a signed distance), over `feather`
+// pixels on either side of the edge.
+void GameMenu::roundRectPx(float x0, float y0, float x1, float y1, float r, uint32 color, float alpha, float feather) {
+	const float cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
+	const float hw = (x1 - x0) / 2, hh = (y1 - y0) / 2;
+	r = MIN(r, MIN(hw, hh));
+	const int left = MAX(0, (int)floorf(x0 - feather)), right = MIN<int>(_canvas.w, (int)ceilf(x1 + feather));
+	const int top = MAX(0, (int)floorf(y0 - feather)), bottom = MIN<int>(_canvas.h, (int)ceilf(y1 + feather));
+	const uint32 cr = (color >> 16) & 0xFF, cg = (color >> 8) & 0xFF, cb = color & 0xFF;
+	for (int y = top; y < bottom; y++) {
+		uint32 *p = (uint32 *)_canvas.getBasePtr(left, y);
+		const float qy = fabsf(y + 0.5f - cy) - (hh - r);
+		for (int x = left; x < right; x++, p++) {
+			const float qx = fabsf(x + 0.5f - cx) - (hw - r);
+			float d;
+			if (qx > 0.0f && qy > 0.0f)
+				d = sqrtf(qx * qx + qy * qy) - r;
+			else
+				d = MAX(qx, qy) - r;
+			float a = CLIP(0.5f - d / (2.0f * feather), 0.0f, 1.0f) * alpha;
+			if (a <= 0.0f)
+				continue;
+			if (a >= 1.0f) {
+				*p = 0xFF000000 | color;
+				continue;
+			}
+			const uint32 ia = (uint32)(a * 256.0f), na = 256 - ia;
+			const uint32 c = *p;
+			const uint32 rr = (cr * ia + ((c >> 16) & 0xFF) * na) >> 8;
+			const uint32 gg = (cg * ia + ((c >> 8) & 0xFF) * na) >> 8;
+			const uint32 bb = (cb * ia + (c & 0xFF) * na) >> 8;
+			*p = 0xFF000000 | (rr << 16) | (gg << 8) | bb;
+		}
+	}
+}
+
+// Text in a box (layout units), centred vertically on the capitals.
+void GameMenu::text(int size, const Common::U32String &str, const Common::Rect &unitBox, uint32 color, bool centered) {
+	Graphics::Font *f = font(size);
+	if (!f)
+		return;
+	const Common::Rect box = pxRect(unitBox);
+	const int px = MAX(8, (int)(size * _scale + 0.5f));
+	// Capitals are about 0.7 of the size high; put their middle on the box's.
+	const int baseline = (box.top + box.bottom) / 2 + (int)(px * 0.35f);
+	const int y = baseline - f->getFontAscent();
+	f->drawString(&_canvas, str, box.left, y, box.width(), 0xFF000000 | color,
+		centered ? Graphics::kTextAlignCenter : Graphics::kTextAlignLeft);
+}
+
+// The engine's side ---------------------------------------------------------------
+
+// Engine::openMainMenuDialog() runs ScummVM's main menu through here; titles
+// with our menu get that instead.
+int DirectorEngine::runDialog(GUI::Dialog &dialog) {
+	if (!_gameMenu || &dialog != _mainMenuDialog)
+		return Engine::runDialog(dialog);
+	// ScummVM opens its menu from event polling, which also happens while a
+	// script runs (Lingo::execute()); saving and loading need a moment between
+	// scripts. So a request in the middle of a script waits for it to finish.
+	if (g_lingo && g_lingo->_executeDepth > 0 && !_menuForced) {
+		if (!_menuPending) {
+			_menuPending = true;
+			_menuPendingSince = g_system->getMillis();
+		}
+		return 0;
+	}
+	_menuPending = false;
+	const bool askQuit = _menuAskQuit;
+	_menuAskQuit = false;
+	releaseHeldInput();
+	PauseToken pauseToken = pauseEngine();
+	_gameMenu->run(askQuit);
+	return 0;
+}
+
+// Opens a menu asked for while a script ran: between scripts (the main loop),
+// or in the middle of one that has run for a second (a loop waiting for
+// something), as before, with saving and loading off.
+void DirectorEngine::openPendingMenu(bool inLingo) {
+	if (!_menuPending)
+		return;
+	if (inLingo) {
+		if (g_system->getMillis() - _menuPendingSince < 1000)
+			return;
+		_menuForced = true;
+	}
+	openMainMenuDialog();
+	_menuForced = false;
+	_menuPending = false;
+}
+
+// ScummVM's GUI is laid out for a fixed size in its own pixels, so in a big
+// window it is tiny. While it runs from our menu, scale it so that it is laid
+// out for about 640x480, like the game (unless the player chose a GUI scale).
+void DirectorEngine::runScummVMMenu() {
+	if (!_mainMenuDialog)
+		return;
+	const bool scaled = !ConfMan.hasKey("gui_scale", Common::ConfigManager::kApplicationDomain);
+	if (scaled) {
+		const float hiDPI = MAX(1.0f, g_system->getHiDPIScreenFactor());
+		const int percent = (int)(g_system->getOverlayHeight() / 480.0f / hiDPI * 100.0f);
+		if (percent > 100) {
+			ConfMan.setInt("gui_scale", percent, Common::ConfigManager::kTransientDomain);
+			g_gui.computeScaleFactor();
+			g_gui.theme()->refresh();
+		}
+	}
+	_mainMenuDialog->runModal();
+	if (scaled && ConfMan.hasKey("gui_scale", Common::ConfigManager::kTransientDomain)) {
+		ConfMan.removeKey("gui_scale", Common::ConfigManager::kTransientDomain);
+		g_gui.computeScaleFactor();
+		g_gui.theme()->refresh();
+	}
+}
+
