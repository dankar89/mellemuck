+		act = new Action("HDART", _("Toggle HD art"));
+		act->setCustomEngineActionEvent(Director::kActionToggleHDArt);
+		act->addDefaultInputMapping("F6");
+		keymap->addAction(act);
+
+		// The roads the driving follows, over the map (roads.h; for finding faults).
+		act = new Action("ROADS", _("Show the roads"));
+		act->setCustomEngineActionEvent(Director::kActionToggleRoads);
+		act->addDefaultInputMapping("F7");
+		keymap->addAction(act);
+
+		// While driving (Bygger bilar's map, see DirectorEngine::updateDrivePad())
+		// this keymap replaces the one above: the left stick points the car
+		// instead of moving the pointer, A/right trigger is the gas (the game's
+		// Up) and B/left trigger brakes and reverses (Down). The D-pad is the
+		// arrow keys; the keyboard is unchanged.
+		Keymap *driving = new Keymap(Keymap::kKeymapTypeGame, "director-garygadget-driving", _("Driving"));
