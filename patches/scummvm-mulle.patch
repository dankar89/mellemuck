+
+RoadGraph *RoadDriver::graphFor(AbstractObject *car) {
+	if (!car->hasProp("wheels"))
+		return nullptr;
+	Datum wheels = car->getProp("wheels");
+	if (wheels.type != OBJECT || !wheels.u.obj->hasProp("Topology"))
+		return nullptr;
+	Datum topo = wheels.u.obj->getProp("Topology");
+	if (topo.type != STRING)
+		return nullptr;
+	if (topo.u.s == _terrainId && _graph)
+		return _graph;
+
+	// A new map: its terrain as the game reads it (charToNum of each char).
+	Common::U32String text = topo.u.s->decode(Common::kUtf8);
+	if (text.size() != (uint)(RoadGraph::kW * RoadGraph::kH)) {
+		if (_terrainId != topo.u.s)
+			warning("RoadDriver: the terrain has %d cells, not %d", text.size(), RoadGraph::kW * RoadGraph::kH);
+		_terrainId = topo.u.s;
+		_graph = nullptr;
+		return nullptr;
+	}
+	Common::Array<byte> terrain(text.size());
+	uint32 hash = 2166136261u;
+	for (uint i = 0; i < text.size(); i++) {
+		terrain[i] = (byte)CLIP(charToNum(text[i]), 0, 255);
+		hash = (hash ^ terrain[i]) * 16777619u;
+	}
+	_terrainId = topo.u.s;
+	RoadGraph *graph;
+	if (_graphs.contains(hash)) {
+		graph = _graphs[hash];
+	} else {
+		const uint32 start = g_system->getMillis();
+		graph = new RoadGraph();
+		graph->build(terrain.data());
+		_graphs[hash] = graph;
+		int ends = 0, exits = 0;
+		for (uint n = 0; n < graph->nodes.size(); n++) {
+			ends += graph->degree(n) == 1;
+			exits += graph->isExit(n);
+		}
+		debugC(1, kDebugEvents, "RoadDriver: map %08x: %d nodes, %d edges, %d ends (%d exits), %d ms",
+			hash, graph->nodes.size(), graph->edges.size(), ends, exits, g_system->getMillis() - start);
+		if (debugChannelSet(3, kDebugEvents)) {
+			for (uint n = 0; n < graph->nodes.size(); n++)
+				debugC(3, kDebugEvents, "RoadDriver:   node %d at %.1f,%.1f, degree %d", n, graph->nodes[n].x, graph->nodes[n].y, graph->degree(n));
+			for (uint i = 0; i < graph->edges.size(); i++)
+				debugC(3, kDebugEvents, "RoadDriver:   edge %d: %d-%d, %.0f px", i, graph->edges[i].a, graph->edges[i].b, graph->edges[i].length());
+		}
+	}
+	if (graph != _graph) {
+		// Another map: the way planned was on the last one. Driven off the
+		// map by a click: on a little into this one (update()); a way that
+		// left the map by chance: stop.
+		const Mode mode = _mode;
+		const bool exitRun = _exitRun && mode == kRoute;
+		reset();
+		if (mode == kDirection)
+			_mode = kDirection;
+		else if (exitRun)
+			_arriving = true;
+		else if (mode == kRoute)
+			_mode = kStopping;
+		_at = RoadGraph::Spot();
+	}
+	_graph = graph;
+	return graph;
+}
+
+bool RoadDriver::locate(float x, float y, RoadGraph::Spot &spot) {
+	// Stay on the edge it was on while it is near: at a junction the nearest
+	// edge flips between the roads meeting there.
+	if (_at.valid() && _at.edge < (int)_graph->edges.size()) {
+		RoadGraph::Spot here = _graph->nearest(x, y, _at.edge);
+		if (here.dist < 14.0f) {
+			spot = here;
+			return true;
+		}
+	}
+	for (uint i = 0; i < _plan.size() && i < 3; i++) {
+		RoadGraph::Spot here = _graph->nearest(x, y, _plan[i].edge);
+		if (here.dist < 14.0f) {
+			spot = here;
+			return true;
+		}
+	}
+	spot = _graph->nearest(x, y);
+	return spot.valid() && spot.dist < 60.0f;
+}
+
+bool RoadDriver::extendPlan(const RoadGraph::Pt &dir) {
+	if (_plan.empty())
+		return false;
+	const Step &last = _plan.back();
+	const RoadGraph::Edge &e = _graph->edges[last.edge];
+	const int node = last.forward ? e.b : e.a;
+	if (_graph->degree(node) <= 1)
+		return false;	// a dead end, or the way off the map
+	int best = -1;
+	bool bestForward = true;
+	float bestScore = -2.0f;
+	for (uint i = 0; i < _graph->edges.size(); i++) {
+		const RoadGraph::Edge &f = _graph->edges[i];
+		for (int way = 0; way < 2; way++) {
+			const bool forward = way == 0;
+			if ((forward ? f.a : f.b) != node)
+				continue;
+			// Not back the way it came.
+			if ((int)i == last.edge && forward != last.forward)
+				continue;
+			const float score = dot(_graph->leaving(node, i, forward), dir);
+			if (score > bestScore) {
+				bestScore = score;
+				best = i;
+				bestForward = forward;
+			}
+		}
+	}
+	if (best < 0)
+		return false;
+	Step step;
+	step.edge = best;
+	step.forward = bestForward;
+	_plan.push_back(step);
+	return true;
+}
+
+RoadGraph::Pt RoadDriver::aimAhead(float dist, float &toEnd, bool &offMap) {
+	offMap = false;
+	toEnd = 1e9f;
+	float s = _at.s;
+	float left = dist;
+	float travelled = 0.0f;
+	for (uint i = 0; i < _plan.size(); i++) {
+		const Step &step = _plan[i];
+		const RoadGraph::Edge &e = _graph->edges[step.edge];
+		const bool last = i + 1 == _plan.size();
+		float endS = step.forward ? e.length() : 0.0f;
+		if (last && _endS >= 0.0f)
+			endS = _endS;
+		const float span = step.forward ? endS - s : s - endS;
+		if (span >= left) {
+			// The aim is on this edge; the end is further on.
+			if (last && (_endS >= 0.0f || _graph->degree(step.forward ? e.b : e.a) == 1)) {
+				toEnd = travelled + MAX(0.0f, span);
+				const int endNode = step.forward ? e.b : e.a;
+				if (_endS < 0.0f && _graph->isExit(endNode))
+					toEnd = 1e9f;
+			}
+			return _graph->pointAt(step.edge, step.forward ? s + left : s - left);
+		}
+		travelled += MAX(0.0f, span);
+		left -= MAX(0.0f, span);
+		if (last) {
+			const int endNode = step.forward ? e.b : e.a;
+			const RoadGraph::Pt end = _graph->pointAt(step.edge, endS);
+			if (_endS < 0.0f && _graph->isExit(endNode)) {
+				// Off the map: on in the road's direction, the game changes maps.
+				offMap = true;
+				RoadGraph::Pt t = _graph->tangentAt(step.edge, endS);
+				if (!step.forward)
+					t = RoadGraph::Pt(-t.x, -t.y);
+				return RoadGraph::Pt(end.x + t.x * MAX(left, 20.0f), end.y + t.y * MAX(left, 20.0f));
+			}
+			toEnd = travelled;
+			return end;
+		}
+		const RoadGraph::Edge &next = _graph->edges[_plan[i + 1].edge];
+		s = _plan[i + 1].forward ? 0.0f : next.length();
+	}
+	toEnd = 0.0f;
+	return _graph->pointAt(_at.edge, _at.s);
+}
+
+bool RoadDriver::route(const RoadGraph::Spot &from, const RoadGraph::Spot &to) {
+	_plan.clear();
+	_endS = -1.0f;
+	const RoadGraph::Edge &ef = _graph->edges[from.edge];
+	if (from.edge == to.edge) {
+		// Along the same edge (unless round a loop is shorter: not worth it).
+		Step step;
+		step.edge = from.edge;
+		step.forward = to.s >= from.s;
+		_plan.push_back(step);
+		_endS = to.s;
+		return true;
+	}
+	// Dijkstra over the nodes, from both ends of the car's edge.
+	const int n = _graph->nodes.size();
+	Common::Array<float> dist(n);
+	Common::Array<int> viaEdge(n), viaNode(n);
+	Common::Array<bool> done(n);
+	for (int i = 0; i < n; i++) {
+		dist[i] = 1e30f;
+		viaEdge[i] = -1;
+		viaNode[i] = -1;
+		done[i] = false;
+	}
+	dist[ef.a] = from.s;
+	dist[ef.b] = MIN(dist[ef.b], ef.length() - from.s);
+	while (true) {
+		int u = -1;
+		for (int i = 0; i < n; i++)
+			if (!done[i] && dist[i] < 1e29f && (u < 0 || dist[i] < dist[u]))
+				u = i;
+		if (u < 0)
+			break;
+		done[u] = true;
+		for (uint i = 0; i < _graph->edges.size(); i++) {
+			const RoadGraph::Edge &e = _graph->edges[i];
+			if ((int)i == from.edge)
+				continue;
+			for (int way = 0; way < 2; way++) {
+				const int a = way ? e.b : e.a, b = way ? e.a : e.b;
+				if (a != u)
+					continue;
+				const float d = dist[u] + e.length();
+				if (d < dist[b]) {
+					dist[b] = d;
+					viaEdge[b] = i;
+					viaNode[b] = u;
+				}
+			}
+		}
+	}
+	const RoadGraph::Edge &et = _graph->edges[to.edge];
+	const float viaA = dist[et.a] + to.s, viaB = dist[et.b] + et.length() - to.s;
+	if (MIN(viaA, viaB) >= 1e29f)
+		return false;
+	int node = viaA <= viaB ? et.a : et.b;
+	Common::Array<Step> back;
+	Step last;
+	last.edge = to.edge;
+	last.forward = viaA <= viaB;
+	back.push_back(last);
+	while (viaEdge[node] >= 0) {
+		Step step;
+		step.edge = viaEdge[node];
+		step.forward = _graph->edges[step.edge].b == node && _graph->edges[step.edge].a == viaNode[node];
+		if (_graph->edges[step.edge].a == _graph->edges[step.edge].b)
+			step.forward = true;
+		back.push_back(step);
+		node = viaNode[node];
+	}
+	// node is now an end of the car's edge.
+	Step first;
+	first.edge = from.edge;
+	first.forward = node == ef.b;
+	back.push_back(first);
+	for (int i = back.size() - 1; i >= 0; i--)
+		_plan.push_back(back[i]);
+	_endS = to.s;
+	return true;
+}
+
+RoadGraph::Spot RoadDriver::clickTarget(const Common::Point &pos, bool &offMap, const char *&why) {
+	offMap = false;
+	const Common::Rect map = mapRect();
+	// Near an edge of the map: off the map that way, through the nearest
+	// road leaving it on that side.
+	const int toLeft = pos.x - map.left, toRight = map.right - pos.x, toTop = pos.y - map.top, toBottom = map.bottom - pos.y;
+	const int nearest = MIN(MIN(toLeft, toRight), MIN(toTop, toBottom));
+	if (nearest < 40) {
+		int best = -1;
+		float bestD = 160.0f;
+		for (uint n = 0; n < _graph->nodes.size(); n++) {
+			if (!_graph->isExit(n))
+				continue;
+			const RoadGraph::Pt &p = _graph->nodes[n];
+			const bool side = (nearest == toLeft && p.x < map.left + 16) || (nearest == toRight && p.x > map.right - 16) ||
+				(nearest == toTop && p.y < map.top + 16) || (nearest == toBottom && p.y > map.bottom - 16);
+			const float d = sqrtf((p.x - pos.x) * (p.x - pos.x) + (p.y - pos.y) * (p.y - pos.y));
+			if (side && d < bestD) {
+				bestD = d;
+				best = n;
+			}
+		}
+		if (best >= 0) {
+			for (uint i = 0; i < _graph->edges.size(); i++) {
+				const RoadGraph::Edge &e = _graph->edges[i];
+				if (e.a == best || e.b == best) {
+					RoadGraph::Spot spot;
+					spot.edge = i;
+					spot.s = e.a == best ? 0.0f : e.length();
+					offMap = true;
+					why = "off the map";
+					return spot;
+				}
+			}
+		}
+	}
+	// On a road: that place.
+	RoadGraph::Spot onRoad = _graph->nearest(pos.x, pos.y);
+	if (onRoad.valid() && onRoad.dist < 12.0f)
+		return onRoad;
+	// By a place to go (a house, the petrol pump): into it. The game starts it
+	// when the car comes near its point, which is on the road.
+	RoadGraph::Pt place;
+	if (placeNear(pos, place)) {
+		why = "a place";
+		return _graph->nearest(place.x, place.y);
+	}
+	return onRoad;
+}
+
+bool RoadDriver::placeNear(const Common::Point &pos, RoadGraph::Pt &place) {
+	// Dir's objects: the map's destinations and the like, as the game made
+	// them for this map (Dir.goThroughObjects).
+	Datum dir = g_lingo->_globalvars.getValOrDefault("gDir");
+	if (dir.type != OBJECT || !dir.u.obj->hasProp("objects"))
+		return false;
+	Datum objects = dir.u.obj->getProp("objects");
+	if (objects.type != ARRAY)
+		return false;
+	float bestD = 70.0f;
+	bool found = false;
+	for (auto &o : objects.u.farr->arr) {
+		if (o.type != OBJECT || !o.u.obj->hasProp("type") || !o.u.obj->hasProp("myLoc"))
+			continue;
+		AbstractObject *obj = o.u.obj;
+		Datum type = obj->getProp("type");
+		if (type.type != SYMBOL)
+			continue;
+		bool go = type.u.s->equalsIgnoreCase("dest") || type.u.s->equalsIgnoreCase("rdest");
+		if (type.u.s->equalsIgnoreCase("custom") && obj->hasProp("customObject")) {
+			const Common::String custom = obj->getProp("customObject").asString();
+			go = custom.equalsIgnoreCase("Gas") || custom.equalsIgnoreCase("Racing") || custom.equalsIgnoreCase("Ferry");
+		}
+		Datum loc = obj->getProp("myLoc");
+		if (!go || loc.type != POINT || loc.u.farr->arr.size() < 2)
+			continue;
+		const float x = loc.u.farr->arr[0].asInt(), y = loc.u.farr->arr[1].asInt();
+		const float d = sqrtf((x - pos.x) * (x - pos.x) + (y - pos.y) * (y - pos.y));
+		if (d < bestD) {
+			bestD = d;
+			place = RoadGraph::Pt(x, y);
+			found = true;
+		}
+	}
+	return found;
+}
+
+bool RoadDriver::mouseDown(const Common::Point &pos, bool driving) {
+	if (!_enabled || !driving || !_graph || !mapRect().contains(pos))
+		return false;
+	_mouseHeld = true;
+	_mouseDownPos = pos;
+	_mouseDownTime = g_system->getMillis();
+	return true;
+}
+
+bool RoadDriver::mouseUp(const Common::Point &pos) {
+	if (!_mouseHeld)
+		return false;
+	_mouseHeld = false;
+	const uint32 held = g_system->getMillis() - _mouseDownTime;
+	const int moved = ABS(pos.x - _mouseDownPos.x) + ABS(pos.y - _mouseDownPos.y);
+	if (held < 400 && moved < 12 && _graph && _at.valid()) {
+		// A click anywhere on the map: there along the roads (user,
+		// 2026-10-14: "you should be able to click anywhere and have the car
+		// drive to the closest road point. otherwise its too hard to go to
+		// drive to the edge and to another screen or to any house").
+		bool offMap = false;
+		const char *why = "the nearest road";
+		RoadGraph::Spot target = clickTarget(pos, offMap, why);
+		if (target.valid() && route(_at, target)) {
+			_mode = kRoute;
+			_clicked = target;
+			_exitRun = offMap;
+			if (offMap)
+				_endS = -1.0f;	// on past the end, off the map
+			_committed = false;
+			_stuck = false;
+			_stuckSince = 0;
+			debugC(1, kDebugEvents, "RoadDriver: click at %d,%d: %s (edge %d at %.0f), %d steps", pos.x, pos.y, why, target.edge, target.s, _plan.size());
+			return true;
+		}
+		debugC(1, kDebugEvents, "RoadDriver: no way to %d,%d", pos.x, pos.y);
+	}
+	// Let go after holding: stop.
+	stop();
+	return true;
+}
+
+bool RoadDriver::update(AbstractObject *car, float stickX, float stickY, bool go, Command &cmd) {
+	cmd = Command();
+	if (!_enabled)
+		return false;
+	RoadGraph *graph = graphFor(car);
+	if (!graph || graph->empty())
+		return false;
+
+	// The car: where its wheels are (the terrain's place), its heading and speed.
+	if (!car->hasProp("coordinate"))
+		return false;
+	Datum coord = car->getProp("coordinate");
+	if (coord.type != POINT || coord.u.farr->arr.size() < 2)
+		return false;
+	_car = RoadGraph::Pt(coord.u.farr->arr[0].asInt() / 100.0f, coord.u.farr->arr[1].asInt() / 100.0f);
+	const int heading = propInt(car, "direction", 16);
+	const int speed = propInt(car, "speed");	// hundredths of a pixel a frame
+	const int altitude = propInt(car, "altitude");
+
+	// What the player asks for.
+	RoadGraph::Pt want;
+	bool asked = false;
+	if (stickX * stickX + stickY * stickY > 0.35f * 0.35f) {
+		want = unit(stickX, stickY);
+		asked = true;
+	} else if (_mouseHeld) {
+		const Common::Point m = _vm->_lastMousePos;
+		const float dx = m.x - _car.x, dy = m.y - (_car.y - 3.0f * altitude);
+		if (dx * dx + dy * dy > 12.0f * 12.0f) {
+			want = unit(dx, dy);
+			asked = true;
+		}
+	} else if (go) {
+		// A alone: on the way the car points.
+		const float a = heading * 2.0f * (float)M_PI / 16.0f;
+		want = RoadGraph::Pt(sinf(a), -cosf(a));
+		asked = true;
+	}
+	if (asked) {
+		if (_mode != kDirection) {
+			_plan.clear();
+			_endS = -1.0f;
+			_committed = false;
+			_stuckSince = 0;
+		}
+		_mode = kDirection;
+		_dir = want;
+	} else if (_mode == kDirection) {
+		// Let go: stop.
+		stop();
+	}
+	if (_mode == kStopping) {
+		if (speed > 0) {
+			cmd.brake = true;
+			return true;
+		}
+		_mode = kIdle;
+	}
+	// Where it is on the roads (also while idle: a click starts from there).
+	RoadGraph::Spot spot;
+	if (!locate(_car.x, _car.y, spot)) {
+		_at = RoadGraph::Spot();
+		return false;
+	}
+	_at = spot;
+	if (_arriving) {
+		// Come into this map off the last one: on along the road, away from
+		// the edge, a little way, and stop.
+		_arriving = false;
+		const RoadGraph::Edge &e = graph->edges[_at.edge];
+		const float a = heading * 2.0f * (float)M_PI / 16.0f;
+		Step step;
+		step.edge = _at.edge;
+		step.forward = dot(graph->tangentAt(_at.edge, _at.s), RoadGraph::Pt(sinf(a), -cosf(a))) >= 0.0f;
+		_plan.clear();
+		_plan.push_back(step);
+		// "It should move a little bit into the other screen, just so that we
+		// can easily move back if we want" (user, 2026-10-14).
+		_endS = step.forward ? MIN(e.length(), _at.s + 48.0f) : MAX(0.0f, _at.s - 48.0f);
+		_clicked = _at;
+		_clicked.s = _endS;
+		_mode = kRoute;
+		debugC(1, kDebugEvents, "RoadDriver: on into the new map, to %.0f on edge %d", _endS, _at.edge);
+	}
+	if (_mode == kIdle)
+		return false;
+
+	if (_mode == kRoute) {
+		// Off the plan (the game moved the car: a ferry, a hit): again from here.
+		bool onPlan = false;
+		for (uint i = 0; i < _plan.size(); i++) {
+			if (_plan[i].edge == _at.edge) {
+				for (uint k = 0; k < i; k++)
+					_plan.remove_at(0);
+				onPlan = true;
+				break;
+			}
+		}
+		if (!onPlan && !route(_at, _clicked)) {
+			reset();
+			return false;
+		}
+	} else {
+		// The edge it is on, and which way along it.
+		const RoadGraph::Pt t = graph->tangentAt(_at.edge, _at.s);
+		bool found = false;
+		for (uint i = 0; i < _plan.size(); i++) {
+			if (_plan[i].edge == _at.edge) {
+				if (i > 0) {
+					for (uint k = 0; k < i; k++)
+						_plan.remove_at(0);
+					// Past a junction: the way on was chosen for this direction.
+					_choiceDir = _committed ? _committedDir : _dir;
+					_committed = false;
+				}
+				found = true;
+				break;
+			}
+		}
+		if (found) {
+			// Turn round when the stick points back against the way and the
+			// player moved it since the way was chosen (a wrong turn at a
+			// junction); not where the road only bends back, the stick held
+			// still (the car would turn there for ever).
+			const float along = dot(t, _dir) * (_plan[0].forward ? 1.0f : -1.0f);
+			if (along < -0.5f && dot(_dir, _choiceDir) < 0.9f) {
+				debugC(2, kDebugEvents, "RoadDriver: turning round on edge %d", _at.edge);
+				_plan.clear();
+				found = false;
+			}
+		}
+		if (!found) {
+			_plan.clear();
+			_committed = false;
+			_choiceDir = _dir;
+			float along = dot(t, _dir);
+			if (fabsf(along) < 0.2f) {
+				// Across the road: the way the car points decides.
+				const float a = heading * 2.0f * (float)M_PI / 16.0f;
+				along = dot(t, RoadGraph::Pt(sinf(a), -cosf(a)));
+			}
+			Step step;
+			step.edge = _at.edge;
+			step.forward = along >= 0.0f;
+			_plan.push_back(step);
+		}
+		// The branch at the next junction: chosen anew while the junction is
+		// far, kept once near (or it would flip as the car turns), unless the
+		// direction asked changes a lot.
+		const Step &cur = _plan[0];
+		const RoadGraph::Edge &e = graph->edges[cur.edge];
+		const float toNode = cur.forward ? e.length() - _at.s : _at.s;
+		if (_committed && dot(_committedDir, _dir) < 0.7f)
+			_committed = false;
+		if (!_committed || toNode > 30.0f) {
+			_plan.resize(1);
+			_committed = toNode <= 30.0f;
+			_committedDir = _dir;
+		}
+	}
+
+	// Look ahead along the plan, choosing branches on the way as needed.
+	const float v = ABS(speed) / 100.0f;	// pixels a frame
+	const float ahead = CLIP(16.0f + 2.5f * v, 16.0f, 60.0f);
+	float toEnd;
+	bool offMap;
+	RoadGraph::Pt aim = aimAhead(ahead, toEnd, offMap);
+	if (_mode == kDirection) {
+		for (int i = 0; i < 4 && toEnd < ahead && !offMap; i++) {
+			if (!extendPlan(_dir))
+				break;
+			aim = aimAhead(ahead, toEnd, offMap);
+		}
+	}
+	_aim = aim;
+
+	// Steer for the aim; gas while it is ahead and the end is far.
+	const float dx = aim.x - _car.x, dy = aim.y - _car.y;
+	float diff = headingOf(dx, dy) - heading;
+	while (diff > 8.0f)
+		diff -= 16.0f;
+	while (diff <= -8.0f)
+		diff += 16.0f;
+	cmd.steer = dx * dx + dy * dy > 4.0f;
+	cmd.heading = headingOf(dx, dy);
+
+	// The brakes take the car's #break a frame (CarDriving.convertCarProps:
+	// stat * 30 hundredths).
+	int brakeRate = 90;
+	if (car->hasProp("quickCarProps")) {
+		Datum props = car->getProp("quickCarProps");
+		if (props.type == PARRAY) {
+			for (auto &cell : props.u.parr->arr) {
+				if (cell.p.type == SYMBOL && cell.p.u.s->equalsIgnoreCase("break") && cell.v.asInt() > 0)
+					brakeRate = cell.v.asInt();
+			}
+		}
+	}
+	const float stopping = v * v * 100.0f / (2.0f * brakeRate) + v + 2.0f;
+	const bool arriving = toEnd < 1e8f && toEnd <= stopping;
+	// There (stopped within a car's length: inching closer, the car would
+	// overshoot, brake, and inch back).
+	if (arriving && toEnd < 8.0f && speed == 0 && _mode == kRoute) {
+		debugC(1, kDebugEvents, "RoadDriver: there");
+		reset();
+		return false;
+	}
+	cmd.gas = !arriving && ABS(diff) < 2.5f && !_stuck;
+	cmd.brake = (arriving && speed > 0) || (ABS(diff) >= 4.0f && speed > 300);
+	if (arriving && toEnd < 6.0f)
+		cmd.steer = false;
+
+	// Stuck (a hill too steep for this car, something in the way): stop trying
+	// until the player asks for something else.
+	if (cmd.gas && speed == 0) {
+		const uint32 now = g_system->getMillis();
+		if (!_stuckSince || fabsf(_stuckAt.x - _car.x) + fabsf(_stuckAt.y - _car.y) > 3.0f) {
+			_stuckSince = now;
+			_stuckAt = _car;
+		} else if (now - _stuckSince > 1500) {
+			_stuck = true;
+			_stuckDir = _dir;
+			cmd.gas = false;
+			debugC(1, kDebugEvents, "RoadDriver: stuck at %.0f,%.0f", _car.x, _car.y);
+		}
+	} else if (speed != 0) {
+		_stuckSince = 0;
+	}
+	if (_stuck && (_mode == kDirection ? dot(_stuckDir, _dir) < 0.7f : false))
+		_stuck = false;
+	return true;
+}
+
+void RoadDriver::drawDebug(Graphics::ManagedSurface &screen, int scale, const Common::Rect &clip) {
+	if (!_graph)
+		return;
+	const Graphics::PixelFormat &f = screen.format;
+	const uint32 white = f.RGBToColor(255, 255, 255), red = f.RGBToColor(230, 0, 0), yellow = f.RGBToColor(255, 220, 0);
+	const uint32 blue = f.RGBToColor(40, 120, 255), green = f.RGBToColor(0, 220, 80), magenta = f.RGBToColor(255, 0, 255);
+	const uint32 cyan = f.RGBToColor(0, 230, 230), black = f.RGBToColor(0, 0, 0);
+	auto line = [&](const RoadGraph::Pt &p, const RoadGraph::Pt &q, uint32 c, int width) {
+		for (int o = -(width / 2); o <= width / 2; o++) {
+			const int x0 = p.x * scale, y0 = p.y * scale, x1 = q.x * scale, y1 = q.y * scale;
+			if (ABS(x1 - x0) > ABS(y1 - y0))
+				screen.drawLine(x0, y0 + o, x1, y1 + o, c);
+			else
+				screen.drawLine(x0 + o, y0, x1 + o, y1, c);
+		}
+	};
+	auto dotAt = [&](const RoadGraph::Pt &p, uint32 c, int r) {
+		Common::Rect box(p.x * scale - r - 1, p.y * scale - r - 1, p.x * scale + r + 2, p.y * scale + r + 2);
+		box.clip(clip);
+		if (!box.isEmpty())
+			screen.fillRect(box, black);
+		box = Common::Rect(p.x * scale - r, p.y * scale - r, p.x * scale + r + 1, p.y * scale + r + 1);
+		box.clip(clip);
+		if (!box.isEmpty())
+			screen.fillRect(box, c);
+	};
+	for (auto &e : _graph->edges)
+		for (uint i = 1; i < e.path.size(); i++)
+			line(e.path[i - 1], e.path[i], black, scale + 2);
+	for (auto &e : _graph->edges)
+		for (uint i = 1; i < e.path.size(); i++)
+			line(e.path[i - 1], e.path[i], white, MAX(1, scale - 2));
+	// The plan, from the car on.
+	if (_mode != kIdle && _at.valid()) {
+		float s = _at.s;
+		for (uint i = 0; i < _plan.size(); i++) {
+			const RoadGraph::Edge &e = _graph->edges[_plan[i].edge];
+			const bool last = i + 1 == _plan.size();
+			const float end = last && _endS >= 0.0f ? _endS : (_plan[i].forward ? e.length() : 0.0f);
+			const float step = _plan[i].forward ? 3.0f : -3.0f;
+			RoadGraph::Pt prev = _graph->pointAt(_plan[i].edge, s);
+			for (float t = s + step; _plan[i].forward ? t < end : t > end; t += step) {
+				const RoadGraph::Pt p = _graph->pointAt(_plan[i].edge, t);
+				line(prev, p, green, scale + 2);
+				prev = p;
+			}
+			line(prev, _graph->pointAt(_plan[i].edge, end), green, scale + 2);
+			if (!last)
+				s = _plan[i + 1].forward ? 0.0f : _graph->edges[_plan[i + 1].edge].length();
+		}
+		dotAt(_aim, magenta, 2 * scale);
+		dotAt(_graph->pointAt(_at.edge, _at.s), cyan, scale + 1);
+	}
+	for (uint n = 0; n < _graph->nodes.size(); n++) {
+		const int d = _graph->degree(n);
+		dotAt(_graph->nodes[n], _graph->isExit(n) ? blue : d == 1 ? yellow : red, 2 * scale);
+	}
+	dotAt(_car, white, scale);
+}
+
+} // End of namespace Director
