+// D7+ sprite rotation: turns `in` (the picture in the box `inBox`) by
+// `degrees` clockwise into `out` (the box `outBox`); both boxes are relative
+// to the registration point. Nearest pixel; white where the picture is not,
+// which the background-transparent and matte inks leave out.
+static void rotateSurface(const Graphics::Surface *in, const Common::Rect &inBox, Graphics::Surface *out, const Common::Rect &outBox, double degrees, uint32 white) {
+	const int bpp = out->format.bytesPerPixel;
+	const double a = degrees * M_PI / 180.0, c = cos(a), s = sin(a);
+	for (int y = 0; y < out->h; y++) {
+		for (int x = 0; x < out->w; x++) {
+			const double px = outBox.left + x + 0.5, py = outBox.top + y + 0.5;
+			const int sx = (int)floor(px * c + py * s - inBox.left);
+			const int sy = (int)floor(-px * s + py * c - inBox.top);
+			byte *dst = (byte *)out->getBasePtr(x, y);
+			if (sx >= 0 && sy >= 0 && sx < in->w && sy < in->h)
+				memcpy(dst, in->getBasePtr(sx, sy), bpp);
+			else if (bpp == 1)
+				*dst = (byte)white;
+			else if (bpp == 2)
+				*(uint16 *)dst = (uint16)white;
+			else
+				*(uint32 *)dst = white;
+		}
+	}
+}
