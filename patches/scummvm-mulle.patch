+
+void GameMenu::run(bool askQuit) {
+	_done = false;
+	_pressed = -1;
+	_heldButtons = 0;
+	_heldDx = _heldDy = 0;
+	_toast.clear();
+	_toastUntil = 0;
+	grabGame();
+
+	// Only the menu's keymap while it is open: the game's maps A to a click and
+	// Escape to opening this menu.
+	Common::Keymapper *keymapper = g_system->getEventManager()->getKeymapper();
+	static const char *const gameKeymaps[] = { "director-garygadget", "director-garygadget-driving" };
+	bool wasEnabled[ARRAYSIZE(gameKeymaps)];
+	for (uint i = 0; i < ARRAYSIZE(gameKeymaps); i++) {
+		Common::Keymap *map = keymapper->getKeymap(gameKeymaps[i]);
+		wasEnabled[i] = map && map->isEnabled();
+		if (map)
+			map->setEnabled(false);
+	}
+	Common::Keymap *menuKeymap = keymapper->getKeymap("director-garygadget-menu");
+	if (menuKeymap)
+		menuKeymap->setEnabled(true);
+
+	bool mouseWasShown = CursorMan.showMouse(true);
+	g_system->showOverlay(true);
+	_ow = _oh = 0;
+	_askedQuit = askQuit;
+	if (askQuit) {
+		_confirm = kConfirmQuit;
+		_confirmFrom = kPageMain;
+		showPage(kPageConfirm, 1);
+	} else {
+		showPage(kPageMain);
+	}
+
+	while (!_done && !Engine::shouldQuit()) {
+		if (g_system->getOverlayWidth() != _ow || g_system->getOverlayHeight() != _oh)
+			layout();
+
+		Common::Event event;
+		while (!_done && g_system->getEventManager()->pollEvent(event))
+			handleEvent(event);
+
+		const uint32 now = g_system->getMillis();
+		if ((_heldDx || _heldDy) && now >= _nextRepeat) {
+			move(_heldDx, _heldDy);
+			_nextRepeat = now + kRepeatRate;
+		}
+		if (_toastUntil && now >= _toastUntil) {
+			_toastUntil = 0;
+			_toast.clear();
+			_dirty = true;
+		}
+		if (_done)
+			break;
+		if (_dirty)
+			draw();
+		g_system->updateScreen();
+		g_system->delayMillis(10);
+	}
+
+	g_system->hideOverlay();
+	CursorMan.showMouse(mouseWasShown);
+
+	// The button that closed the menu is still down: wait for its release
+	// here, or the game's keymap would turn it into a click (A) or a key.
+	const uint32 waitUntil = g_system->getMillis() + 500;
+	while (_heldButtons && g_system->getMillis() < waitUntil && !Engine::shouldQuit()) {
+		Common::Event event;
+		while (g_system->getEventManager()->pollEvent(event)) {
+			if (event.type == Common::EVENT_CUSTOM_ENGINE_ACTION_END && event.customType >= kActionMenuSelect && event.customType <= kActionMenuClose)
+				_heldButtons &= ~(1 << (event.customType - kActionMenuSelect));
+		}
+		g_system->updateScreen();
+		g_system->delayMillis(10);
+	}
+
+	if (menuKeymap)
+		menuKeymap->setEnabled(false);
+	for (uint i = 0; i < ARRAYSIZE(gameKeymaps); i++) {
+		Common::Keymap *map = keymapper->getKeymap(gameKeymaps[i]);
+		if (map)
+			map->setEnabled(wasEnabled[i]);
+	}
+
+	_game.free();
+	_background.free();
+	_canvas.free();
+	for (auto &slot : _slots) {
+		slot.thumb.free();
+		slot.scaled.free();
+	}
+	freeFonts();
+}
