+
+		static const struct { const char *id; const char *desc; const char *input; KeyCode key; } dpad[] = {
+			{ "DPADUP", _s("Up arrow"), "JOY_UP", KEYCODE_UP },
+			{ "DPADDOWN", _s("Down arrow"), "JOY_DOWN", KEYCODE_DOWN },
+			{ "DPADLEFT", _s("Left arrow"), "JOY_LEFT", KEYCODE_LEFT },
+			{ "DPADRIGHT", _s("Right arrow"), "JOY_RIGHT", KEYCODE_RIGHT },
