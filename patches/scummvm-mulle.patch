+static const uint32 kInk = 0x4A2E17;
+static const uint32 kPaper = 0xFFF3D6;
+static const uint32 kButton = 0xF2D49B;
+static const uint32 kButtonFocus = 0xFFC531;
+static const uint32 kDisabledFill = 0xE9DFC9;
+static const uint32 kDisabledInk = 0xA8977C;
+static const uint32 kToastFill = 0x3E9A3E;
+static const uint32 kWhite = 0xFFFFFF;
+static const uint32 kPadA = 0x3DAA4A;
+static const uint32 kPadB = 0xD9443A;
+
+// Text sizes, layout units
+static const int kTitleSize = 30;
+static const int kButtonSize = 24;
+static const int kCaptionSize = 15;
+static const int kHintSize = 16;
