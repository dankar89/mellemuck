+// The Mulle Meck / Gary Gadget games keep all progress in the MulleGlobals object
+// and write it, as text, to their "data" cast only at a few points (quitting, the
+// car album, choosing a player). This enables autosaves and ScummVM save games:
+// sync with the game's own save routine, and on load re-read the cast, log the
+// player back in and continue in the garage (movie "03"; "10" is the player
+// selection, used when no player was logged in). Saves are per player: a save
+// keeps and restores only that player's "User<id>DB" member.
+static void quirkMulleMeckSaves() {
+	g_director->_saveSupport.castName = "data";
+	g_director->_saveSupport.syncLingo =
+		"global gMulleGlobals\n"
+		"if objectp(gMulleGlobals) then save(gMulleGlobals)";
+	g_director->_saveSupport.userLingo =
+		"global gMulleGlobals\n"
+		"if objectp(gMulleGlobals) then\n"
+		"  if objectp(the user of gMulleGlobals) then return the userId of the user of gMulleGlobals\n"
+		"end if\n"
+		"return EMPTY";
+	g_director->_saveSupport.loadLingo =
+		"global gMulleGlobals, gSound\n"
+		"if objectp(gSound) then stopAllEffects(gSound)\n"
+		"allFromList(gMulleGlobals)\n"
+		"if {user} = EMPTY then\n"
+		"  go(1, \"10\")\n"
+		"else\n"
+		"  login(the users of gMulleGlobals, {user})\n"
+		"  set the WhereFrom of gMulleGlobals to \"10\"\n"
+		"  go(1, \"03\")\n"
+		"end if";
+	// Each player's progress is one member (Users.login, MulleGlobals.save).
+	g_director->_saveSupport.playerMember = "User{user}DB";
