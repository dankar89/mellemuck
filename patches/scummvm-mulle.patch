+void LB::b_keyPressed(int nargs) {
+	Datum key = g_lingo->pop();
+	bool down = false;
+	for (auto held : g_director->_keysDown) {
+		if (key.type == INT || key.type == FLOAT) {
+			down = g_director->_KeyCodes.contains(held) && g_director->_KeyCodes[held] == key.asInt();
+		} else {
+			Common::String s = key.asString();
+			down = !s.empty() && held < 128 && tolower(s[0]) == tolower((int)held);
+		}
+		if (down)
+			break;
+	}
+	g_lingo->push(Datum(down ? 1 : 0));
+}
