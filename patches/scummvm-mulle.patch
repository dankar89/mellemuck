+Score::CursorSpriteKey Score::cursorSpriteKey(int channelId) {
+	Channel *channel = _channels[channelId];
+	Common::Rect bbox = channel->getBbox();
+	CursorSpriteKey key;
+	key.member = channel->_sprite->_castId;
+	key.surface = channel->_widget;
+	key.ink = channel->_sprite->_ink;
+	key.backColor = channel->_sprite->getBackColor();
+	key.foreColor = channel->_sprite->getForeColor();
+	key.width = bbox.width();
+	key.height = bbox.height();
+	key.hotspot = channel->getPosition() - Common::Point(bbox.left, bbox.top);
+	return key;
+}
