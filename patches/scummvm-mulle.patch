+	if (ca->_indexed && cb->_indexed)
+		return ca->_index == cb->_index;
+	byte r1, g1, b1, r2, g2, b2;
+	ca->toRGB(r1, g1, b1);
+	cb->toRGB(r2, g2, b2);
+	return r1 == r2 && g1 == g2 && b1 == b2;
