+
+		act = new Action(kStandardActionLeftClick, _("Left click"));
+		act->setLeftClickEvent();
+		act->addDefaultInputMapping("MOUSE_LEFT");
+		driving->addAction(act);
+
+		act = new Action(kStandardActionRightClick, _("Right click"));
+		act->setRightClickEvent();
+		act->addDefaultInputMapping("MOUSE_RIGHT");
+		driving->addAction(act);
+
+		act = new Action(kStandardActionOpenMainMenu, _("Game menu"));
+		act->setEvent(EVENT_MAINMENU);
+		act->addDefaultInputMapping("ESCAPE");
+		act->addDefaultInputMapping("F5");
+		driving->addAction(act);
+
+		act = new Action("HDART", _("Toggle HD art"));
+		act->setCustomEngineActionEvent(Director::kActionToggleHDArt);
+		act->addDefaultInputMapping("F6");
+		driving->addAction(act);
+
+		act = new Action("ROADS", _("Show the roads"));
+		act->setCustomEngineActionEvent(Director::kActionToggleRoads);
+		act->addDefaultInputMapping("F7");
+		driving->addAction(act);
+
+		act = new Action("GAS", _("Accelerate"));
+		act->setCustomEngineActionEvent(Director::kActionDriveAccelerate);
+		act->addDefaultInputMapping("JOY_A");
+		act->addDefaultInputMapping("JOY_RIGHT_TRIGGER");
+		driving->addAction(act);
+
+		act = new Action("BRAKE", _("Brake and reverse"));
+		act->setCustomEngineActionEvent(Director::kActionDriveBrake);
+		act->addDefaultInputMapping("JOY_B");
+		act->addDefaultInputMapping("JOY_LEFT_TRIGGER");
+		driving->addAction(act);
+
+		static const struct { const char *id; const char *desc; const char *input; int axis; } stick[] = {
+			{ "STEERLEFT", _s("Point left"), "JOY_LEFT_STICK_X-", Director::kDriveAxisLeft },
+			{ "STEERRIGHT", _s("Point right"), "JOY_LEFT_STICK_X+", Director::kDriveAxisRight },
+			{ "STEERUP", _s("Point up"), "JOY_LEFT_STICK_Y-", Director::kDriveAxisUp },
+			{ "STEERDOWN", _s("Point down"), "JOY_LEFT_STICK_Y+", Director::kDriveAxisDown },
+		};
+		for (auto &s : stick) {
+			act = new Action(s.id, _(s.desc));
+			Event axisEvent;
+			axisEvent.type = EVENT_JOYAXIS_MOTION;
+			axisEvent.joystick.axis = s.axis;
+			act->setEvent(axisEvent);
+			act->addDefaultInputMapping(s.input);
