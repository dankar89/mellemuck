+bool SdlEventSource::axisFromOther(const SDL_Event &ev) {
+	// Sticks only send changes. With two pads, an axis belongs to the pad
+	// that last pushed it well off centre; small values from the other one
+	// (a stick resting a little off centre, past the pointer's dead zone)
+	// are left out. Before, they took the axis whenever the first pad's
+	// stick was back in the middle: on a Steam Deck with an 8BitDo pad the
+	// pointer kept running to the screen's right edge (2026-10-14).
+	const int axis = ev.caxis.axis;
+	if (axis < 0 || axis >= SDL_CONTROLLER_AXIS_MAX)
+		return false;
+	const int offCentre = ABS((int)ev.caxis.value);	// not "far": a macro on Windows
+	const int kCentre = 8000;
+	logPadAxis(ev, offCentre);
+	if (_otherControllers.empty())
+		return false;
+	if (offCentre >= kCentre) {
+		_axisOwner[axis] = ev.caxis.which;
+		_axisOwned[axis] = true;
+	} else if (!_axisOwned[axis]) {
+		// Nobody has pushed it yet: only values that move nothing.
+		if (offCentre >= 3000)
+			return true;
+	} else if (_axisOwner[axis] != ev.caxis.which) {
+		return true;
+	}
+	_axisFar[axis] = offCentre;
+	return false;
+}
+
+// For finding faults with several pads (the Steam Deck's log): each pad when
+// opened, its buttons, and its sticks and triggers passing a third and a
+// quarter of the way out. One line each, not every movement.
+void SdlEventSource::logPadAxis(const SDL_Event &ev, int offCentre) {
+	const int axis = ev.caxis.axis;
+	const int level = offCentre >= 8000 ? 2 : offCentre >= 3000 ? 1 : 0;
+	const uint32 key = (uint32)ev.caxis.which * SDL_CONTROLLER_AXIS_MAX + axis;
+	if (_padAxisLevel.getValOrDefault(key, 0) == level)
+		return;
+	_padAxisLevel[key] = level;
+	debug("pad %d axis %s %d", (int)ev.caxis.which, SDL_GameControllerGetStringForAxis((SDL_GameControllerAxis)axis), (int)ev.caxis.value);
+}
