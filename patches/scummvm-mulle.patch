+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+
+#include "common/system.h"
+
+#include "director/director.h"
+#include "director/sound.h"
+#include "director/window.h"
+#include "director/lingo/lingo.h"
+#include "director/lingo/lingo-object.h"
+#include "director/lingo/lingo-utils.h"
+#include "director/lingo/xtras/a/amplitude.h"
+
+/**************************************************
+ *
+ * USED IN:
+ * Bygg hus med Mulle Meck (Mulle's mouth follows the loudness of his speech)
+ *
+ **************************************************/
+
+/*
+ * Amplitude Xtra (Amplitude.x32): reports how loud a sound channel is.
+ * ampRegister(company, key) -> 0
+ * obj = new(xtra("Amplitude")); obj.smoothed, obj.resolution, obj.scale
+ * obj.ampSetSound(channel, member) -> 0, obj.ampSetLoopPoints(a, b) -> 0
+ * obj.ampValue: 0..scale, obj.ampGetError() -> a message
+ */
+
+namespace Director {
+
+const char *const AmplitudeXtra::xlibName = "Amplitude";
+const XlibFileDesc AmplitudeXtra::fileNames[] = {
+	{ "amplitude",	nullptr },
+	{ nullptr,		nullptr },
+};
+
+static const MethodProto xlibMethods[] = {
+	{ "new",				AmplitudeXtra::m_new,				0, 0,	700 },
+	{ "ampSetSound",		AmplitudeXtra::m_ampSetSound,		2, 2,	700 },
+	{ "ampSetLoopPoints",	AmplitudeXtra::m_ampSetLoopPoints,	2, 2,	700 },
+	{ "ampGetError",		AmplitudeXtra::m_ampGetError,		0, 0,	700 },
+	{ nullptr, nullptr, 0, 0, 0 }
+};
+
+static const BuiltinProto xlibBuiltins[] = {
+	{ "ampRegister", AmplitudeXtra::m_ampRegister, 2, 2, 700, HBLTIN },
+	{ nullptr, nullptr, 0, 0, 0, VOIDSYM }
+};
+
+AmplitudeXtraObject::AmplitudeXtraObject(ObjectType ObjectType) : Object<AmplitudeXtraObject>("Amplitude") {
+	_objType = ObjectType;
+	_channel = 0;
+	_scale = 100;
+}
+
+bool AmplitudeXtraObject::hasProp(const Common::String &propName) {
+	return propName.equalsIgnoreCase("name") || propName.equalsIgnoreCase("ampValue") ||
+		propName.equalsIgnoreCase("smoothed") || propName.equalsIgnoreCase("resolution") ||
+		propName.equalsIgnoreCase("scale");
+}
+
+Datum AmplitudeXtraObject::getProp(const Common::String &propName) {
+	if (propName.equalsIgnoreCase("name"))
+		return Datum(AmplitudeXtra::xlibName);
+	if (propName.equalsIgnoreCase("ampValue")) {
+		// Not the real loudness: while the channel plays, a level that
+		// changes about every 80 ms and is quiet now and then, so a
+		// speaking character's mouth moves and closes.
+		if (!_channel || !g_director->getCurrentWindow()->getSoundManager()->isChannelActive(_channel))
+			return Datum(0);
+		uint32 step = g_system->getMillis() / 80 + _channel * 7;
+		uint32 h = step * 2654435761u;
+		int level = (h >> 24) % 100;
+		return Datum(level < 15 ? 0 : (level * _scale) / 100);
+	}
+	if (propName.equalsIgnoreCase("scale"))
+		return Datum(_scale);
+	return Datum(0);
+}
+
+void AmplitudeXtraObject::setProp(const Common::String &propName, const Datum &value, bool force) {
+	if (propName.equalsIgnoreCase("scale"))
+		_scale = MAX(1, value.asInt());
+	// smoothed and resolution change nothing here
+}
+
+void AmplitudeXtra::open(ObjectType type, const Common::Path &path) {
+	AmplitudeXtraObject::initMethods(xlibMethods);
+	AmplitudeXtraObject *xobj = new AmplitudeXtraObject(type);
+	if (type == kXtraObj) {
+		g_lingo->_openXtras.push_back(xlibName);
+		g_lingo->_openXtraObjects.push_back(xobj);
+	}
+	g_lingo->exposeXObject(xlibName, xobj);
+	g_lingo->initBuiltIns(xlibBuiltins);
+}
+
+void AmplitudeXtra::close(ObjectType type) {
+	AmplitudeXtraObject::cleanupMethods();
+	g_lingo->_globalvars[xlibName] = Datum();
+}
+
+void AmplitudeXtra::m_new(int nargs) {
+	// One object per sound channel: each new() is its own.
+	g_lingo->push(Datum(new AmplitudeXtraObject(kXtraObj)));
+}
+
+void AmplitudeXtra::m_ampRegister(int nargs) {
+	g_lingo->dropStack(nargs);
+	g_lingo->push(Datum(0));
+}
+
+void AmplitudeXtra::m_ampSetSound(int nargs) {
+	g_lingo->pop();	// the member
+	AmplitudeXtraObject *me = static_cast<AmplitudeXtraObject *>(g_lingo->_state->me.u.obj);
+	me->_channel = g_lingo->pop().asInt();
+	g_lingo->push(Datum(0));
+}
+
+void AmplitudeXtra::m_ampSetLoopPoints(int nargs) {
+	g_lingo->dropStack(nargs);
+	g_lingo->push(Datum(0));
+}
+
+void AmplitudeXtra::m_ampGetError(int nargs) {
+	g_lingo->push(Datum(""));
+}
+
+} // End of namespace Director
