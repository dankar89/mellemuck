+// Builds a page's items in layout units (640x480). The panel behind them is
+// _panel; the hints row sits below it.
+void GameMenu::showPage(Page page, int focus) {
+	_page = page;
+	_items.clear();
+	_pressed = -1;
+	_heldDx = _heldDy = 0;
+	_toast.clear();
+	_toastUntil = 0;
+
+	switch (page) {
+	case kPageMain: {
+		_title = Common::U32String("Paus");
+		const bool fullscreen = g_system->hasFeature(OSystem::kFeatureFullscreenMode);
+		const int count = fullscreen ? 6 : 5;
+		const int buttonH = 44, gap = 10, buttonW = 280;
+		const int panelH = 20 + 52 + count * buttonH + (count - 1) * gap + 24;
+		const int top = MAX(14, (444 - panelH) / 2);
+		_panel = Common::Rect(320 - 170, top, 320 + 170, top + panelH);
+		int y = top + 20 + 52;
+		auto next = [&]() {
+			Common::Rect box(320 - buttonW / 2, y, 320 + buttonW / 2, y + buttonH);
+			y += buttonH + gap;
+			return box;
+		};
+		addItem(kItemContinue, next(), "Fortsätt");
+		// Saves belong to a player: none before one has logged in.
+		const bool player = !_vm->currentPlayerName().empty();
+		addItem(kItemSave, next(), "Spara", player && _vm->canSaveGameStateCurrently());
+		addItem(kItemLoad, next(), "Ladda", player && _vm->canLoadGameStateCurrently());
+		if (fullscreen)
+			addItem(kItemFullscreen, next(), g_system->getFeatureState(OSystem::kFeatureFullscreenMode) ? "Visa i fönster" : "Helskärm");
+		addItem(kItemSettings, next(), "Fler inställningar");
+		addItem(kItemQuit, next(), "Avsluta");
+		break;
+	}
+	case kPageSave:
+	case kPageLoad: {
+		readSlots();
+		const bool saving = page == kPageSave;
+		_title = Common::U32String(saving ? "Spara spelet" : "Ladda ett spel");
+		// Saving: the player's six slots in two rows. Loading: the three
+		// autosaves on top, then the player's slots.
+		const int rows = saving ? 2 : 3;
+		const int cardW = saving ? 176 : 144, cardH = cardW * 3 / 4, gap = saving ? 16 : 12;
+		const int gridW = 3 * cardW + 2 * gap, gridH = rows * cardH + (rows - 1) * gap;
+		const int panelH = 16 + 40 + 14 + gridH + 20;
+		const int panelW = MAX(gridW + 48, 520);
+		const int top = MAX(6, (444 - panelH) / 2);
+		_panel = Common::Rect(320 - panelW / 2, top, 320 + panelW / 2, top + panelH);
+		addItem(kItemBack, Common::Rect(_panel.left + 14, top + 14, _panel.left + 14 + 112, top + 14 + 36), "Tillbaka");
+		const int gridTop = top + 16 + 40 + 14;
+		const int firstSlot = saving ? kFirstManualSlot : 0;
+		// The newer of the two older autosaves first.
+		int order[ARRAYSIZE(_slots)];
+		for (int i = 0; i < ARRAYSIZE(order); i++)
+			order[i] = i;
+		if (_slots[2].when > _slots[1].when)
+			SWAP(order[1], order[2]);
+		for (int i = 0; i < rows * 3; i++) {
+			const int slot = saving ? firstSlot + i : order[i];
+			const int x = 320 - gridW / 2 + (i % 3) * (cardW + gap);
+			const int y = gridTop + (i / 3) * (cardH + gap);
+			addItem(kItemSlot, Common::Rect(x, y, x + cardW, y + cardH), "", saving || _slots[slot].used, slot);
+		}
+		break;
+	}
+	case kPageConfirm: {
+		_title = Common::U32String(_confirm == kConfirmQuit ? "Vill du sluta spela?" : "Spara över det här spelet?");
+		_panel = Common::Rect(320 - 210, 150, 320 + 210, 330);
+		addItem(kItemYes, Common::Rect(320 - 180, 250, 320 - 10, 294), _confirm == kConfirmQuit ? "Ja, sluta" : "Ja, spara");
+		addItem(kItemNo, Common::Rect(320 + 10, 250, 320 + 180, 294), "Nej");
+		break;
+	}
+	}
+
+	// Focus the asked item, or the first that can be chosen.
+	focus = CLIP<int>(focus, 0, (int)_items.size() - 1);
+	if (!_items[focus].enabled) {
+		for (uint i = 0; i < _items.size(); i++) {
+			if (_items[i].enabled && _items[i].id != kItemBack) {
+				focus = i;
+				break;
+			}
+		}
+	}
+	_focus = focus;
+	_dirty = true;
+}
+
+void GameMenu::readSlots() {
+	const MetaEngine *metaEngine = _vm->getMetaEngine();
+	const Common::String target = _vm->getTargetName();
+	// The logged-in player's slots (none yet: all empty).
+	_slotBase = _vm->playerSlotBase(_vm->currentPlayerName(), false);
+	for (int slot = 0; slot < ARRAYSIZE(_slots); slot++) {
+		Slot &s = _slots[slot];
+		s.thumb.free();
+		s.scaled.free();
+		s.when.clear();
+		SaveStateDescriptor desc;
+		if (_slotBase >= 0)
+			desc = metaEngine->querySaveMetaInfos(target.c_str(), _slotBase + slot);
+		s.used = _slotBase >= 0 && desc.getSaveSlot() == _slotBase + slot;
+		if (!s.used) {
+			s.caption = Common::U32String(slot < kFirstManualSlot ? "Tom" : "Tom plats");
+			continue;
+		}
+		s.when = desc.getSaveDate() + " " + desc.getSaveTime();
+		Common::U32String label;
+		if (slot == 0)
+			label = Common::U32String("Senaste · ");
+		else if (slot < kFirstManualSlot && desc.isAutosave())
+			label = Common::U32String("Tidigare · ");
+		s.caption = label + dateCaption(desc);
+		const Graphics::Surface *thumb = desc.getThumbnail();
+		if (thumb) {
+			Graphics::Surface *converted = thumb->convertTo(_format);
+			s.thumb.copyFrom(*converted);
+			converted->free();
+			delete converted;
+		}
+	}
+}
+
+// "idag 14:05", "igår 09:12" or "3 okt 14:05"
+Common::U32String GameMenu::dateCaption(const SaveStateDescriptor &desc) const {
+	int year = 0, month = 0, day = 0;
+	if (sscanf(desc.getSaveDate().c_str(), "%d-%d-%d", &year, &month, &day) != 3)
+		return Common::U32String(desc.getSaveTime());
+	TimeDate now;
+	g_system->getTimeAndDate(now);
+	auto dayNumber = [](int y, int m, int d) {
+		// Days since a fixed point, for "yesterday" across month ends.
+		if (m < 3) {
+			y--;
+			m += 12;
+		}
+		return 365 * y + y / 4 - y / 100 + y / 400 + (153 * (m - 3) + 2) / 5 + d;
+	};
+	const int age = dayNumber(now.tm_year + 1900, now.tm_mon + 1, now.tm_mday) - dayNumber(year, month, day);
+	static const char *const months[] = { "jan", "feb", "mar", "apr", "maj", "jun", "jul", "aug", "sep", "okt", "nov", "dec" };
+	Common::String date;
+	if (age == 0)
+		date = "idag";
+	else if (age == 1)
+		date = "igår";
+	else
+		date = Common::String::format("%d %s", day, months[CLIP(month, 1, 12) - 1]);
+	return Common::U32String(date + " " + desc.getSaveTime());
+}
