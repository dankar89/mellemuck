+// event queue here, as before, swallowed the game's own key events. Mulle Meck's
+// driving reads the arrow keys with bgAllKeys (38 up, 40 down on Windows); the
+// stub returned 0 and the drive stopped with a Lingo error.
 void KeypollXtra::m_bgOneKey(int nargs) {
 	ARGNUMCHECK(1);
-
-	Common::Event event;
-
 	int requestedKey = g_lingo->pop().asInt();
-
-	while (g_system->getEventManager()->pollEvent(event)) {
-		switch (event.type) {
-		case Common::EVENT_KEYDOWN:
