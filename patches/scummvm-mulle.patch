+#include "common/compression/deflate.h"
+#include "common/endian.h"
+
+#include "director/director.h"
+#include "director/archive.h"
+#include "director/cast.h"
+#include "director/castmember/xtra.h"
+#include "director/lingo/lingo-the.h"
+#include "director/lingo/xtras-cast/vlistxtra.h"
+
+namespace Director {
+
+namespace VListXtra {
+
+CastMember *createCastMember(Cast *cast, uint16 castId, XtraCastMember *xtra) {
+	VListCastMember *member = new VListCastMember(cast, castId);
+	member->_children = xtra->_children;
+	return member;
+}
+
+// The XMED resource is a series of blocks, each [u32 length][zlib data]
+// followed by 0-5 bytes of leftover memory; their outputs (96 KB each, the
+// last one shorter) join into one big-endian stream:
+//   16 bytes the Xtra's GUID, u32 7, u32 symbol count, u32 1,
+//   per symbol [00 00 01 03][u32 length with the NUL][name NUL],
+//   one typed value, then zero padding.
+// Typed values: u32 type, then 0 void, 1 integer [i32], 2 symbol [1-based
+// index], 7 list [count, depth, values], 10 property list [count, depth,
+// (key value)*]; depth is the nesting level. Only these occur in Bygg hus's
+// data (worldTemplate in IsoData); tools/vlist.py reads the same format.
+static const byte kGUID[16] = { 0x82, 0x3b, 0x9e, 0x92, 0xa5, 0xd6, 0x11, 0xd4, 0xbf, 0x88, 0x00, 0x50, 0xe4, 0x90, 0x32, 0x1a };
+
+namespace {
+
+struct Reader {
+	const Common::Array<byte> &d;
+	uint32 p;
+	Common::Array<Common::String> symbols;
+	bool ok;
+
+	Reader(const Common::Array<byte> &data) : d(data), p(0), ok(true) {}
+
+	uint32 u32() {
+		if (p + 4 > d.size()) {
+			ok = false;
+			return 0;
+		}
+		uint32 v = READ_BE_UINT32(&d[p]);
+		p += 4;
+		return v;
+	}
+
+	Datum value(int depth) {
+		Datum res;
+		if (!ok || depth > 64) {
+			ok = false;
+			return res;
+		}
+		uint32 type = u32();
+		switch (type) {
+		case 0:
+			break;
+		case 1:
+			res = Datum((int)(int32)u32());
+			break;
+		case 2: {
+			uint32 idx = u32();
+			if (idx < 1 || idx > symbols.size()) {
+				ok = false;
+				break;
+			}
+			res = Datum(symbols[idx - 1]);
+			res.type = SYMBOL;
+			break;
+		}
+		case 7: {
+			uint32 count = u32();
+			u32();	// depth
+			res.type = ARRAY;
+			res.u.farr = new FArray;
+			for (uint32 i = 0; i < count && ok; i++)
+				res.u.farr->arr.push_back(value(depth + 1));
+			break;
+		}
+		case 10: {
+			uint32 count = u32();
+			u32();	// depth
+			res.type = PARRAY;
+			res.u.parr = new PArray;
+			for (uint32 i = 0; i < count && ok; i++) {
+				Datum k = value(depth + 1);
+				Datum v = value(depth + 1);
+				res.u.parr->arr.push_back(PCell(k, v));
+			}
+			break;
+		}
+		default:
+			warning("VListXtra: unknown value type %d at %d", type, p - 4);
+			ok = false;
+			break;
+		}
+		return res;
+	}
+};
+
+} // End of anonymous namespace
+
+bool decodeXMED(const Common::Array<byte> &x, Datum &out) {
+	Common::Array<byte> data;
+	const uint32 kBlock = 1 << 20;
+	Common::Array<byte> buf(kBlock);
+	uint32 p = 0;
+	while (p + 6 <= x.size() && x[p + 4] == 0x78 && x[p + 5] == 0x9c) {
+		uint32 n = READ_BE_UINT32(&x[p]);
+		if (p + 4 + n > x.size())
+			return false;
+		unsigned long len = kBlock;
+		if (!Common::inflateZlib(buf.data(), &len, &x[p + 4], n))
+			return false;
+		for (unsigned long i = 0; i < len; i++)
+			data.push_back(buf[i]);
+		// The next block's length starts with 00 00, its zlib data with 78 9c.
+		uint32 e = p + 4 + n;
+		p = x.size();
+		for (uint32 q = e; q < e + 8 && q + 6 <= x.size(); q++) {
+			if (x[q] == 0 && x[q + 1] == 0 && x[q + 4] == 0x78 && x[q + 5] == 0x9c) {
+				p = q;
+				break;
+			}
+		}
+	}
+	if (data.size() < 28 || memcmp(data.data(), kGUID, 16))
+		return false;
+
+	Reader r(data);
+	r.p = 20;
+	uint32 count = r.u32();
+	r.u32();
+	for (uint32 i = 0; i < count && r.ok; i++) {
+		if (r.p + 8 > data.size() || READ_BE_UINT32(&data[r.p]) != 0x103) {
+			r.ok = false;
+			break;
+		}
+		r.p += 4;
+		uint32 len = r.u32();
+		if (r.p + len > data.size()) {
+			r.ok = false;
+			break;
+		}
+		Common::String name((const char *)&data[r.p], len);
+		r.symbols.push_back(Common::String(name.c_str()));	// up to the NUL
+		r.p += len;
+	}
+	out = r.value(0);
+	return r.ok;
+}
+
+// Lingo literals for the save file: VOID, 12, 1.5, "text" (with \", \\ and
+// \n escaped), #symbol, [1, 2], [#a: 1], [:], point(x, y), rect(l, t, r, b).
+Common::String serialize(const Datum &d) {
+	switch (d.type) {
+	case INT:
+		return Common::String::format("%d", d.u.i);
+	case FLOAT: {
+		Common::String s = Common::String::format("%.17g", d.u.f);
+		if (!s.contains('.') && !s.contains('e') && !s.contains('n') && !s.contains('i'))
+			s += ".0";
+		return s;
+	}
+	case STRING: {
+		Common::String s = "\"";
+		for (const char *c = d.u.s->c_str(); *c; c++) {
+			if (*c == '"' || *c == '\\')
+				s += '\\';
+			if (*c == '\n')
+				s += "\\n";
+			else if (*c == '\r')
+				s += "\\r";
+			else
+				s += *c;
+		}
+		return s + "\"";
+	}
+	case SYMBOL:
+		return "#" + *d.u.s;
+	case ARRAY:
+	case POINT:
+	case RECT: {
+		Common::String s = d.type == POINT ? "point(" : d.type == RECT ? "rect(" : "[";
+		for (uint i = 0; i < d.u.farr->arr.size(); i++)
+			s += (i ? ", " : "") + serialize(d.u.farr->arr[i]);
+		return s + (d.type == ARRAY ? "]" : ")");
+	}
+	case PARRAY: {
+		if (d.u.parr->arr.empty())
+			return "[:]";
+		Common::String s = "[";
+		for (uint i = 0; i < d.u.parr->arr.size(); i++)
+			s += (i ? ", " : "") + serialize(d.u.parr->arr[i].p) + ": " + serialize(d.u.parr->arr[i].v);
+		return s + "]";
+	}
+	case VOID:
+		return "VOID";
+	default:
+		warning("VListXtra::serialize(): cannot save a %s, saving VOID", d.type2str());
+		return "VOID";
+	}
+}
+
+namespace {
+
+struct Parser {
+	const char *s;
+	bool ok;
+
+	Parser(const char *str) : s(str), ok(true) {}
+
+	void ws() {
+		while (*s == ' ' || *s == '\t' || *s == '\n' || *s == '\r')
+			s++;
+	}
+
+	bool eat(char c) {
+		ws();
+		if (*s != c)
+			return false;
+		s++;
+		return true;
+	}
+
+	Datum list(DatumType type, char close) {
+		Datum res;
+		res.type = type;
+		res.u.farr = new FArray;
+		if (eat(close))
+			return res;
+		do {
+			res.u.farr->arr.push_back(value());
+		} while (ok && eat(','));
+		if (!eat(close))
+			ok = false;
+		return res;
+	}
+
+	Datum value() {
+		ws();
+		Datum res;
+		if (!strncmp(s, "VOID", 4)) {
+			s += 4;
+		} else if (*s == '#') {
+			const char *b = ++s;
+			while (Common::isAlnum(*s) || *s == '_')
+				s++;
+			res = Datum(Common::String(b, s));
+			res.type = SYMBOL;
+		} else if (*s == '"') {
+			Common::String str;
+			for (s++; *s && *s != '"'; s++) {
+				if (*s == '\\' && s[1]) {
+					s++;
+					str += *s == 'n' ? '\n' : *s == 'r' ? '\r' : *s;
+				} else {
+					str += *s;
+				}
+			}
+			if (*s != '"')
+				ok = false;
+			else
+				s++;
+			res = Datum(str);
+		} else if (!strncmp(s, "point(", 6)) {
+			s += 6;
+			res = list(POINT, ')');
+		} else if (!strncmp(s, "rect(", 5)) {
+			s += 5;
+			res = list(RECT, ')');
+		} else if (*s == '[') {
+			s++;
+			if (eat(':')) {
+				if (!eat(']'))
+					ok = false;
+				res.type = PARRAY;
+				res.u.parr = new PArray;
+				return res;
+			}
+			if (eat(']')) {
+				res.type = ARRAY;
+				res.u.farr = new FArray;
+				return res;
+			}
+			Datum first = value();
+			if (eat(':')) {
+				res.type = PARRAY;
+				res.u.parr = new PArray;
+				Datum k = first;
+				while (ok) {
+					Datum v = value();
+					res.u.parr->arr.push_back(PCell(k, v));
+					if (!eat(','))
+						break;
+					k = value();
+					if (!eat(':'))
+						ok = false;
+				}
+			} else {
+				res.type = ARRAY;
+				res.u.farr = new FArray;
+				res.u.farr->arr.push_back(first);
+				while (ok && eat(','))
+					res.u.farr->arr.push_back(value());
+			}
+			if (!eat(']'))
+				ok = false;
+		} else if (*s == '-' || Common::isDigit(*s)) {
+			char *end;
+			double f = strtod(s, &end);
+			bool isFloat = false;
+			for (const char *c = s; c < end; c++)
+				isFloat |= (*c == '.' || *c == 'e' || *c == 'E');
+			res = isFloat ? Datum(f) : Datum((int)strtol(s, nullptr, 10));
+			ok = end != s;
+			s = end;
+		} else {
+			ok = false;
+		}
+		return res;
+	}
+};
+
+} // End of anonymous namespace
+
+bool parse(const Common::String &str, Datum &out) {
+	Parser p(str.c_str());
+	out = p.value();
+	p.ws();
+	return p.ok && !*p.s;
+}
+
+} // End of namespace VListXtra
+
+VListCastMember::VListCastMember(Cast *cast, uint16 castId)
+		: CastMember(cast, castId), _compression(0) {
+	_type = kCastXtra;
+}
+
+VListCastMember::VListCastMember(Cast *cast, uint16 castId, VListCastMember &source)
+		: CastMember(cast, castId), _compression(source._compression) {
+	_type = kCastXtra;
+	source.load();
+	_content = source._content.clone();
+	_loaded = true;
+	if (cast == source._cast)
+		_children = source._children;
+}
+
+void VListCastMember::load() {
+	if (_loaded)
+		return;
+	_loaded = true;
+	for (auto &it : _children) {
+		if (it.tag != MKTAG('X', 'M', 'E', 'D'))
+			continue;
+		if (!_cast->getArchive()->hasResource(it.tag, it.index)) {
+			warning("VListCastMember::load(): XMED %d not found", it.index);
+			break;
+		}
+		Common::SeekableReadStreamEndian *r = _cast->getArchive()->getResource(it.tag, it.index);
+		Common::Array<byte> data(r->size());
+		r->read(data.data(), r->size());
+		delete r;
+		if (!VListXtra::decodeXMED(data, _content))
+			warning("VListCastMember::load(): member %d: XMED %d not decoded", _castId, it.index);
+		break;
+	}
+}
+
+Datum VListCastMember::getContent() {
+	load();
+	// A copy, as from the Xtra: Bygg hus changes what it reads from the
+	// house template and must not change the template itself.
+	return _content.clone();
+}
+
+void VListCastMember::setContent(const Datum &value) {
+	_loaded = true;
+	_content = value.clone();
+	setModified(true);
+}
+
+bool VListCastMember::hasProp(const Common::String &propName) {
+	if (propName.equalsIgnoreCase("content") || propName.equalsIgnoreCase("compression"))
+		return true;
+	return CastMember::hasProp(propName);
+}
+
+Datum VListCastMember::getProp(const Common::String &propName) {
+	if (propName.equalsIgnoreCase("content"))
+		return getContent();
+	if (propName.equalsIgnoreCase("compression"))
+		return Datum(_compression);
+	return CastMember::getProp(propName);
+}
+
+void VListCastMember::setProp(const Common::String &propName, const Datum &value, bool force) {
+	if (propName.equalsIgnoreCase("content")) {
+		setContent(value);
+		return;
+	}
+	if (propName.equalsIgnoreCase("compression")) {
+		_compression = value.asInt();
+		return;
+	}
+	CastMember::setProp(propName, value, force);
+}
+
+Datum VListCastMember::getField(int field) {
+	if (field == kTheType || field == kTheCastType) {
+		Datum d(Common::String("vList"));
+		d.type = SYMBOL;
+		return d;
+	}
+	return CastMember::getField(field);
+}
+
+Common::String VListCastMember::formatInfo() {
+	load();
+	Common::String s = VListXtra::serialize(_content);
+	if (s.size() > 200)
+		s = Common::String(s.c_str(), 200) + "...";
+	return "content: " + s;
+}
+
+} // End of namespace Director
