+/**
+ * HD art (Mulle Meck remaster): bitmaps upscaled 3x offline replace the
+ * originals on screen. Scripts, sprites and the classic 8-bit stage keep the
+ * original 640x480 coordinates; the screen shows a 3x full-colour copy of the
+ * stage built from the same sprites (compose()), with the HD image wherever
+ * one exists. Sprites without one are drawn the classic way and scaled up.
+ *
+ * The art lives outside the game (it is derived from it, never shipped):
+ * `hd_path` in scummvm.ini, or a folder `HD` in the game folder, with an
+ * `index.txt` written by the remaster's tools/hd_index.py. Without it the
+ * engine draws as before.
+ *
+ * scummvm.ini: hd_art (show HD art, default true; F6 toggles), hd_sprites
+ * (also sprites, not only backgrounds; default true), hd_cache_mb (decoded
+ * images kept in memory, default 1024).
+ */
+class Cursor;
+
+class HDArt {
+public:
+	static const int kScale = 3;
+
+	HDArt(DirectorEngine *vm);
+	~HDArt();
+
+	// Reads the index. False when there is no HD art.
+	bool init();
+
+	bool artShown() const { return _showArt; }
+	void toggleArt();
+
+	// Sets up the screen for a stage of w x h (original pixels).
+	void initScreen(int w, int h);
+	// Rebuilds part of the screen from the stage's sprites (stage coordinates).
+	void compose(Window *window, const Common::Rect &rect);
+	void composeAll(Window *window);
+	// Copies what changed to the screen (call before updateScreen()).
+	void present();
+	// While on, the screen shows the classic stage scaled up (transitions draw
+	// straight onto the stage).
+	void setPassthrough(bool on);
+	void paletteChanged();
+
+	Common::Point toStage(const Common::Point &screen) const { return Common::Point(screen.x / kScale, screen.y / kScale); }
+	// Shows a cursor drawn at original size (keyColor marks transparency).
+	void setCursor(const Graphics::ManagedSurface &cursor, uint32 keyColor, int hotX, int hotY);
+	// Shows a cast member's HD image as the cursor (hotspot in the member's
+	// original pixels); false without one.
+	bool setMemberCursor(Movie *movie, CastMemberID id, Common::Point hotspot);
+	// After the window manager set a cursor: its HD version, if there is one
+	// (the game's pointer art for built-in cursors, our driving arrow).
+	void cursorChanged(int type, Cursor *cursor);
+
+private:
+	enum { kVariantCopy, kVariantMatte, kVariantBgTrans, kVariantCount };
+	struct Entry {
+		bool background = false;
+		Common::String file[kVariantCount];
+	};
+	struct Image {
+		Graphics::ManagedSurface *surface = nullptr;
+		uint32 lastUse = 0;
+		uint32 bytes = 0;
+	};
+
+	// A window other than the stage (a movie in a window, e.g. Bygger bilar's
+	// file dialog over the album) is composed onto its own 3x layer, shown
+	// over the stage at the window's place.
+	struct Layer {
+		Window *window = nullptr;
+		Graphics::ManagedSurface surface;
+		Common::Rect dirty;	// layer coordinates
+	};
+	Layer *layerFor(Window *window);
+	// Where compose() draws a window: the screen for the stage, else its layer.
+	Graphics::ManagedSurface *targetFor(Window *window, Common::Rect *&dirty);
+
+	// whiteBehind: the image is a transparent variant standing in for copy
+	// ink, to be drawn over white.
+	Graphics::ManagedSurface *imageFor(Movie *movie, Channel *channel, bool *whiteBehind = nullptr);
+	Graphics::ManagedSurface *load(const Common::String &file);
+	void evict();
+	Common::String castStem(Movie *movie, int castLib);
+	static Common::String safeName(const Common::String &name);
+	void noteClassic(Movie *movie, Channel *ch);
+	Graphics::ManagedSurface *memberImage(Movie *movie, CastMemberID id);
+	void setArrowCursor(int heading);
+	Graphics::ManagedSurface _arrows[16];	// our driving arrows, made when first shown
