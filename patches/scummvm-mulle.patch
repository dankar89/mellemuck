+		// Its HD image where there is one (Mulle's glove), else its pixels 3x.
+		if (!_vm->_hd->setMemberCursor(_movie, key.member, Common::Point(hotX, hotY)))
+			_vm->_hd->setCursor(drawn[0], keyColor, hotX, hotY);	// full colour, 3x
+	} else {
+		CursorMan.replaceCursor(drawn[0].rawSurface(), hotX, hotY, keyColor);
+		if (format.isCLUT8())
+			CursorMan.replaceCursorPalette(nullptr, 0, 0);	// use the screen's palette
+	}
+
+	if (_cursorSpriteShown != channelId) {
+		hideCursorSprite();
+		channel->setNeedsDraw();	// take it off the stage
+	}
+	_cursorSpriteShown = channelId;
+	_cursorSpriteKey = key;
+	debugC(2, kDebugImages, "Score::showCursorSprite(): channel %d, member %s, %dx%d, hotspot %d,%d",
+		channelId, key.member.asString().c_str(), w, h, hotX, hotY);
+}
