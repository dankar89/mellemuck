+namespace Director {
+
+class DirectorEngine;
+
+/**
+ * Pause menu for Director games with save support (DirectorEngine::SaveSupport),
+ * made for the Mulle Meck games: continue, save, load, fullscreen, ScummVM's
+ * own menu and quit. Controller first: the D-pad or the left stick moves, A
+ * selects, B goes back, Start closes; arrows, Enter and Escape on the
+ * keyboard, and the mouse works too.
+ *
+ * Drawn by the engine on ScummVM's overlay, which has the window's resolution,
+ * over a dimmed copy of the game screen. The layout is in 640x480 units scaled
+ * to fit the overlay, so the menu fills the same share of the screen at any
+ * window size, with text rendered at full resolution (Fredoka, found through
+ * SearchMan; ScummVM's own fonts if it is missing).
+ *
+ * Save slots, per player (DirectorEngine::playerSlotBase()): 0 the latest
+ * autosave, 1-2 older autosaves, 3-8 the player's own.
+ */
+class GameMenu {
+public:
+	GameMenu(DirectorEngine *vm);
+	~GameMenu();
+
+	// Shows the menu until it is closed. The engine is paused by the caller.
+	// askQuit: open on "quit?" (the window was closed while the game locks it).
+	void run(bool askQuit = false);
+
+	static const int kFirstManualSlot = 3;
+	static const int kManualSlots = 6;
+
+private:
+	enum Page {
+		kPageMain,
+		kPageSave,
+		kPageLoad,
+		kPageConfirm,
+	};
+	enum ItemId {
+		kItemContinue,
+		kItemSave,
+		kItemLoad,
+		kItemFullscreen,
+		kItemSettings,
+		kItemQuit,
+		kItemBack,
+		kItemSlot,
+		kItemYes,
+		kItemNo,
+	};
+	enum Confirm {
+		kConfirmOverwrite,
+		kConfirmQuit,
+	};
+	struct Item {
+		ItemId id;
+		Common::Rect box;	// layout units
+		Common::U32String label;
+		bool enabled = true;
+		int slot = -1;
+	};
+	struct Slot {
+		bool used = false;
+		Common::U32String caption;
+		Common::String when;	// "YYYY-MM-DD HH:MM", for sorting
+		Graphics::ManagedSurface thumb;	// as saved, in _format
+		Graphics::ManagedSurface scaled;	// for the current card size
+	};
+
+	// Pages and items
+	void showPage(Page page, int focus = 0);
+	void addItem(ItemId id, const Common::Rect &box, const char *label, bool enabled = true, int slot = -1);
+	void focusItem(ItemId id, int slot = -1);
+	void readSlots();
+	Common::U32String dateCaption(const SaveStateDescriptor &desc) const;
+
+	// Input
+	void handleEvent(const Common::Event &event);
+	void move(int dx, int dy);
+	void activate(int index);
+	void back();
+	int itemAt(const Common::Point &overlayPos) const;
+
+	// What items do
+	void saveTo(int slot);
+	void quit();
+	void toggleFullscreen();
+	void runSettings();
+	void toast(const char *text);
+
+	// Drawing
+	void layout();
+	void grabGame();
+	void freeFonts();
+	Graphics::Font *font(int units);
+	void draw();
+	void drawButton(const Item &item, bool focused);
+	void drawSlotCard(const Item &item, bool focused);
+	void drawHints();
+	void roundRect(const Common::Rect &unitBox, float radius, uint32 color, float border = 0.0f, uint32 borderColor = 0, float grow = 0.0f);
