+
+// D7+ sprite(n).rotation turns the picture clockwise around its registration
+// point (Bygg hus's cranes lift their booms this way).
+Common::Rect Sprite::rotateAroundRegistration(const Common::Rect &r) const {
+	if (!isRotated() || r.isEmpty())
+		return r;
+	const double a = _rotation * M_PI / 180.0, c = cos(a), s = sin(a);
+	const double xs[2] = { (double)r.left, (double)r.right }, ys[2] = { (double)r.top, (double)r.bottom };
+	double minX = 1e9, minY = 1e9, maxX = -1e9, maxY = -1e9;
+	for (int i = 0; i < 2; i++) {
+		for (int j = 0; j < 2; j++) {
+			const double x = xs[i] * c - ys[j] * s, y = xs[i] * s + ys[j] * c;
+			minX = MIN(minX, x); maxX = MAX(maxX, x);
+			minY = MIN(minY, y); maxY = MAX(maxY, y);
+		}
+	}
+	return Common::Rect((int16)floor(minX), (int16)floor(minY), (int16)ceil(maxX), (int16)ceil(maxY));
+}
