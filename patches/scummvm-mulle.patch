+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+#include "director/director.h"
+#include "director/sound.h"
+#include "director/window.h"
+#include "director/lingo/lingo.h"
+#include "director/lingo/lingo-soundobj.h"
+
+namespace Director {
+
+static Common::HashMap<int, SoundChannelObject *> *s_soundChannels = nullptr;
+
+static const MethodProto soundChannelMethods[] = {
+	{ "play",			LM::m_soundPlay,		0, 1,	700 },
+	{ "queue",			LM::m_soundQueue,		1, 1,	700 },
+	{ "setPlayList",	LM::m_soundSetPlayList,	1, 1,	700 },
+	{ "getPlayList",	LM::m_soundGetPlayList,	0, 0,	700 },
+	{ "stop",			LM::m_soundStop,		0, 0,	700 },
+	{ "isBusy",			LM::m_soundIsBusy,		0, 0,	700 },
+	{ "fadeIn",			LM::m_soundFadeIn,		0, 1,	700 },
+	{ "fadeOut",		LM::m_soundFadeOut,		0, 1,	700 },
+	{ "fadeTo",			LM::m_soundFadeTo,		1, 2,	700 },
+	{ "pause",			LM::m_soundPause,		0, 0,	700 },
+	{ "rewind",			LM::m_soundRewind,		0, 0,	700 },
+	{ nullptr, nullptr, 0, 0, 0 }
+};
+
+SoundChannelObject::SoundChannelObject(int channel) : Object<SoundChannelObject>("SoundChannel"), _channel(channel) {
+	_objType = kNoneObj;
+}
+
+void SoundChannelObject::initMethods() {
+	Object<SoundChannelObject>::initMethods(soundChannelMethods);
+}
+
+void SoundChannelObject::cleanup() {
+	if (s_soundChannels) {
+		for (auto &it : *s_soundChannels)
+			it._value->decRefCount();
+		delete s_soundChannels;
+		s_soundChannels = nullptr;
+	}
+	cleanupMethods();
+}
+
+// One object per channel, as in Director: sound(1) = sound(1).
+Datum SoundChannelObject::get(int channel) {
+	if (!s_soundChannels)
+		s_soundChannels = new Common::HashMap<int, SoundChannelObject *>();
+	if (!s_soundChannels->contains(channel)) {
+		SoundChannelObject *obj = new SoundChannelObject(channel);
+		obj->incRefCount();
+		(*s_soundChannels)[channel] = obj;
+	}
+	return Datum((*s_soundChannels)[channel]);
+}
+
+static DirectorSound *soundManager() {
+	return g_director->getCurrentWindow()->getSoundManager();
+}
+
+bool SoundChannelObject::hasProp(const Common::String &propName) {
+	return propName.equalsIgnoreCase("volume") || propName.equalsIgnoreCase("pan") ||
+		propName.equalsIgnoreCase("status") || propName.equalsIgnoreCase("channelCount") ||
+		propName.equalsIgnoreCase("member") || propName.equalsIgnoreCase("loopCount");
+}
+
+Datum SoundChannelObject::getProp(const Common::String &propName) {
+	DirectorSound *sound = soundManager();
+	if (propName.equalsIgnoreCase("volume"))
+		return Datum((int)sound->getChannelVolume(_channel));
+	if (propName.equalsIgnoreCase("pan"))
+		return Datum((int)sound->getChannelBalance(_channel) * 100 / 127);
+	if (propName.equalsIgnoreCase("status"))
+		return Datum(sound->isChannelActive(_channel) ? 3 : 0);	// 3: playing, 0: idle
+	if (propName.equalsIgnoreCase("channelCount"))
+		return Datum(2);
+	if (propName.equalsIgnoreCase("loopCount"))
+		return Datum(1);
+	return Datum();
+}
+
+void SoundChannelObject::setProp(const Common::String &propName, const Datum &value, bool force) {
+	DirectorSound *sound = soundManager();
+	if (propName.equalsIgnoreCase("volume")) {
+		sound->setChannelVolume(_channel, (uint8)CLIP(value.asInt(), 0, 255));
+	} else if (propName.equalsIgnoreCase("pan")) {
+		// -100 (left) to 100 (right)
+		sound->setChannelBalance(_channel, (int8)(CLIP(value.asInt(), -100, 100) * 127 / 100));
+	} else {
+		warning("SoundChannelObject::setProp(): sound(%d).%s not supported", _channel, propName.c_str());
+	}
+}
+
+static SoundChannelObject *me() {
+	return static_cast<SoundChannelObject *>(g_lingo->_state->me.u.obj);
+}
+
+// A play list entry: a member, or [#member: m, ...].
+static CastMemberID entryMember(const Datum &entry) {
+	if (entry.type == PARRAY) {
+		for (auto &cell : entry.u.parr->arr) {
+			if (cell.p.type == SYMBOL && cell.p.u.s->equalsIgnoreCase("member"))
+				return cell.v.asMemberID(kCastSound);
+		}
+		return CastMemberID();
+	}
+	return entry.asMemberID(kCastSound);
+}
+
+static void playNow(SoundChannelObject *obj, const Datum &entry) {
+	CastMemberID id = entryMember(entry);
+	if (!id.member) {
+		warning("sound(%d).play(): no member in %s", obj->_channel, entry.asString(true).c_str());
+		return;
+	}
+	DirectorSound *sound = soundManager();
+	sound->setPuppetSound(SoundID(kSoundCast, id.member, id.castLib), obj->_channel);
+	sound->playPuppetSound(obj->_channel);
+}
+
+void LM::m_soundPlay(int nargs) {
+	SoundChannelObject *obj = me();
+	if (nargs == 1) {
+		Datum entry = g_lingo->pop();
+		obj->_playList.clear();
+		playNow(obj, entry);
+		return;
+	}
+	if (obj->_playList.empty())
+		return;
+	Datum entry = obj->_playList[0];
+	obj->_playList.remove_at(0);
+	playNow(obj, entry);
+}
+
+void LM::m_soundQueue(int nargs) {
+	me()->_playList.push_back(g_lingo->pop());
+}
+
+void LM::m_soundSetPlayList(int nargs) {
+	Datum list = g_lingo->pop();
+	SoundChannelObject *obj = me();
+	obj->_playList.clear();
+	if (list.type == ARRAY) {
+		for (auto &it : list.u.farr->arr)
+			obj->_playList.push_back(it);
+	}
+}
+
+void LM::m_soundGetPlayList(int nargs) {
+	Datum list;
+	list.type = ARRAY;
+	list.u.farr = new FArray;
+	for (auto &it : me()->_playList)
+		list.u.farr->arr.push_back(it);
+	g_lingo->push(list);
+}
+
+void LM::m_soundStop(int nargs) {
+	soundManager()->stopSound(me()->_channel);
+}
+
+void LM::m_soundIsBusy(int nargs) {
+	g_lingo->push(Datum(soundManager()->isChannelActive(me()->_channel) ? 1 : 0));
+}
+
+// Fades take milliseconds (default 1000); registerFade takes ticks.
+static int fadeTicks(int nargs) {
+	int ms = nargs ? g_lingo->pop().asInt() : 1000;
+	return MAX(1, ms * 60 / 1000);
+}
+
+void LM::m_soundFadeIn(int nargs) {
+	int ticks = fadeTicks(nargs);
+	soundManager()->registerFade(me()->_channel, true, ticks);
+}
+
+void LM::m_soundFadeOut(int nargs) {
+	int ticks = fadeTicks(nargs);
+	soundManager()->registerFade(me()->_channel, false, ticks);
+}
+
+void LM::m_soundFadeTo(int nargs) {
+	int ticks = fadeTicks(nargs - 1);
+	int volume = CLIP(g_lingo->pop().asInt(), 0, 255);
+	DirectorSound *sound = soundManager();
+	sound->registerFade(me()->_channel, sound->getChannelVolume(me()->_channel), volume, ticks);
+}
+
+void LM::m_soundPause(int nargs) {
+	warning("STUB: sound(%d).pause()", me()->_channel);
+}
+
+void LM::m_soundRewind(int nargs) {
+	warning("STUB: sound(%d).rewind()", me()->_channel);
+}
+
+} // End of namespace Director
