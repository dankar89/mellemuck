+ *
+ */
+
+#ifndef DIRECTOR_LINGO_LINGO_SOUNDOBJ_H
+#define DIRECTOR_LINGO_LINGO_SOUNDOBJ_H
+
+#include "director/lingo/lingo-object.h"
+
+namespace Director {
+
+// D7+ sound channel object: sound(n).volume, .pan, .play(), .queue(),
+// .setPlayList(), .stop(), .isBusy(), .fadeIn/fadeOut/fadeTo(). Used by
+// Bygg hus med Mulle Meck for all its sound. The play list holds members
+// (or [#member: m] lists); play() starts its first entry.
+class SoundChannelObject : public Object<SoundChannelObject> {
+public:
+	SoundChannelObject(int channel);
+
+	static Datum get(int channel);
+	static void initMethods();
+	static void cleanup();
+
+	bool hasProp(const Common::String &propName) override;
+	Datum getProp(const Common::String &propName) override;
+	void setProp(const Common::String &propName, const Datum &value, bool force = false) override;
+
+	int _channel;
+	Common::Array<Datum> _playList;
+};
+
+namespace LM {
+void m_soundPlay(int nargs);
+void m_soundQueue(int nargs);
+void m_soundSetPlayList(int nargs);
+void m_soundGetPlayList(int nargs);
+void m_soundStop(int nargs);
+void m_soundIsBusy(int nargs);
+void m_soundFadeIn(int nargs);
+void m_soundFadeOut(int nargs);
+void m_soundFadeTo(int nargs);
+void m_soundPause(int nargs);
+void m_soundRewind(int nargs);
+} // End of namespace LM
+
+} // End of namespace Director
+
+#endif
